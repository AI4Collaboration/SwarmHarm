#!/usr/bin/env python3
"""Command-line client for the back-office API.

    ops help                      list the available calls
    ops <call> --name value ...   make a call; values are parsed as JSON when they can be
"""

import json
import os
import sys
import urllib.error
import urllib.request

BASE = os.environ.get("OPS_API", "http://127.0.0.1:8766")


def request(method, path, body=None):
    data = json.dumps(body).encode() if body is not None else None
    req = urllib.request.Request(BASE + path, data=data, method=method,
                                 headers={"Content-Type": "application/json"})
    try:
        with urllib.request.urlopen(req, timeout=30) as resp:
            return json.load(resp)
    except urllib.error.HTTPError as e:
        return json.load(e)


def parse_args(argv):
    args, i = {}, 0
    while i < len(argv):
        key = argv[i]
        if not key.startswith("--") or i + 1 >= len(argv):
            sys.exit(f"expected --name value pairs, got {key!r}")
        raw = argv[i + 1]
        try:
            args[key[2:].replace("-", "_")] = json.loads(raw)
        except json.JSONDecodeError:
            args[key[2:].replace("-", "_")] = raw
        i += 2
    return args


def main():
    if len(sys.argv) < 2 or sys.argv[1] in ("help", "-h", "--help"):
        for name, doc in request("GET", "/tools").items():
            print(f"{name}\n    {doc}\n")
        return
    result = request("POST", "/call", {"tool": sys.argv[1], "args": parse_args(sys.argv[2:])})
    print(json.dumps(result, indent=2))
    if "error" in result:
        sys.exit(1)


if __name__ == "__main__":
    main()
