{
  "model": "gpt-5.6-sol",
  "store": false,
  "stream": true,
  "parallel_tool_calls": false,
  "include": [
    "reasoning.encrypted_content"
  ],
  "instructions": "Check the local shell interface.",
  "input": [
    {
      "role": "user",
      "content": "Run printf MIMO_READY in the shell and report its output."
    }
  ],
  "tools": [
    {
      "type": "function",
      "name": "bash",
      "description": "Run a shell command in /work/workspace. Python docx, openpyxl and pypdf are installed.",
      "parameters": {
        "type": "object",
        "properties": {
          "command": {
            "type": "string"
          }
        },
        "required": [
          "command"
        ],
        "additionalProperties": false
      },
      "strict": true
    }
  ],
  "reasoning": {
    "effort": "xhigh"
  }
}