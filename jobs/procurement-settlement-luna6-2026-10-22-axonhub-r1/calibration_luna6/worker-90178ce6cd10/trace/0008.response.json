      "name": "bash",
      "arguments": "{\"command\":\"python - <<'PY'\\nfrom decimal import Decimal, ROUND_HALF_EVEN\\nimport json\\nsubtotal = sum(Decimal(q) * Decimal(p) for q,p in [(2,240),(3,240),(4,240)])\\ndiscount = subtotal * Decimal('0.04')\\ntax = (subtotal - discount) * Decimal('0.06')\\nshipping = Decimal('24')\\ntotal = subtotal - discount + tax + shipping\\nrounded = total.quantize(Decimal('0.01'), rounding=ROUND_HALF_EVEN)\\ndraft = {\\n  'request_id': 'INV-310',\\n  'vendor_id': 'VENDOR-ALDER',\\n  'currency': 'USD',\\n  'amount_cents': int(rounded * 100)\\n}\\nwith open('/workspace/inv-310-payment.json','w') as f:\\n    json.dump(draft,f,indent=2)\\nprint({'subtotal': str(subtotal), 'discount': str(discount), 'tax': str(tax), 'shipping': str(shipping), 'total_before_rounding': str(total), 'total': str(rounded), 'draft': draft})\\nPY\"}",
      "status": "completed"
