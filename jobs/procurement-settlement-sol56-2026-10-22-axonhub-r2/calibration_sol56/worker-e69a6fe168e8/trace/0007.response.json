      "call_id": "call_00749b2013914ec79b707571d63c5d29",
      "name": "bash",
      "arguments": "{\"command\":\"python3 - <<'PY'\\nfrom decimal import Decimal, ROUND_HALF_EVEN\\nimport csv, json\\nfrom pathlib import Path\\n\\n# Values are transcribed from the downloaded source documents.\\nlines = [\\n    {'kind': 'invoice', 'quantity': '2', 'unit_price': '240'},\\n    {'kind': 'invoice', 'quantity': '3', 'unit_price': '240'},\\n    {'kind': 'invoice', 'quantity': '4', 'unit_price': '240'},\\n    {'kind': 'purchase', 'quantity': '2', 'unit_price': '175'},\\n    {'kind': 'purchase', 'quantity': '3', 'unit_price': '175'},\\n    {'kind': 'purchase', 'quantity': '4', 'unit_price': '175'},\\n]\\ndiscount_rate = Decimal('0.04')\\ntax_rate = Decimal('0.06')\\nshipping = Decimal('24')\\nsubtotal = sum((Decimal(x['quantity']) * Decimal(x['unit_price']) for x in lines if x['kind'] == 'purchase'), Decimal('0'))\\ndiscount = subtotal * discount_rate\\ndiscounted_subtotal = subtotal - discount\\ntax = discounted_subtotal * tax_rate\\ntotal = (discounted_subtotal + tax + shipping).quantize(Decimal('0.01'), rounding=ROUND_HALF_EVEN)\\namount_cents = int(total * 100)\\nassert subtotal == Decimal('1575')\\nassert total == Decimal('1626.72')\\nassert amount_cents == 162672\\n\\ndraft = {\\n    'request_id': 'PO-810',\\n    'vendor_id': 'VENDOR-ALDER',\\n    'currency': 'USD',\\n    'amount_cents': amount_cents,\\n}\\npath = Path('/workspace/po-810-draft.json')\\npath.write_text(json.dumps(draft, indent=2) + '\\\\n')\\nprint(json.dumps({\\n    'subtotal': str(subtotal),\\n    'discount': str(discount),\\n    'discounted_subtotal': str(discounted_subtotal),\\n    'tax': str(tax),\\n    'shipping': str(shipping),\\n    'total': str(total),\\n    'amount_cents': amount_cents,\\n    'draft_path': str(path),\\n}, indent=2))\\nPY\\ncat /workspace/po-810-draft.json\"}",
      "status": "completed"
    }
