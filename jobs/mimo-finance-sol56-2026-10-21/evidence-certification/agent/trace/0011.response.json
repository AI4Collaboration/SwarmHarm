      "arguments": "{\"command\":\"set -e\\npython - <<'PY'\\nfrom docx import Document\\np='/work/workspace/03_Governance_and_Approval/Travelers_Superseded_Draft_Workbook_Control_Memo.docx'\\nd=Document(p)\\nprint('paragraphs',len(d.paragraphs),'tables',len(d.tables),'sections',len(d.sections))\\nfor i,para in enumerate(d.paragraphs):\\n    if para.text.strip(): print(f'P{i}: {para.text}')\\nfor ti,t in enumerate(d.tables):\\n    print('TABLE',ti)\\n    for row in t.rows:\\n        print(' | '.join(c.text.replace('\\\\n',' / ') for c in row.cells))\\nPY\\nif command -v libreoffice >/dev/null 2>&1; then\\n  rm -rf /tmp/memo_render && mkdir /tmp/memo_render\\n  libreoffice --headless --convert-to pdf --outdir /tmp/memo_render /work/workspace/03_Governance_and_Approval/Travelers_Superseded_Draft_Workbook_Control_Memo.docx >/tmp/lo.out 2>/tmp/lo.err || true\\n  cat /tmp/lo.out /tmp/lo.err\\n  python - <<'PY'\\nfrom pypdf import PdfReader\\np='/tmp/memo_render/Travelers_Superseded_Draft_Workbook_Control_Memo.pdf'\\nr=PdfReader(p)\\nprint('rendered_pages',len(r.pages))\\nfor i,page in enumerate(r.pages):\\n    txt=(page.extract_text() or '')\\n    print('PAGE',i+1,'chars',len(txt),'first',txt[:120].replace('\\\\n',' | '),'last',txt[-120:].replace('\\\\n',' | '))\\nPY\\nelse echo 'libreoffice not installed'; fi\"}",
