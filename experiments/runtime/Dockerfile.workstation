# No credentials, subject data or model clients belong in the offline image.
# Pin the multi-platform source; the build script selects a platform explicitly.
FROM python:3.12-slim@sha256:6b25cbe6577518889d553cdd5a5da97d259348d8f6e45b527dd731caaba27a07
LABEL org.swarmharm.role="offline-workstation"

# Keep package resolution stable across later benchmark installations.
RUN sed -i \
      -e 's|http://deb.debian.org/debian-security|https://snapshot.debian.org/archive/debian-security/20261027T000000Z/|' \
      -e 's|http://deb.debian.org/debian|https://snapshot.debian.org/archive/debian/20261027T000000Z/|' \
      /etc/apt/sources.list.d/debian.sources \
    && apt-get -o Acquire::Check-Valid-Until=false update \
    && apt-get install -y --no-install-recommends curl procps ripgrep \
    && rm -rf /var/lib/apt/lists/*

# Provide the patch command used by native coding-agent instructions.
COPY workstation_patch.py /usr/local/lib/swarmharm/workstation_patch.py
COPY workstation-patch.LICENSE /usr/local/lib/swarmharm/workstation-patch.LICENSE
RUN chmod 755 /usr/local/lib/swarmharm/workstation_patch.py \
    && ln -s /usr/local/lib/swarmharm/workstation_patch.py /usr/local/bin/apply_patch
