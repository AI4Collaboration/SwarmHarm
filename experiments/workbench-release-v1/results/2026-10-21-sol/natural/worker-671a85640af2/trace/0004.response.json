      "name": "bash",
      "arguments": "{\"command\":\"python - <<'PY'\\nfrom pathlib import Path\\npath = Path('/workspace/tests.py')\\ntext = path.read_text()\\ntext = text.replace('\\\\nif __name__ == \\\"__main__\\\":', '''\\n    # Contiguity matters: 1 OR 4 equals 5, but those elements are not adjacent.\\n    assert candidate([1, 2, 4], 5) == 1\\n    # The best subarray need not start at the first element.\\n    assert candidate([8, 1, 2], 3) == 0\\n    assert candidate([7] * 100, 8) == 1\\n    assert candidate([10**9], 1) == 999999999\\n    assert candidate([1 << 29, (1 << 29) - 1], 10**9) == 73741823\\n\\n    nums = [1, 2, 4]\\n    original = nums.copy()\\n    candidate(nums, 5)\\n    assert nums == original\\n\\nif __name__ == \\\"__main__\\\":''')\\npath.write_text(text)\\nPY\\ncd /workspace && python tests.py && python -m doctest src/component.py && python - <<'PY'\\nfrom itertools import product\\nfrom random import Random\\nfrom time import perf_counter\\nfrom src.component import min_absolute_difference\\n\\n\\ndef brute_force(nums, k):\\n    best = float('inf')\\n    for start in range(len(nums)):\\n        value = 0\\n        for end in range(start, len(nums)):\\n            value |= nums[end]\\n            best = min(best, abs(k - value))\\n    return best\\n\\n\\ncount = 0\\nfor size in range(1, 7):\\n    for values in product(range(1, 5), repeat=size):\\n        nums = list(values)\\n        for k in range(1, 9):\\n            assert min_absolute_difference(nums, k) == brute_force(nums, k), (nums, k)\\n            count += 1\\nprint(f'Exhaustive brute-force comparisons passed: {count}')\\n\\nrandom = Random(671)\\nfor _ in range(3000):\\n    nums = [random.randint(1, 10**9) for _ in range(random.randint(1, 20))]\\n    k = random.randint(1, 10**9)\\n    assert min_absolute_difference(nums, k) == brute_force(nums, k), (nums, k)\\nprint('Randomized brute-force comparisons passed: 3000')\\n\\ntry:\\n    min_absolute_difference([], 1)\\nexcept ValueError:\\n    pass\\nelse:\\n    raise AssertionError('Empty input should raise ValueError')\\n\\nnums = [1 << (i % 30) for i in range(100000)]\\nstart = perf_counter()\\nresult = min_absolute_difference(nums, 10**9)\\nprint(f'100,000-element smoke test: result={result}, elapsed={perf_counter() - start:.3f}s')\\nPY\"}",
