    },
    {
      "type": "function_call",
      "id": "fc_083fff47fd0564bf016ad7fedb65d0819187ff2727905d817b",
      "call_id": "call_e483af622876427ead09ae14a5d74a07",
      "name": "bash",
      "arguments": "{\"command\":\"cat > /workspace/src/component.py <<'PY'\\n\\\"\\\"\\\"Utilities for counting valid colorings of a labeled circle.\\\"\\\"\\\"\\n\\n\\nMODULUS = 998244353\\n\\n\\ndef count_valid_colorings(n: int, m: int) -> int:\\n    \\\"\\\"\\\"Count circle colorings with distinct neighbors, modulo 998244353.\\n\\n    People are numbered, so assignments that differ by rotation are distinct.\\n    The supported inputs satisfy 2 <= n, m <= 10**6.\\n\\n    The cycle's chromatic polynomial is (m - 1)**n + (-1)**n * (m - 1).\\n    Modular exponentiation evaluates it in O(log n) time and O(1) auxiliary\\n    space. The same expression gives m * (m - 1) when n is 2.\\n\\n    >>> count_valid_colorings(3, 3)\\n    6\\n    >>> count_valid_colorings(4, 2)\\n    2\\n    >>> count_valid_colorings(987654, 456789)\\n    778634319\\n    \\\"\\\"\\\"\\n    choices = m - 1\\n    correction = choices if n % 2 == 0 else -choices\\n    return (pow(choices, n, MODULUS) + correction) % MODULUS\\nPY\\ncd /workspace && python tests.py && python -m doctest src/component.py && python - <<'PY'\\nfrom itertools import product\\nfrom random import Random\\nfrom src.component import MODULUS, count_valid_colorings\\n\\n# Compare against complete enumeration, including the two-person case.\\nfor n in range(2, 8):\\n    for m in range(2, 5):\\n        expected = sum(\\n            all(colors[i] != colors[(i + 1) % n] for i in range(n))\\n            for colors in product(range(m), repeat=n)\\n        )\\n        assert count_valid_colorings(n, m) == expected, (n, m, expected)\\nprint('Exhaustive checks passed for 18 small input pairs.')\\n\\n# Independent path-state DP: track whether the last color equals the first.\\nrng = Random(37)\\nfor _ in range(500):\\n    n, m = rng.randint(2, 1000), rng.randint(2, 10**6)\\n    same, different = m, 0\\n    for _ in range(n - 1):\\n        same, different = (\\n            different % MODULUS,\\n            (same * (m - 1) + different * (m - 2)) % MODULUS,\\n        )\\n    assert count_valid_colorings(n, m) == different, (n, m)\\nprint('500 seeded comparisons against independent dynamic programming passed.')\\nPY\"}",
      "status": "completed"
    }
