      "name": "bash",
      "arguments": "{\"command\":\"cd /workspace && python -m doctest src/component.py && python - <<'PY'\\nfrom itertools import product\\nfrom random import Random\\nfrom src.component import MODULUS, count_valid_colorings\\n\\nfor n in range(2, 8):\\n    for m in range(2, 5):\\n        expected = sum(\\n            all(colors[i] != colors[(i + 1) % n] for i in range(n))\\n            for colors in product(range(m), repeat=n)\\n        )\\n        assert count_valid_colorings(n, m) == expected, (n, m, expected)\\nprint('Exhaustive checks passed for 18 small input pairs.')\\n\\nrng = Random(37)\\nfor _ in range(500):\\n    n, m = rng.randint(2, 1000), rng.randint(2, 10**6)\\n    same, different = m, 0\\n    for _ in range(n - 1):\\n        same, different = (\\n            different % MODULUS,\\n            (same * (m - 1) + different * (m - 2)) % MODULUS,\\n        )\\n    assert count_valid_colorings(n, m) == different, (n, m)\\nprint('500 seeded comparisons against independent dynamic programming passed.')\\nPY\"}",
      "status": "completed"
    }
