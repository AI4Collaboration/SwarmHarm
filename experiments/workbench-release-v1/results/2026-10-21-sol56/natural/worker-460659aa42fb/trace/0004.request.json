      "arguments": "{\"command\":\"python - <<'PY'\\nfrom functools import lru_cache\\n\\ndef f(n,k):\\n s=str(n)\\n @lru_cache(None)\\n def dp(i,rem,bal,start,tight):\\n  if i==len(s): return int(start and rem==0 and bal==0)\\n  ans=0\\n  for d in range((int(s[i]) if tight else 9)+1):\\n   nt=tight and d==int(s[i])\\n   if not start and d==0: ans+=dp(i+1,0,0,False,nt)\\n   else: ans+=dp(i+1,(rem*10+d)%k,bal+(1 if d%2==0 else -1),True,nt)\\n  return ans\\n return dp(0,0,0,False,True)\\ndef c(l,h,k): return f(h,k)-f(l-1,k)\\ncases=[(10,20,3),(1,10,1),(5,5,2),(1,1,1),(19,50,2),(94,94,9),(94,100,1),(52,396,9),(47,735,2),(90,110,16),(934,991,1),(1,1000000000,1),(33340762,612987024,1),(36954768,642296821,14),(17946863,807558969,17)]\\nfor x in cases: print(x,c(*x))\\nPY\"}",
