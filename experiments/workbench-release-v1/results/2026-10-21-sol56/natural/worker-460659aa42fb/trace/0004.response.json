      "arguments": "{\"command\":\"cat > /workspace/src/component.py <<'PY'\\n\\\"\\\"\\\"Utilities for counting integers with balanced digit parity.\\\"\\\"\\\"\\n\\nfrom functools import lru_cache\\n\\n\\ndef count_beautiful_integers(low: int, high: int, k: int) -> int:\\n    \\\"\\\"\\\"Count beautiful integers in the inclusive range ``[low, high]``.\\n\\n    A positive integer is *beautiful* when it is divisible by ``k`` and has\\n    the same number of even and odd decimal digits.  Leading zeroes are not\\n    digits of the integer and therefore do not contribute to either count.\\n\\n    Args:\\n        low: Inclusive lower bound; ``0 < low <= high <= 10**9``.\\n        high: Inclusive upper bound.\\n        k: Positive divisor, at most 20.\\n\\n    Returns:\\n        The number of beautiful integers in the requested range.\\n\\n    Examples:\\n        >>> count_beautiful_integers(10, 20, 3)\\n        2\\n        >>> count_beautiful_integers(1, 10, 1)\\n        1\\n        >>> count_beautiful_integers(5, 5, 2)\\n        0\\n    \\\"\\\"\\\"\\n\\n    def count_through(limit: int) -> int:\\n        \\\"\\\"\\\"Return the number of beautiful positive integers <= ``limit``.\\\"\\\"\\\"\\n        if limit <= 0:\\n            return 0\\n\\n        digits = tuple(map(int, str(limit)))\\n\\n        @lru_cache(maxsize=None)\\n        def digit_dp(\\n            position: int,\\n            remainder: int,\\n            balance: int,\\n            started: bool,\\n            tight: bool,\\n        ) -> int:\\n            \\\"\\\"\\\"Count valid ways to complete the current decimal prefix.\\n\\n            ``balance`` is the number of even digits minus the number of odd\\n            digits seen after the number has started.  ``remainder`` is the\\n            remainder of that same prefix modulo ``k``.\\n            \\\"\\\"\\\"\\n            if position == len(digits):\\n                return int(started and balance == 0 and remainder == 0)\\n\\n            upper_digit = digits[position] if tight else 9\\n            total = 0\\n\\n            for digit in range(upper_digit + 1):\\n                next_tight = tight and digit == upper_digit\\n\\n                # Ignore leading zeroes: they do not alter the value,\\n                # remainder, or parity balance of the represented integer.\\n                if not started and digit == 0:\\n                    total += digit_dp(\\n                        position + 1, 0, 0, False, next_tight\\n                    )\\n                    continue\\n\\n                next_balance = balance + (1 if digit % 2 == 0 else -1)\\n                next_remainder = (remainder * 10 + digit) % k\\n                total += digit_dp(\\n                    position + 1,\\n                    next_remainder,\\n                    next_balance,\\n                    True,\\n                    next_tight,\\n                )\\n\\n            return total\\n\\n        return digit_dp(0, 0, 0, False, True)\\n\\n    return count_through(high) - count_through(low - 1)\\nPY\\ncd /workspace && python -m doctest -v src/component.py; python tests.py\"}",
