      "name": "bash",
      "arguments": "{\"command\":\"python - <<'PY'\\nimport ast\\ns=open('/workspace/tests.py').read(); tree=ast.parse(s)\\ncases=[]\\nfor n in ast.walk(tree):\\n if isinstance(n,ast.Assert) and isinstance(n.test,ast.Compare):\\n  call=n.test.left; exp=n.test.comparators[0]\\n  args=[ast.literal_eval(x) for x in call.args]\\n  cases.append((*args,ast.literal_eval(exp)))\\nt=((2,1,0,1),(1,2,1,0))\\ndef pref(x,y):\\n qy,ry=divmod(y,2)\\n def row(j):\\n  q,r=divmod(x,4);return q*4+sum(t[j][:r])\\n return qy*(row(0)+row(1))+sum(row(j) for j in range(ry))\\ndef f(a,b,c,d): return pref(c,d)-pref(a,d)-pref(c,b)+pref(a,b)\\nfor case in cases:\\n got=f(*case[:4])\\n if got!=case[4]: print('mismatch',case,'got',got)\\nprint(len(cases))\\nPY\"}",
