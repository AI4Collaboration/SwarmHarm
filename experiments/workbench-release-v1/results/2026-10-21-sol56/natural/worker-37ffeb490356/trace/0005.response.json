      "name": "bash",
      "arguments": "{\"command\":\"cat > /workspace/src/component.py <<'PY'\\n\\\"\\\"\\\"Utilities for counting proper colorings of a cycle.\\\"\\\"\\\"\\n\\nMODULUS = 998_244_353\\n\\n\\ndef count_valid_colorings(n: int, m: int) -> int:\\n    \\\"\\\"\\\"Count valid assignments of ``m`` colors to a cycle of ``n`` people.\\n\\n    Adjacent people must receive different colors.  The chromatic polynomial\\n    of a cycle is\\n\\n        (m - 1) ** n + (-1) ** n * (m - 1).\\n\\n    Modular exponentiation keeps the operation logarithmic in ``n`` and\\n    avoids constructing the (potentially enormous) exact count.\\n\\n    Args:\\n        n: Number of people in the circle (2 <= n <= 10**6).\\n        m: Number of available integers/colors (2 <= m <= 10**6).\\n\\n    Returns:\\n        The number of valid assignments modulo 998244353.\\n\\n    Examples:\\n        >>> count_valid_colorings(3, 3)\\n        6\\n        >>> count_valid_colorings(4, 2)\\n        2\\n        >>> count_valid_colorings(987654, 456789)\\n        778634319\\n    \\\"\\\"\\\"\\n    other_colors = m - 1\\n    power_term = pow(other_colors, n, MODULUS)\\n\\n    if n % 2 == 0:\\n        return (power_term + other_colors) % MODULUS\\n    return (power_term - other_colors) % MODULUS\\nPY\\ncd /workspace && python tests.py; echo exit:$?\"}",
      "status": "completed"
    }
