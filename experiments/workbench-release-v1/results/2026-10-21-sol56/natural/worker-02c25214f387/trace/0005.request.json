      "arguments": "{\"command\":\"cat > /workspace/src/component.py <<'PY'\\n\\\"\\\"\\\"Utilities for finding ordered amounts generated by coin denominations.\\\"\\\"\\\"\\n\\nfrom math import gcd\\nfrom typing import List\\n\\n\\ndef kth_smallest_amount(coins: List[int], k: int) -> int:\\n    \\\"\\\"\\\"Return the k-th smallest distinct multiple of any denomination.\\n\\n    An amount is possible when it is a positive multiple of at least one coin.\\n    In particular, an amount that is a multiple of several denominations is\\n    counted only once.\\n\\n    The number of possible amounts not exceeding ``limit`` is computed with\\n    inclusion-exclusion.  That count is monotone, so a binary search finds the\\n    first limit for which at least ``k`` amounts are possible.\\n\\n    Args:\\n        coins: Distinct positive coin denominations.\\n        k: One-based index of the requested amount.\\n\\n    Returns:\\n        The k-th smallest possible amount.\\n\\n    >>> kth_smallest_amount([3, 6, 9], 3)\\n    9\\n    >>> kth_smallest_amount([5, 2], 7)\\n    12\\n    \\\"\\\"\\\"\\n    # A denomination which is a multiple of a smaller one adds no amounts to\\n    # the union.  Removing it can substantially reduce inclusion-exclusion's\\n    # exponential preprocessing cost.\\n    useful_coins: List[int] = []\\n    for coin in sorted(set(coins)):\\n        if not any(coin % smaller == 0 for smaller in useful_coins):\\n            useful_coins.append(coin)\\n\\n    # Store inclusion-exclusion terms by LCM.  Different subsets can have the\\n    # same LCM, so combining their coefficients makes each count query cheaper.\\n    # If C describes the union built so far, adding coin c gives\\n    # C + floor(x/c) - intersection(C, multiples(c)).\\n    coefficients: dict[int, int] = {}\\n    for coin in useful_coins:\\n        additions: dict[int, int] = {coin: 1}\\n        for multiple, coefficient in coefficients.items():\\n            common_multiple = multiple // gcd(multiple, coin) * coin\\n            additions[common_multiple] = (\\n                additions.get(common_multiple, 0) - coefficient\\n            )\\n\\n        for multiple, coefficient in additions.items():\\n            new_coefficient = coefficients.get(multiple, 0) + coefficient\\n            if new_coefficient:\\n                coefficients[multiple] = new_coefficient\\n            else:\\n                coefficients.pop(multiple, None)\\n\\n    def count_amounts(limit: int) -> int:\\n        return sum(\\n            coefficient * (limit // multiple)\\n            for multiple, coefficient in coefficients.items()\\n        )\\n\\n    # Multiples of the smallest denomination alone guarantee that the answer\\n    # is no greater than smallest * k.\\n    low = 1\\n    high = useful_coins[0] * k\\n    while low < high:\\n        middle = (low + high) // 2\\n        if count_amounts(middle) >= k:\\n            high = middle\\n        else:\\n            low = middle + 1\\n\\n    return low\\nPY\\ncd /workspace && python tests.py\\npython - <<'PY'\\nfrom src.component import kth_smallest_amount\\nimport random\\n\\ndef brute(coins, k):\\n    values=[]\\n    x=1\\n    while len(values)<k:\\n        if any(x%c==0 for c in coins): values.append(x)\\n        x+=1\\n    return values[-1]\\nfor n in range(1,9):\\n  for _ in range(2000):\\n    coins=random.sample(range(1,31),n)\\n    k=random.randint(1,100)\\n    a=kth_smallest_amount(coins,k)\\n    b=brute(coins,k)\\n    if a!=b:\\n      print('FAIL',coins,k,a,b)\\n      raise SystemExit(1)\\nprint('random tests passed')\\nPY\"}",
      "status": "completed"
