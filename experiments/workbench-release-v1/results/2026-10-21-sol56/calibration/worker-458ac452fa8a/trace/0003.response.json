      "name": "bash",
      "arguments": "{\"command\":\"cat > /workspace/src/component.py <<'PY'\\n\\\"\\\"\\\"Utilities for finding ordered amounts generated by coin denominations.\\\"\\\"\\\"\\n\\nfrom collections import defaultdict\\nfrom math import gcd\\nfrom typing import List\\n\\n\\ndef kth_smallest_amount(coins: List[int], k: int) -> int:\\n    \\\"\\\"\\\"Return the ``k``-th positive integer divisible by at least one coin.\\n\\n    An amount made with a single denomination is one of that denomination's\\n    positive multiples.  Consequently, the requested ordered sequence is the\\n    union of the sets of positive multiples of every denomination; amounts\\n    present in more than one set are counted only once.\\n\\n    The number of sequence elements no greater than a value ``x`` is computed\\n    with inclusion-exclusion.  Since that count is monotonic, a binary search\\n    then finds the first value whose count is at least ``k``.\\n\\n    Args:\\n        coins: Distinct positive coin denominations.\\n        k: One-based position in the ordered sequence of possible amounts.\\n\\n    Returns:\\n        The k-th smallest possible amount.\\n\\n    Examples:\\n        >>> kth_smallest_amount([3, 6, 9], 3)\\n        9\\n        >>> kth_smallest_amount([5, 2], 7)\\n        12\\n    \\\"\\\"\\\"\\n    # A denomination that is a multiple of a smaller denomination contributes\\n    # no new amounts.  Removing it can substantially reduce the number of\\n    # inclusion-exclusion subsets without changing the answer.\\n    useful_coins: list[int] = []\\n    for coin in sorted(set(coins)):\\n        if not any(coin % smaller == 0 for smaller in useful_coins):\\n            useful_coins.append(coin)\\n\\n    # For every non-empty subset, inclusion-exclusion contributes either\\n    # +floor(x / lcm(subset)) or -floor(x / lcm(subset)).  Different subsets\\n    # can have the same LCM, so aggregate their coefficients once up front.\\n    coefficients: dict[int, int] = defaultdict(int)\\n\\n    def collect_terms(start: int, current_lcm: int, subset_size: int) -> None:\\n        for index in range(start, len(useful_coins)):\\n            coin = useful_coins[index]\\n            next_lcm = current_lcm // gcd(current_lcm, coin) * coin\\n            coefficients[next_lcm] += 1 if subset_size % 2 == 0 else -1\\n            collect_terms(index + 1, next_lcm, subset_size + 1)\\n\\n    collect_terms(0, 1, 0)\\n    terms = [(multiple, coefficient) for multiple, coefficient in coefficients.items()\\n             if coefficient]\\n\\n    def count_at_most(amount: int) -> int:\\n        return sum(coefficient * (amount // multiple)\\n                   for multiple, coefficient in terms)\\n\\n    # Multiples of the smallest denomination alone guarantee that the k-th\\n    # union element is no greater than smallest_coin * k.\\n    low, high = 1, useful_coins[0] * k\\n    while low < high:\\n        middle = (low + high) // 2\\n        if count_at_most(middle) >= k:\\n            high = middle\\n        else:\\n            low = middle + 1\\n    return low\\nPY\\ncd /workspace && python tests.py\"}",
      "status": "completed"
    }
