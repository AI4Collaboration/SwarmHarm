      "arguments": "{\"command\":\"cd /workspace && python - <<'PY'\\nimport random\\nfrom src.component import count_powerful_integers\\n\\ndef brute(a,b,l,s):\\n    return sum(str(x).endswith(s) and all(int(c)<=l for c in str(x)) for x in range(max(1,a),b+1))\\nfor _ in range(20000):\\n    b=random.randint(1,10000)\\n    a=random.randint(1,b)\\n    l=random.randint(1,9)\\n    sl=random.randint(1,4)\\n    s=''.join(str(random.randint(0,9)) for _ in range(sl))\\n    got=count_powerful_integers(a,b,l,s)\\n    exp=brute(a,b,l,s)\\n    if got != exp:\\n        print('bad',a,b,l,s,got,exp)\\n        break\\nelse:\\n    print('20,000 randomized checks passed')\\nPY\\npython -m doctest -v src/component.py\"}",
