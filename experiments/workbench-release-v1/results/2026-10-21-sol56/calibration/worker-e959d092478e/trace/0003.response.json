      "name": "bash",
      "arguments": "{\"command\":\"cat > /workspace/src/component.py <<'PY'\\nfrom functools import lru_cache\\n\\n\\ndef count_beautiful_integers(low: int, high: int, k: int) -> int:\\n    \\\"\\\"\\\"Count beautiful integers in the inclusive range ``[low, high]``.\\n\\n    A positive integer is beautiful when it is divisible by ``k`` and has the\\n    same number of even and odd decimal digits.  Leading zeroes are not treated\\n    as digits.\\n\\n    Args:\\n        low: Inclusive lower bound, where ``0 < low <= high <= 10**9``.\\n        high: Inclusive upper bound.\\n        k: Positive divisor, where ``k <= 20``.\\n\\n    Returns:\\n        The number of beautiful integers in the range.\\n    \\\"\\\"\\\"\\n\\n    def count_through(limit: int) -> int:\\n        \\\"\\\"\\\"Return the number of beautiful positive integers at most limit.\\\"\\\"\\\"\\n        if limit <= 0:\\n            return 0\\n\\n        digits = tuple(map(int, str(limit)))\\n\\n        @lru_cache(maxsize=None)\\n        def dp(\\n            position: int,\\n            balance: int,\\n            remainder: int,\\n            started: bool,\\n            tight: bool,\\n        ) -> int:\\n            if position == len(digits):\\n                return int(started and balance == 0 and remainder == 0)\\n\\n            upper = digits[position] if tight else 9\\n            total = 0\\n            for digit in range(upper + 1):\\n                next_tight = tight and digit == upper\\n\\n                # Skip leading zeroes.  Once the number has started, zero is\\n                # an ordinary even digit and must affect both tracked values.\\n                if not started and digit == 0:\\n                    total += dp(\\n                        position + 1,\\n                        balance,\\n                        remainder,\\n                        False,\\n                        next_tight,\\n                    )\\n                    continue\\n\\n                # balance is even-digit count minus odd-digit count.\\n                next_balance = balance + (1 if digit % 2 == 0 else -1)\\n                next_remainder = (remainder * 10 + digit) % k\\n                total += dp(\\n                    position + 1,\\n                    next_balance,\\n                    next_remainder,\\n                    True,\\n                    next_tight,\\n                )\\n            return total\\n\\n        return dp(0, 0, 0, False, True)\\n\\n    return count_through(high) - count_through(low - 1)\\nPY\\ncd /workspace && python tests.py\\npython - <<'PY'\\nfrom src.component import count_beautiful_integers\\n\\ndef brute(low, high, k):\\n    return sum(n % k == 0 and sum(c in '02468' for c in str(n)) == sum(c in '13579' for c in str(n)) for n in range(low, high+1))\\nfor h in range(1, 301):\\n    for lo in (1, max(1,h-30),h):\\n      for k in range(1,21):\\n        a=count_beautiful_integers(lo,h,k); b=brute(lo,h,k)\\n        assert a==b,(lo,h,k,a,b)\\nprint('brute checks passed')\\nPY\"}",
      "status": "completed"
    }
