      "arguments": "{\"command\":\"python - <<'PY'\\ndef f(i,j):\\n    if (i+j)%2:return 1\\n    return 2 if (i+j//2+(i+j+1)//2)%2==0 else 0\\nP,Q=4,2\\nT=[[f(i,j) for j in range(Q)] for i in range(P)]\\nTsum=sum(map(sum,T))\\ndef p(x,y):\\n    qx,rx=divmod(x,P); qy,ry=divmod(y,Q)\\n    total=qx*qy*Tsum\\n    total+=qx*sum(T[i][j] for i in range(P) for j in range(ry))\\n    total+=qy*sum(T[i][j] for i in range(rx) for j in range(Q))\\n    total+=sum(T[i][j] for i in range(rx) for j in range(ry))\\n    return total\\ndef calc(a,b,c,d):return p(c,d)-p(a,d)-p(c,b)+p(a,b)\\nexec(open('/workspace/tests.py').read().replace('if __name__ == \\\"__main__\\\":', 'if __name__ == \\\"__ignore__\\\":'))\\nfrom src.component import calculate_black_area_doubled\\n# Existing function absent. Parse assert lines and test expected against calc via AST? use regex\\nimport re\\nfor args, expected in re.findall(r'assert candidate\\\\((.*?)\\\\) == (\\\\d+)', open('/workspace/tests.py').read()):\\n    vals=list(map(int,args.split(',')))\\n    got=calc(*vals)\\n    if got!=int(expected): print('FAIL', vals, got, expected)\\nprint('table',T, 'total',Tsum)\\nPY\"}",
