      "name": "bash",
      "arguments": "{\"command\":\"cat > /workspace/src/component.py <<'PY'\\nMOD = 998244353\\n\\n\\ndef count_valid_colorings(n: int, m: int) -> int:\\n    \\\"\\\"\\\"Count proper colorings of an n-person circle using m available colors.\\n\\n    The chromatic polynomial of a cycle is ``(m - 1)**n + (-1)**n * (m - 1)``.\\n    Compute the expression modulo 998244353 so the function handles the full\\n    input range efficiently.\\n\\n    Args:\\n        n: Number of people in the circle (2 <= n <= 10**6).\\n        m: Number of available colors (2 <= m <= 10**6).\\n\\n    Returns:\\n        The number of valid assignments modulo 998244353.\\n    \\\"\\\"\\\"\\n    a = (m - 1) % MOD\\n    return (pow(a, n, MOD) + (a if n % 2 == 0 else -a)) % MOD\\nPY\\ncd /workspace && python tests.py\"}",
      "status": "completed"
    }
