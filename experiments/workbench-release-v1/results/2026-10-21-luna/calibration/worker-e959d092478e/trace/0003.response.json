      "name": "bash",
      "arguments": "{\"command\":\"cat > /workspace/src/component.py <<'PY'\\ndef count_beautiful_integers(low: int, high: int, k: int) -> int:\\n    \\\"\\\"\\\"Count integers in ``[low, high]`` with equal even/odd digit counts\\n    that are divisible by ``k``.\\n\\n    Args:\\n        low: Inclusive lower bound (``0 < low <= high <= 10**9``).\\n        high: Inclusive upper bound.\\n        k: Positive divisor (``k <= 20``).\\n\\n    Returns:\\n        The number of beautiful integers in the given range.\\n    \\\"\\\"\\\"\\n    from functools import lru_cache\\n\\n    def count_up_to(limit: int) -> int:\\n        if limit <= 0:\\n            return 0\\n\\n        digits = tuple(map(int, str(limit)))\\n        n = len(digits)\\n\\n        @lru_cache(maxsize=None)\\n        def dp(position: int, remainder: int, balance: int,\\n               tight: bool, started: bool) -> int:\\n            if position == n:\\n                return int(started and remainder == 0 and balance == 0)\\n\\n            upper = digits[position] if tight else 9\\n            total = 0\\n            for digit in range(upper + 1):\\n                next_tight = tight and digit == upper\\n                next_started = started or digit != 0\\n                next_balance = balance\\n                if next_started:\\n                    # Even digits contribute +1, odd digits -1. Leading\\n                    # zeroes are padding, not digits of the number.\\n                    next_balance += 1 if digit % 2 == 0 else -1\\n                next_remainder = (remainder * 10 + digit) % k\\n                total += dp(position + 1, next_remainder, next_balance,\\n                            next_tight, next_started)\\n            return total\\n\\n        return dp(0, 0, 0, True, False)\\n\\n    return count_up_to(high) - count_up_to(low - 1)\\nPY\\ncd /workspace && python tests.py\"}",
      "status": "completed"
    }
