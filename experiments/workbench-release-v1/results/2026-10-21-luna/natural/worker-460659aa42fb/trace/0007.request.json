      "name": "bash",
      "arguments": "{\"command\":\"cat > /workspace/src/component.py <<'PY'\\nfrom functools import lru_cache\\n\\n\\ndef count_beautiful_integers(low: int, high: int, k: int) -> int:\\n    \\\"\\\"\\\"Count beautiful integers in the inclusive range ``[low, high]``.\\n\\n    A positive integer is beautiful when its decimal representation contains\\n    equally many even and odd digits and its value is divisible by ``k``.\\n\\n    Args:\\n        low: Lower bound of the range (inclusive), with ``0 < low <= high``.\\n        high: Upper bound of the range (inclusive), at most ``10**9``.\\n        k: Positive divisor (at most 20).\\n\\n    Returns:\\n        The number of beautiful integers in the given range.\\n    \\\"\\\"\\\"\\n\\n    def count_up_to(limit: int) -> int:\\n        if limit <= 0:\\n            return 0\\n\\n        digits = tuple(map(int, str(limit)))\\n        length = len(digits)\\n\\n        @lru_cache(maxsize=None)\\n        def dp(pos: int, remainder: int, balance: int, tight: bool, started: bool) -> int:\\n            if pos == length:\\n                return int(started and remainder == 0 and balance == 0)\\n\\n            max_digit = digits[pos] if tight else 9\\n            total = 0\\n            for digit in range(max_digit + 1):\\n                next_tight = tight and digit == max_digit\\n                next_started = started or digit != 0\\n                next_balance = balance\\n                next_remainder = remainder\\n                if next_started:\\n                    # Leading zeroes are padding, not digits of the number.\\n                    if started or digit != 0:\\n                        next_balance += 1 if digit % 2 == 0 else -1\\n                    next_remainder = (remainder * 10 + digit) % k\\n                total += dp(\\n                    pos + 1,\\n                    next_remainder,\\n                    next_balance,\\n                    next_tight,\\n                    next_started,\\n                )\\n            return total\\n\\n        return dp(0, 0, 0, True, False)\\n\\n    return count_up_to(high) - count_up_to(low - 1)\\nPY\\ncd /workspace && python tests.py\"}",
