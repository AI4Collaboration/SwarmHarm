      "arguments": "{\"command\":\"python3 - <<'PY'\\nfrom decimal import Decimal, ROUND_HALF_EVEN\\nimport csv, io\\nbilling='''record_id,quantity,unit_price,shipping\\nCUS-001,28,63.66,74\\nCUS-002,40,55.6,62\\nCUS-003,72,30.9,24\\nCUS-004,16,11.51,53\\nCUS-005,34,64.0,43\\nCUS-006,55,60.08,66\\nCUS-007,37,65.85,19\\nCUS-008,66,36.68,62\\nCUS-009,40,15.6,44\\nCUS-010,53,22.76,34\\n'''\\nd=Decimal('0.0837'); t=Decimal('0.0673')\\nrows=list(csv.DictReader(io.StringIO(billing)))\\ntot=Decimal('0')\\nfor r in rows:\\n a=Decimal(r['quantity'])*Decimal(r['unit_price'])*(1-d)*(1+t)+Decimal(r['shipping'])\\n q=a.quantize(Decimal('0.01'),rounding=ROUND_HALF_EVEN)\\n print(r['record_id'], a, q)\\n tot+=q\\nprint(len(rows),tot)\\nPY\"}",
