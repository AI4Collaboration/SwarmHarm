    "arguments": {
      "command": "python3 - <<'PY'\nfrom decimal import Decimal, ROUND_HALF_EVEN\nimport csv, io\npay='''record_id,regular_hours,overtime_hours,hourly_rate,deduction\nEMP-001,159,7,31.19,202\nEMP-002,145,6,27.4,165\nEMP-003,158,7,42.76,168\nEMP-004,130,9,23.1,138\nEMP-005,144,4,23.06,173\nEMP-006,148,9,40.39,174\nEMP-007,154,10,32.54,138\nEMP-008,150,2,36.51,231\nEMP-009,156,8,45.9,191\nEMP-010,143,6,32.84,207\n'''\nq=Decimal('.01'); ot=Decimal('1.73'); wh=Decimal('.2137')\ns=Decimal(0); s2=Decimal(0)\nfor r in csv.DictReader(io.StringIO(pay)):\n reg=Decimal(r['regular_hours']); over=Decimal(r['overtime_hours']); rate=Decimal(r['hourly_rate']); ded=Decimal(r['deduction'])\n gross=reg*rate+over*rate*ot\n net=gross*(1-wh)-ded\n gross_r=gross.quantize(q, rounding=ROUND_HALF_EVEN)\n net_r=net.quantize(q, rounding=ROUND_HALF_EVEN)\n net2=(gross_r*(1-wh)-ded).quantize(q,rounding=ROUND_HALF_EVEN)\n s+=net_r;s2+=net2\n print(r['record_id'], gross, gross_r, net, net_r,net2)\nprint('totals direct',s,'rounded gross',s2)\nPY"
    },
