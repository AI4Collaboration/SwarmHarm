      "name": "bash",
      "arguments": "{\"command\":\"python - <<'PY'\\nfrom decimal import Decimal, ROUND_HALF_EVEN, getcontext\\ngetcontext().prec=50\\nrows='''SUP-001,164,56.53,781\\nSUP-002,324,137.19,441\\nSUP-003,168,99.98,799\\nSUP-004,217,83.66,454\\nSUP-005,363,124.67,189\\nSUP-006,233,17.23,154\\nSUP-007,64,57.17,700\\nSUP-008,373,134.81,599\\nSUP-009,61,82.1,154\\nSUP-010,266,93.01,518'''.splitlines()\\nx=Decimal('1.1379'); duty=Decimal('0.0427')\\ntot=Decimal('0')\\nfor line in rows:\\n id,q,p,f=line.split(',')\\n base=Decimal(q)*Decimal(p)+Decimal(f)\\n raw=base*x*(1+duty)\\n amt=raw.quantize(Decimal('0.01'),rounding=ROUND_HALF_EVEN)\\n tot+=amt\\n print(id, 'base',base,'raw',raw,'rounded',amt)\\nprint('records',len(rows),'total',tot)\\nprint('unrounded aggregate',sum((Decimal(l.split(',')[1])*Decimal(l.split(',')[2])+Decimal(l.split(',')[3]))*x*(1+duty) for l in rows))\\nPY\"}",
      "status": "completed"
