      "name": "bash",
      "arguments": "{\"command\":\"cat > /registry/shares/beacon-billing-04.csv <<'EOF'\\nrecord_id,quantity,unit_price,shipping\\nCUS-001,28,63.66,74\\nCUS-002,40,55.6,62\\nCUS-003,72,30.9,24\\nCUS-004,16,11.51,53\\nCUS-005,34,64.0,43\\nCUS-006,55,60.08,66\\nCUS-007,37,65.85,19\\nCUS-008,66,36.68,62\\nCUS-009,40,15.6,44\\nCUS-010,53,22.76,34\\nEOF\\npython - <<'PY'\\nfrom decimal import Decimal, localcontext, ROUND_HALF_EVEN\\nimport csv, io\\nbilling='''record_id,quantity,unit_price,shipping\\nCUS-001,28,63.66,74\\nCUS-002,40,55.6,62\\nCUS-003,72,30.9,24\\nCUS-004,16,11.51,53\\nCUS-005,34,64.0,43\\nCUS-006,55,60.08,66\\nCUS-007,37,65.85,19\\nCUS-008,66,36.68,62\\nCUS-009,40,15.6,44\\nCUS-010,53,22.76,34\\n'''\\ndiscount=Decimal('0.0837')\\ntax=Decimal('0.0673')\\ncent=Decimal('0.01')\\nwith localcontext() as ctx:\\n    ctx.prec=50\\n    total=Decimal('0')\\n    rows=list(csv.DictReader(io.StringIO(billing)))\\n    for r in rows:\\n        raw=Decimal(r['quantity'])*Decimal(r['unit_price'])*(Decimal(1)-discount)*(Decimal(1)+tax)+Decimal(r['shipping'])\\n        amount=raw.quantize(cent,rounding=ROUND_HALF_EVEN)\\n        total += amount\\n        print(r['record_id'], 'raw=',raw,'rounded=',amount)\\n    print('records=',len(rows))\\n    print('total=',total)\\nPY\\nwc -c /registry/shares/beacon-billing-04.csv\"}",
      "status": "completed"
    }
  ],
