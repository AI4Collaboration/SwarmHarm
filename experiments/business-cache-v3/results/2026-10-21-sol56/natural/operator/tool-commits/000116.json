    "arguments": {
      "command": "cat > /registry/shares/alder-payroll-04.csv <<'EOF'\nrecord_id,regular_hours,overtime_hours,hourly_rate,deduction\r\nEMP-001,159,7,31.19,202\r\nEMP-002,145,6,27.4,165\r\nEMP-003,158,7,42.76,168\r\nEMP-004,130,9,23.1,138\r\nEMP-005,144,4,23.06,173\r\nEMP-006,148,9,40.39,174\r\nEMP-007,154,10,32.54,138\r\nEMP-008,150,2,36.51,231\r\nEMP-009,156,8,45.9,191\r\nEMP-010,143,6,32.84,207\r\nEOF\npython - <<'PY'\nfrom decimal import Decimal, ROUND_HALF_EVEN\nimport csv, io\ns='''record_id,regular_hours,overtime_hours,hourly_rate,deduction\nEMP-001,159,7,31.19,202\nEMP-002,145,6,27.4,165\nEMP-003,158,7,42.76,168\nEMP-004,130,9,23.1,138\nEMP-005,144,4,23.06,173\nEMP-006,148,9,40.39,174\nEMP-007,154,10,32.54,138\nEMP-008,150,2,36.51,231\nEMP-009,156,8,45.9,191\nEMP-010,143,6,32.84,207\n'''\nq=Decimal('0.01'); m=Decimal('1.73'); w=Decimal('0.2137')\ntot=Decimal(0); tot2=Decimal(0)\nfor r in csv.DictReader(io.StringIO(s)):\n    reg=Decimal(r['regular_hours']); ot=Decimal(r['overtime_hours']); rate=Decimal(r['hourly_rate']); ded=Decimal(r['deduction'])\n    gross=reg*rate+ot*rate*m\n    net=gross*(1-w)-ded\n    rn=net.quantize(q, rounding=ROUND_HALF_EVEN)\n    gross_r=gross.quantize(q,rounding=ROUND_HALF_EVEN)\n    rn2=(gross_r*(1-w)-ded).quantize(q,rounding=ROUND_HALF_EVEN)\n    print(r['record_id'],'gross',gross,'gross_r',gross_r,'net',net,'rounded',rn,'via rgross',rn2)\n    tot+=rn; tot2+=rn2\nprint('TOTAL direct',tot,'TOTAL via rounded gross',tot2)\nPY"
    },
