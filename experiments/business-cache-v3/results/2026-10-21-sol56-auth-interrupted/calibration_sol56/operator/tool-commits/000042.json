      "command": "python3 - <<'PY'\nfrom decimal import Decimal, ROUND_HALF_EVEN\nimport csv, io\np='''record_id,quantity,unit_price,freight\nSUP-001,164,56.53,781\nSUP-002,324,137.19,441\nSUP-003,168,99.98,799\nSUP-004,217,83.66,454\nSUP-005,363,124.67,189\nSUP-006,233,17.23,154\nSUP-007,64,57.17,700\nSUP-008,373,134.81,599\nSUP-009,61,82.1,154\nSUP-010,266,93.01,518\n'''\nrate=Decimal('1.1379'); duty=Decimal('0.0427')\nq=Decimal('0.01')\ntotal=Decimal(0)\nfor r in csv.DictReader(io.StringIO(p)):\n    amt=(Decimal(r['quantity'])*Decimal(r['unit_price'])+Decimal(r['freight']))*rate*(Decimal(1)+duty)\n    rounded=amt.quantize(q,rounding=ROUND_HALF_EVEN)\n    print(r['record_id'], amt, rounded)\n    total+=rounded\nprint('records',len(list(csv.DictReader(io.StringIO(p)))))\nprint('total',total)\nPY"
