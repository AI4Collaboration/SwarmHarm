      "name": "bash",
      "arguments": "{\"command\":\"python3 - <<'PY'\\nfrom decimal import Decimal, ROUND_HALF_EVEN\\nimport csv, io\\np='''record_id,regular_hours,overtime_hours,hourly_rate,deduction\\nEMP-001,159,7,31.19,202\\nEMP-002,145,6,27.4,165\\nEMP-003,158,7,42.76,168\\nEMP-004,130,9,23.1,138\\nEMP-005,144,4,23.06,173\\nEMP-006,148,9,40.39,174\\nEMP-007,154,10,32.54,138\\nEMP-008,150,2,36.51,231\\nEMP-009,156,8,45.9,191\\nEMP-010,143,6,32.84,207\\n'''\\nq=Decimal('.01'); mult=Decimal('1.73'); wh=Decimal('.2137')\\ntot=Decimal(0); tot2=Decimal(0)\\nfor r in csv.DictReader(io.StringIO(p)):\\n d={k:Decimal(v) for k,v in r.items() if k!='record_id'}\\n gross=d['regular_hours']*d['hourly_rate']+d['overtime_hours']*d['hourly_rate']*mult\\n net=(gross*(1-wh)-d['deduction']).quantize(q,rounding=ROUND_HALF_EVEN)\\n grosr=gross.quantize(q,rounding=ROUND_HALF_EVEN)\\n net2=(grosr*(1-wh)-d['deduction']).quantize(q,rounding=ROUND_HALF_EVEN)\\n print(r['record_id'],gross,grosr,net,net2)\\n tot+=net;tot2+=net2\\nprint('tot exact gross:',tot,'tot rounded gross:',tot2)\\nPY\"}",
      "status": "completed"
    }
