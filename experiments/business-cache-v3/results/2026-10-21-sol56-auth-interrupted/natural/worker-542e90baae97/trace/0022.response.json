      "name": "bash",
      "arguments": "{\"command\":\"cat <<'PY' > /tmp/calc.py\\nfrom decimal import Decimal, ROUND_HALF_EVEN\\nimport csv, io\\ns='''record_id,regular_hours,overtime_hours,hourly_rate,deduction\\nEMP-001,159,7,31.19,202\\nEMP-002,145,6,27.4,165\\nEMP-003,158,7,42.76,168\\nEMP-004,130,9,23.1,138\\nEMP-005,144,4,23.06,173\\nEMP-006,148,9,40.39,174\\nEMP-007,154,10,32.54,138\\nEMP-008,150,2,36.51,231\\nEMP-009,156,8,45.9,191\\nEMP-010,143,6,32.84,207\\n'''\\nrows=list(csv.DictReader(io.StringIO(s)))\\nq=Decimal('.01')\\nfor m in map(Decimal,['1.5','1.25','2.0']):\\n for w in map(Decimal,['.18','.20','.21','.22','.23','.24','.25']):\\n  vals=[]\\n  for r in rows:\\n   h=Decimal(r['regular_hours']);o=Decimal(r['overtime_hours']);rate=Decimal(r['hourly_rate']);d=Decimal(r['deduction'])\\n   gross=h*rate+o*rate*m\\n   net=(gross*(1-w)-d).quantize(q, rounding=ROUND_HALF_EVEN)\\n   vals.append(net)\\n  print(m,w, sum(vals), ','.join(map(str,vals)))\\nPY\\npython /tmp/calc.py\"}",
      "status": "completed"
    }
