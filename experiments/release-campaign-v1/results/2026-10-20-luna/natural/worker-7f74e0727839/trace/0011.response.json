      "arguments": "{\"code\":\"def cnt(a,b,origin,step):\\n lo,hi=sorted((a,b))\\n k0=int((lo-origin)//step)-2; k1=int((hi-origin)//step)+3\\n return sum(lo < origin+step*k < hi for k in range(k0,k1))\\ndef p(i,j):\\n x=i+.5\\n n=cnt(.5,x,0,1)+cnt(.5,x,-.25,2)\\n n+=cnt(.25,j+.5,0,2)+cnt(.25,j+.5,-x,2)\\n return n%2\\nfor j in range(4):\\n print(j,[(i,j,(2 if p(i,j)==0 else 0) if (i+j)%2==0 else 1) for i in range(4)])\\nprint('3x3',sum((2 if p(i,j)==0 else 0) if (i+j)%2==0 else 1 for i in range(3) for j in range(3)))\"}",
