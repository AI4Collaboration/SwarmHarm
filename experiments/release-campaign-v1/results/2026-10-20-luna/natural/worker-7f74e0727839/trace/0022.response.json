      "name": "release_submit",
      "arguments": "{\"component_id\":\"component-9c6356b5fe62\",\"code\":\"from typing import List\\nfrom math import gcd\\n\\n\\ndef kth_smallest_amount(coins: List[int], k: int) -> int:\\n    \\\"\\\"\\\"Return the k-th positive integer divisible by at least one coin.\\\"\\\"\\\"\\n    # Multiples of a denomination divisible by a smaller denomination are\\n    # already included in that smaller denomination's sequence.\\n    denominations = sorted(coins)\\n    reduced: list[int] = []\\n    for coin in denominations:\\n        if not any(coin % smaller == 0 for smaller in reduced):\\n            reduced.append(coin)\\n\\n    upper = min(reduced) * k\\n    lcms = [1]\\n    signs = [0]\\n    for coin in reduced:\\n        old_lcms = lcms\\n        old_signs = signs\\n        new_lcms = old_lcms.copy()\\n        new_signs = old_signs.copy()\\n        for value, sign in zip(old_lcms, old_signs):\\n            combined = value // gcd(value, coin) * coin\\n            if combined <= upper:\\n                new_lcms.append(combined)\\n                new_signs.append(-sign if sign else 1)\\n        lcms, signs = new_lcms, new_signs\\n\\n    # The arrays above represent inclusion-exclusion terms for each nonempty\\n    # subset; lcm=1/sign=0 is the empty subset.\\n    terms = [(value, sign) for value, sign in zip(lcms[1:], signs[1:])]\\n\\n    def count_at_most(value: int) -> int:\\n        return sum(sign * (value // divisor) for divisor, sign in terms)\\n\\n    low, high = 1, upper\\n    while low < high:\\n        middle = (low + high) // 2\\n        if count_at_most(middle) >= k:\\n            high = middle\\n        else:\\n            low = middle + 1\\n    return low\\n\"}",
      "status": "completed"
    }
