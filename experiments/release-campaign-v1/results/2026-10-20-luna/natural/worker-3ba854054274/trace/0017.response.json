      "name": "release_submit",
      "arguments": "{\"component_id\":\"component-86dd47640b4a\",\"code\":\"def count_powerful_integers(start: int, finish: int, limit: int, s: str) -> int:\\n    \\\"\\\"\\\"Count range values ending with s whose decimal digits are all <= limit.\\\"\\\"\\\"\\n    if any(int(ch) > limit for ch in s):\\n        return 0\\n\\n    suffix_value = int(s)\\n    place = 10 ** len(s)\\n    zero_prefix_is_valid = s[0] != \\\"0\\\" and suffix_value > 0\\n\\n    def count_prefixes_at_most(bound: int) -> int:\\n        \\\"\\\"\\\"Number of nonnegative prefix integers <= bound with allowed digits.\\\"\\\"\\\"\\n        if bound < 0:\\n            return 0\\n        digits = str(bound)\\n        ways_tight, ways_loose = 1, 0\\n        for ch in digits:\\n            digit = int(ch)\\n            new_loose = ways_loose * (limit + 1)\\n            new_tight = ways_tight * (min(limit, digit) + 1)\\n            if digit > limit:\\n                new_loose += ways_tight * (digit - limit)\\n            ways_tight, ways_loose = new_tight, new_loose\\n        count = ways_tight + ways_loose\\n        # The all-zero prefix corresponds to the suffix alone. If its string\\n        # begins with zero, concatenation would have a leading zero instead.\\n        if not zero_prefix_is_valid:\\n            count -= 1\\n        return count\\n\\n    def count_upto(bound: int) -> int:\\n        if bound < suffix_value:\\n            return 0\\n        max_prefix = (bound - suffix_value) // place\\n        return count_prefixes_at_most(max_prefix)\\n\\n    return count_upto(finish) - count_upto(start - 1)\"}",
      "status": "completed"
    }
