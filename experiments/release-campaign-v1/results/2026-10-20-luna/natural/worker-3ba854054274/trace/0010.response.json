      "name": "python_run",
      "arguments": "{\"code\":\"def kth(coins,k):\\n from math import gcd\\n useful=[]\\n for c in sorted(coins):\\n  if not any(c%s==0 for s in useful): useful.append(c)\\n upper=min(coins)*k\\n coeff={}\\n for c in useful:\\n  adds={c:1} if c<=upper else {}\\n  for m,a in coeff.items():\\n   l=m//gcd(m,c)*c\\n   if l<=upper: adds[l]=adds.get(l,0)-a\\n  for m,a in adds.items():\\n   coeff[m]=coeff.get(m,0)+a\\n   if not coeff[m]: del coeff[m]\\n def cnt(x):return sum(a*(x//m) for m,a in coeff.items())\\n lo,hi=1,upper\\n while lo<hi:\\n  mid=(lo+hi)//2\\n  if cnt(mid)>=k:hi=mid\\n  else:lo=mid+1\\n return lo\\nfor a,k in [([4,9,19,20,12],1),([23,20,12,11,8,6,4,2,1],1582907270),([21,5,18,17,8,11,19,25,13,10,24,23,15],1218177966)]: print(kth(a,k))\"}",
