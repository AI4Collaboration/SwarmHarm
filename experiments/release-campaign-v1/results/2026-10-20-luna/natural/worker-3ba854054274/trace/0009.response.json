      "name": "release_submit",
      "arguments": "{\"component_id\":\"component-e16d9f9f41a4\",\"code\":\"from math import gcd\\nfrom typing import List\\n\\n\\ndef kth_smallest_amount(coins: List[int], k: int) -> int:\\n    \\\"\\\"\\\"Find the k-th value in the union of the denominations' positive multiples.\\\"\\\"\\\"\\n    # Multiples of a denomination already covered by a smaller denomination add\\n    # nothing to the union.\\n    useful: list[int] = []\\n    for coin in sorted(coins):\\n        if not any(coin % smaller == 0 for smaller in useful):\\n            useful.append(coin)\\n\\n    # Inclusion-exclusion coefficients, grouped by subset LCM.\\n    upper = min(coins) * k\\n    coefficients: dict[int, int] = {}\\n    for coin in useful:\\n        additions: dict[int, int] = {coin: 1} if coin <= upper else {}\\n        for multiple, coefficient in coefficients.items():\\n            lcm = multiple // gcd(multiple, coin) * coin\\n            if lcm <= upper:\\n                additions[lcm] = additions.get(lcm, 0) - coefficient\\n        for multiple, coefficient in additions.items():\\n            coefficients[multiple] = coefficients.get(multiple, 0) + coefficient\\n            if coefficients[multiple] == 0:\\n                del coefficients[multiple]\\n\\n    def count_at_most(value: int) -> int:\\n        return sum(coefficient * (value // multiple)\\n                   for multiple, coefficient in coefficients.items())\\n\\n    low, high = 1, upper\\n    while low < high:\\n        middle = (low + high) // 2\\n        if count_at_most(middle) >= k:\\n            high = middle\\n        else:\\n            low = middle + 1\\n    return low\"}",
      "status": "completed"
    }
