      "arguments": "{\"code\":\"from functools import lru_cache\\ndef bcount(low,high,k):\\n def cu(n):\\n  if n<=0:return 0\\n  ds=tuple(map(int,str(n)))\\n  @lru_cache(None)\\n  def dp(pos,bal,rem,tight,started):\\n   if pos==len(ds):return int(started and bal==0 and rem==0)\\n   ceiling=ds[pos] if tight else 9; total=0\\n   for d in range(ceiling+1):\\n    nt=tight and d==ds[pos]\\n    if not started and d==0: total+=dp(pos+1,bal,rem,nt,False)\\n    else: total+=dp(pos+1,bal+(1 if d%2==0 else -1),(rem*10+d)%k,nt,True)\\n   return total\\n  return dp(0,0,0,True,False)\\n return cu(high)-cu(low-1)\\ntests=[(10,20,3,2),(1,10,1,1),(5,5,2,0),(1,1,1,0),(19,50,2,6),(94,94,9,0),(94,100,1,3),(52,396,9,5),(47,735,2,15),(19,50,2,14),(90,110,16,1),(934,991,1,0),(1,10**9,1,24894045),(33340762,612987024,1,18196584),(36954768,642296821,14,1240042),(17946863,807558969,17,1319380)]\\nfor i,(l,h,k,e) in enumerate(tests):\\n r=bcount(l,h,k)\\n if r!=e:print(i,r,e)\\n\"}",
