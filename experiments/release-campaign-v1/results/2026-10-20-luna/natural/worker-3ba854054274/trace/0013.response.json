      "name": "release_submit",
      "arguments": "{\"component_id\":\"component-a996082c5542\",\"code\":\"from functools import lru_cache\\n\\n\\ndef count_beautiful_integers(low: int, high: int, k: int) -> int:\\n    \\\"\\\"\\\"Count integers whose even/odd digit counts match and which are divisible by k.\\\"\\\"\\\"\\n    def count_upto(bound: int) -> int:\\n        if bound <= 0:\\n            return 0\\n        digits = tuple(map(int, str(bound)))\\n\\n        @lru_cache(None)\\n        def dp(pos: int, balance: int, remainder: int, tight: bool, started: bool) -> int:\\n            if pos == len(digits):\\n                return int(started and balance == 0 and remainder == 0)\\n            ceiling = digits[pos] if tight else 9\\n            total = 0\\n            for digit in range(ceiling + 1):\\n                next_tight = tight and digit == digits[pos]\\n                if not started and digit == 0:\\n                    total += dp(pos + 1, balance, remainder, next_tight, False)\\n                else:\\n                    next_balance = balance + (1 if digit % 2 == 0 else -1)\\n                    next_remainder = (remainder * 10 + digit) % k\\n                    total += dp(pos + 1, next_balance, next_remainder,\\n                                next_tight, True)\\n            return total\\n\\n        return dp(0, 0, 0, True, False)\\n\\n    return count_upto(high) - count_upto(low - 1)\"}",
