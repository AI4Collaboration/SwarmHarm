      "arguments": "{\"code\":\"def calc(A,B,C,D):\\n def rect2(x,y):\\n  result=0\\n  thresholds=((2,True),(1,False),(2,False),(1,True))\\n  for i,(t,below) in enumerate(thresholds):\\n   left=max(0,i); right=min(x,i+1)\\n   if left>=right:continue\\n   u0,u1=left-i,right-i\\n   def L(u):\\n    p=lambda z:max(z,0)\\n    return p(t)**2-p(t-u)**2-p(t-y)**2+p(t-y-u)**2\\n   z=L(u1)-L(u0)\\n   result+=z if below else 2*(u1-u0)*y-z\\n  return result\\n def F(x,y):\\n  qx,rx=divmod(x,4); qy,ry=divmod(y,2)\\n  return qx*qy*8+qx*rect2(4,ry)+qy*rect2(rx,2)+rect2(rx,ry)\\n return F(C,D)-F(A,D)-F(C,B)+F(A,B)\\ntests=[((0,0,3,3),11),((-1,-2,1,3),11),((-10**9,-10**9,10**9,10**9),4000000000000000000),((593578395,-294607744,709130348,746175204),120264501770105970),((-678601079,-990141434,909949145,506736933),2377866465198604208),((-420376129,-732520502,229097481,-243073819),317882704110535631),((-1,-1,0,0),0),((-880976965,-698845539,-841240811,799247965),59528474181343616),((-706598544,47244307,-105634155,938741675),535758171500976836),((-691190744,-116861609,811710484,485546180),905359405844864892),((-470155176,-912361742,613356520,-773960622),149959232259499520),((-783899500,-317830601,-527458492,809390604),289065742049174640),((732193159,-597820905,914896137,-111527557),88847242861190344),((-929230299,-627268345,351001781,125422425),963618870073901600),((-770839702,-423993261,244950137,238497609),672951493845024495),((-61652596,28031419,688518481,862969889),626346691686101425),((-620080807,-705946951,512308373,-660949591),50954523592564800),((831487082,-595066332,976979640,562333390),168393045024869154),((-352155706,-373998982,-312914223,905871545),50224016887536278),((-306066545,-373037535,401042272,-215006244),111745319148977101),((-909441412,354830537,562133121,780454045),626336715231733518),((-115999220,-237739026,-29789995,608949093),72992326979041835),((-347229815,-995449898,664318316,648408554),1662841943927223986),((-50494404,-97049623,897901965,31953859),1223464339816