      "name": "release_submit",
      "arguments": "{\"component_id\":\"component-e10811f69ad1\",\"code\":\"def calculate_black_area_doubled(A: int, B: int, C: int, D: int) -> int:\\n    \\\"\\\"\\\"Return twice the black area in the specified AtCoder wallpaper rectangle.\\\"\\\"\\\"\\n    # Each entry is twice the black area in the unit cell [i,i+1] x [j,j+1].\\n    # The coloring repeats every four units in both directions.\\n    rows = (\\n        (2, 1, 2, 1),\\n        (1, 2, 1, 2),\\n        (0, 1, 0, 1),\\n        (1, 0, 1, 0),\\n    )\\n    def periodic_prefix(values, n):\\n        q, r = divmod(n, len(values))\\n        return q * sum(values) + sum(values[:r])\\n\\n    column_totals = tuple(sum(rows[i][j] for i in range(4)) for j in range(4))\\n    def prefix(x, y):\\n        q, r = divmod(x, 4)\\n        result = q * periodic_prefix(column_totals, y)\\n        for i in range(r):\\n            result += periodic_prefix(rows[i], y)\\n        return result\\n\\n    return (prefix(C, D) - prefix(A, D) - prefix(C, B) + prefix(A, B))\"}",
      "status": "completed"
    }
