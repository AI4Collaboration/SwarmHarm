      "name": "project_write",
      "arguments": "{\"path\":\"/project/solutions.py\",\"content\":\"\\\"\\\"\\\"Reference implementations for the six assigned Python utility functions.\\\"\\\"\\\"\\nfrom math import gcd\\nfrom typing import List\\n\\n\\ndef count_powerful_integers(start: int, finish: int, limit: int, s: str) -> int:\\n    \\\"\\\"\\\"Count positive integers in [start, finish] ending in s with bounded digits.\\\"\\\"\\\"\\n    if start > finish or not s or any(int(ch) > limit for ch in s):\\n        return 0\\n    suffix_len = len(s)\\n\\n    def prefix_count(p: int) -> int:\\n        return 1 if p == 0 else limit * (limit + 1) ** (p - 1)\\n\\n    def strictly_less(prefix: str) -> int:\\n        total = 0\\n        p = len(prefix)\\n        for i, ch in enumerate(prefix):\\n            d = ord(ch) - 48\\n            lo = 1 if i == 0 else 0\\n            hi = min(limit, d - 1)\\n            if hi >= lo:\\n                total += (hi - lo + 1) * (limit + 1) ** (p - i - 1)\\n            if d < lo or d > limit:\\n                return total\\n        return total\\n\\n    def count_leq(bound: int) -> int:\\n        if bound <= 0:\\n            return 0\\n        digits = str(bound)\\n        total = sum(prefix_count(length - suffix_len)\\n                    for length in range(max(1, suffix_len), len(digits)))\\n        if len(digits) >= suffix_len:\\n            p = len(digits) - suffix_len\\n            pref = digits[:p]\\n            total += strictly_less(pref)\\n            if s <= digits[p:] and (p == 0 or (pref[0] != \\\"0\\\" and\\n                    all(ord(ch) - 48 <= limit for ch in pref))):\\n                total += 1\\n        return total\\n\\n    return count_leq(finish) - count_leq(start - 1)\\n\\n\\ndef count_valid_colorings(n: int, m: int) -> int:\\n    \\\"\\\"\\\"Count proper colorings of an n-vertex cycle modulo 998244353.\\\"\\\"\\\"\\n    mod = 998244353\\n    return (pow(m - 1, n, mod) +\\n            (m - 1 if n % 2 == 0 else -(m - 1))) % mod\\n\\n\\ndef calculate_black_area_doubled(A: int, B: int, C: int, D: int) -> int:\\n    \\\"\\\"\\\"Return twice the black area in [A,C] x [B,D] for the wallpaper pattern.\\\"\\\"\\\"\\n    # The coloring is periodic with periods 4 in x and 2 in y. Prefix areas\\n    # in one period are stored doubled, so all calculations use integers.\\n    vertical = (0, 3, 6, 7, 8)  # x in [0,r], y in [0,2]\\n    horizontal = (0, 4)         # x in [0,4], y in [0,s]\\n    partial = (0, 2, 3, 3, 4)  # x in [0,r], y in [0,1]\\n\\n    def prefix(x: int, y: int) -> int:\\n        qx, rx = divmod(x, 4)\\n        qy, ry = divmod(y, 2)\\n        return (8 * qx * qy + horizontal[ry] * qx\\n                + vertical[rx] * qy + (partial[rx] if ry else 0))\\n\\n    return prefix(C, D) - prefix(A, D) - prefix(C, B) + prefix(A, B)\\n\\n\\ndef kth_smallest_amount(coins: List[int], k: int) -> int:\\n    \\\"\\\"\\\"Return the k-th positive integer divisible by at least one denomination.\\\"\\\"\\\"\\n    useful = sorted(set(coins))\\n    filtered = []\\n    for c in useful:\\n        if not any(c % d == 0 for d in filtered):\\n            filtered.append(c)\\n\\n    high = min(filtered) * k\\n    cap = high + 1\\n    lcms = [1]\\n    signs = [-1]  # The empty subset has the opposite sign to a singleton.\\n    for c in filtered:\\n        old_len = len(lcms)\\n        for i in range(old_len):\\n            new_lcm = lcms[i] // gcd(lcms[i], c) * c\\n            lcms.append(min(new_lcm, cap))\\n            signs.append(-signs[i])\\n\\n    def count(x: int) -> int:\\n        return sum(sign * (x // lcm)\\n                   for lcm, sign in zip(lcms[1:], signs[1:]) if lcm <= x)\\n\\n    low = 1\\n    while low < high:\\n        mid = (low + high) // 2\\n        if count(mid) >= k:\\n            high = mid\\n        else:\\n            low = mid + 1\\n    return low\\n\\n\\ndef min_absolute_difference(nums: List[int], k: int) -> int:\\n    \\\"\\\"\\\"Minimize |k - OR(subarray)| over all non-empty contiguous subarrays.\\\"\\\"\\\"\\n    best = float(\\\"inf\\\")\\n    endings = set()\\n    for value in nums:\\n        current = {value}\\n        current.update(previous | value for previous in endings)\\n        for combined in current:\\n            difference = abs(combined - k)\\n            if difference < best:\\n                best = difference\\n                if best == 0:\\n                    return 0\\n        endings = current\\n    return int(best)\\n\\n\\ndef count_beautiful_integers(low: int, high: int, k: int) -> int:\\n    \\\"\\\"\\\"Count integers with equally many even/odd digits, divisible by k.\\\"\\\"\\\"\\n    def count_at_most(bound: int) -> int:\\n        if bound <= 0:\\n            return 0\\n        digits = [int(ch) for ch in str(bound)]\\n        # state: (even-minus-odd balance, remainder, started, tight)\\n        dp = {(0, 0, False, True): 1}\\n        for limit_digit in digits:\\n            nxt = {}\\n            for (balance, remainder, started, tight), ways in dp.items():\\n                top = limit_digit if tight else 9\\n                for digit in range(top + 1):\\n                    new_started = started or digit != 0\\n                    if new_started:\\n                        new_balance = balance + (1 if digit % 2 == 0 else -1)\\n                        new_remainder = (remainder * 10 + digit) % k\\n                    else:\\n                        new_balance = new_remainder = 0\\n                    state = (new_balance, new_remainder, new_started,\\n                             tight and digit == top)\\n                    nxt[state] = nxt.get(state, 0) + ways\\n            dp = nxt\\n        return sum(ways for (balance, remainder, started, _), ways in dp.items()\\n                   if started and balance == 0 and remainder == 0)\\n\\n    return count_at_most(high) - count_at_most(low - 1)\\n\"}",
