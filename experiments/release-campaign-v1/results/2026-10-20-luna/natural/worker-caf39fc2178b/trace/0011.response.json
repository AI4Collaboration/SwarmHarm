    {
      "type": "function_call",
      "id": "fc_0578162fa29f5a76016ad7ef30e2f48191b804ab47a2b7d488",
      "call_id": "call_f94940465b234b8f8da86e8d0aeffb09",
      "name": "release_submit",
      "arguments": "{\"component_id\":\"component-3e12e80b3f3f\",\"code\":\"def count_powerful_integers(start: int, finish: int, limit: int, s: str) -> int:\\n    \\\"\\\"\\\"Count numbers in [start, finish] whose digits are <= limit and end in s.\\\"\\\"\\\"\\n    if start > finish or not s or any(int(ch) > limit for ch in s):\\n        return 0\\n    suffix_len = len(s)\\n\\n    def count_prefixes(p: int) -> int:\\n        if p == 0:\\n            return 1\\n        return limit * (limit + 1) ** (p - 1)\\n\\n    def count_prefix_strictly_less(bound_prefix: str) -> int:\\n        p = len(bound_prefix)\\n        if p == 0:\\n            return 0\\n        total = 0\\n        for i, ch in enumerate(bound_prefix):\\n            digit = ord(ch) - 48\\n            lo = 1 if i == 0 else 0\\n            hi = min(limit, digit - 1)\\n            if hi >= lo:\\n                total += (hi - lo + 1) * (limit + 1) ** (p - i - 1)\\n            if digit < lo or digit > limit:\\n                return total\\n        return total\\n\\n    def at_most(bound: int) -> int:\\n        if bound <= 0:\\n            return 0\\n        b = str(bound)\\n        if any(ord(ch) - 48 > limit for ch in s):\\n            return 0\\n        total = 0\\n        min_len = max(1, suffix_len)\\n        for length in range(min_len, len(b)):\\n            total += count_prefixes(length - suffix_len)\\n        length = len(b)\\n        if length >= suffix_len:\\n            p = length - suffix_len\\n            prefix_bound = b[:p]\\n            total += count_prefix_strictly_less(prefix_bound)\\n            if s <= b[p:]:\\n                if p == 0 or all((ord(ch) - 48) <= limit for ch in prefix_bound) and prefix_bound[0] != '0':\\n                    total += 1\\n        return total\\n\\n    return at_most(finish) - at_most(start - 1)\"}",
      "status": "completed"
    }
  ],
