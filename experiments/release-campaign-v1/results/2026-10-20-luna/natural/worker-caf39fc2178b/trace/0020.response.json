      "arguments": "{\"code\":\"def count_leq(bound,k):\\n if bound<=0:return 0\\n digs=list(map(int,str(bound)))\\n # dictionary state (balance, rem, started, tight)\\n dp={(0,0,False,True):1}\\n for lim in digs:\\n  nd={}\\n  for (bal,rem,st,tight),ways in dp.items():\\n   hi=lim if tight else 9\\n   for d in range(hi+1):\\n    ns=st or d!=0\\n    nb=bal+(1 if d%2==0 else -1) if ns else 0\\n    nr=(rem*10+d)%k if ns else 0\\n    key=(nb,nr,ns,tight and d==hi)\\n    nd[key]=nd.get(key,0)+ways\\n  dp=nd\\n return sum(v for (bal,rem,st,t),v in dp.items() if st and bal==0 and rem==0)\\ndef f(lo,hi,k):return count_leq(hi,k)-count_leq(lo-1,k)\\nT=[(10,20,3,2),(1,10,1,1),(5,5,2,0),(1,1,1,0),(19,50,2,6),(94,94,9,0),(94,100,1,3),(52,396,9,5),(47,735,2,15),(19,50,2,14),(90,110,16,1),(934,991,1,0),(1,10**9,1,24894045),(33340762,612987024,1,18196584),(36954768,642296821,14,1240042),(17946863,807558969,17,1319380)]\\nfor t in T:\\n print(t,f(*t[:3]))\"}",
