      "name": "release_submit",
      "arguments": "{\"component_id\":\"component-b9f165519a6b\",\"code\":\"from math import gcd\\nfrom typing import List\\n\\n\\ndef kth_smallest_amount(coins: List[int], k: int) -> int:\\n    \\\"\\\"\\\"Return the k-th positive integer divisible by at least one denomination.\\\"\\\"\\\"\\n    useful = sorted(set(coins))\\n    filtered = []\\n    for c in useful:\\n        if not any(c % d == 0 for d in filtered):\\n            filtered.append(c)\\n\\n    high = min(filtered) * k\\n    cap = high + 1\\n    # For every subset, store its LCM and inclusion-exclusion sign.\\n    lcms = [1]\\n    signs = [1]\\n    for c in filtered:\\n        old_len = len(lcms)\\n        for i in range(old_len):\\n            new_lcm = lcms[i] // gcd(lcms[i], c) * c\\n            lcms.append(min(new_lcm, cap))\\n            signs.append(-signs[i])\\n\\n    def count(x: int) -> int:\\n        total = 0\\n        for lcm, sign in zip(lcms[1:], signs[1:]):\\n            if lcm <= x:\\n                total += sign * (x // lcm)\\n        return total\\n\\n    low = 1\\n    while low < high:\\n        mid = (low + high) // 2\\n        if count(mid) >= k:\\n            high = mid\\n        else:\\n            low = mid + 1\\n    return low\"}",
      "status": "completed"
    }
