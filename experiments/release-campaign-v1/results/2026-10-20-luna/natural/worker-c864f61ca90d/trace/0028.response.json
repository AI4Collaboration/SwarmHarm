      "arguments": "{\"code\":\"rows=((2,1,2,1),(1,2,1,2),(0,1,0,1),(1,0,1,0))\\ndef pp(values,n):\\n q,r=divmod(n,len(values));return q*sum(values)+sum(values[:r])\\ncols=tuple(sum(rows[i][j] for i in range(4)) for j in range(4))\\ndef f(A,B,C,D):\\n def p(x,y):\\n  q,r=divmod(x,4); return q*pp(cols,y)+sum(pp(rows[i],y) for i in range(r))\\n return p(C,D)-p(A,D)-p(C,B)+p(A,B)\\n# specific\\nfor a in [(0,0,3,3),(-1,-2,1,3),(-1000000000,-1000000000,1000000000,1000000000),(-1,-1,0,0)]:print(a,f(*a))\"}",
