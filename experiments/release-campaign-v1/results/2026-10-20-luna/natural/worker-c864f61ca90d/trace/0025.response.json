      "name": "release_submit",
      "arguments": "{\"component_id\":\"component-7b89638da2ce\",\"code\":\"from functools import lru_cache\\n\\n\\ndef count_powerful_integers(start: int, finish: int, limit: int, s: str) -> int:\\n    \\\"\\\"\\\"Count positive integers in [start, finish] ending in s whose digits\\n    are all at most limit.\\n    \\\"\\\"\\\"\\n    if start > finish or not s or any(not ch.isdigit() or int(ch) > limit for ch in s):\\n        return 0\\n\\n    suffix = int(s)\\n    suffix_length = len(s)\\n    scale = 10 ** suffix_length\\n\\n    def count_prefixes_at_most(bound: int, length: int) -> int:\\n        \\\"\\\"\\\"Count valid fixed-length (non-leading-zero) prefixes <= bound.\\\"\\\"\\\"\\n        minimum = 10 ** (length - 1)\\n        if bound < minimum:\\n            return 0\\n        top = str(min(bound, 10 ** length - 1))\\n\\n        @lru_cache(maxsize=None)\\n        def dp(pos: int, tight: bool) -> int:\\n            if pos == length:\\n                return 1\\n            upper = int(top[pos]) if tight else limit\\n            first = 1 if pos == 0 else 0\\n            total = 0\\n            for digit in range(first, min(upper, limit) + 1):\\n                total += dp(pos + 1, tight and digit == upper)\\n            return total\\n\\n        return dp(0, True)\\n\\n    answer = 0\\n    for number_length in range(suffix_length, len(str(finish)) + 1):\\n        lower_number = max(start, 10 ** (number_length - 1))\\n        upper_number = min(finish, 10 ** number_length - 1)\\n        if lower_number > upper_number:\\n            continue\\n\\n        if number_length == suffix_length:\\n            if lower_number <= suffix <= upper_number:\\n                answer += 1\\n            continue\\n\\n        prefix_length = number_length - suffix_length\\n        lower_prefix = max(\\n            10 ** (prefix_length - 1),\\n            (lower_number - suffix + scale - 1) // scale,\\n        )\\n        upper_prefix = min(\\n            10 ** prefix_length - 1,\\n            (upper_number - suffix) // scale,\\n        )\\n        if lower_prefix <= upper_prefix:\\n            answer += (count_prefixes_at_most(upper_prefix, prefix_length)\\n                       - count_prefixes_at_most(lower_prefix - 1, prefix_length))\\n\\n    return answer\\n\"}",
      "status": "completed"
    }
