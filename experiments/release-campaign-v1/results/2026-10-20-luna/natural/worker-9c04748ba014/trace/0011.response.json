      "name": "release_submit",
      "arguments": "{\"component_id\":\"component-ff4e6afa649a\",\"code\":\"from functools import lru_cache\\n\\n\\ndef count_beautiful_integers(low: int, high: int, k: int) -> int:\\n    \\\"\\\"\\\"Count numbers with equally many even and odd digits, divisible by k.\\\"\\\"\\\"\\n    def count_up_to(bound: int) -> int:\\n        if bound <= 0:\\n            return 0\\n        digits = tuple(map(int, str(bound)))\\n        n = len(digits)\\n\\n        @lru_cache(None)\\n        def dp(pos: int, balance: int, remainder: int, tight: bool) -> int:\\n            if pos == n:\\n                return int(balance == 0 and remainder == 0)\\n            upper = digits[pos] if tight else 9\\n            total = 0\\n            first = 1 if pos == 0 else 0\\n            for digit in range(first, upper + 1):\\n                next_tight = tight and digit == upper\\n                next_balance = balance + (1 if digit % 2 == 0 else -1)\\n                total += dp(pos + 1, next_balance,\\n                            (remainder * 10 + digit) % k, next_tight)\\n            return total\\n\\n        return dp(0, 0, 0, True)\\n\\n    return count_up_to(high) - count_up_to(low - 1)\"}",
      "status": "completed"
    }
