      "name": "release_submit",
      "arguments": "{\"component_id\":\"component-6037df94f504\",\"code\":\"def count_powerful_integers(start: int, finish: int, limit: int, s: str) -> int:\\n    \\\"\\\"\\\"Count numbers in the range with suffix s and all digits at most limit.\\\"\\\"\\\"\\n    if not s or s[0] == \\\"0\\\" or any(not ch.isdigit() or int(ch) > limit for ch in s):\\n        return 0\\n    suffix_len = len(s)\\n\\n    def count_prefixes_at_most(bound: str) -> int:\\n        \\\"\\\"\\\"Count valid positive prefixes of this length <= the digit string.\\\"\\\"\\\"\\n        length = len(bound)\\n        if length == 0:\\n            return 0\\n        total = 0\\n        for i, ch in enumerate(bound):\\n            digit = ord(ch) - 48\\n            minimum = 1 if i == 0 else 0\\n            remaining = length - i - 1\\n            choices = max(0, min(limit, digit - 1) - minimum + 1)\\n            total += choices * (limit + 1) ** remaining\\n            if digit < minimum or digit > limit:\\n                return total\\n        return total + 1\\n\\n    def count_up_to(bound: int) -> int:\\n        if bound <= 0:\\n            return 0\\n        bound_text = str(bound)\\n        if suffix_len > len(bound_text):\\n            return 0\\n        total = 0\\n\\n        # All shorter valid values, with prefixes of any allowed digits.\\n        for length in range(suffix_len, len(bound_text)):\\n            prefix_len = length - suffix_len\\n            if prefix_len == 0:\\n                total += 1\\n            else:\\n                total += limit * (limit + 1) ** (prefix_len - 1)\\n\\n        prefix_len = len(bound_text) - suffix_len\\n        if prefix_len == 0:\\n            total += int(s <= bound_text)\\n        else:\\n            prefix_bound = bound_text[:prefix_len]\\n            prefixes = count_prefixes_at_most(prefix_bound)\\n            # The prefix equal to the bound prefix only works if the suffix is\\n            # no greater than the bound's remaining digits.\\n            if s > bound_text[prefix_len:]:\\n                prefix_is_valid = all(\\n                    1 <= int(ch) <= limit if i == 0 else 0 <= int(ch) <= limit\\n                    for i, ch in enumerate(prefix_bound)\\n                )\\n                if prefix_is_valid:\\n                    prefixes -= 1\\n            total += prefixes\\n        return total\\n\\n    return count_up_to(finish) - count_up_to(start - 1)\"}",
      "status": "completed"
    }
