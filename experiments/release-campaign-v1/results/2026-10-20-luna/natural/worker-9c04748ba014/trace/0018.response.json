      "arguments": "{\"code\":\"from functools import lru_cache\\n\\ndef countbeaut(low,high,k):\\n def upto(bound):\\n  if bound<=0:return 0\\n  digs=list(map(int,str(bound))); total=0\\n  for n in range(1,len(digs)+1):\\n   lim=digs if n==len(digs) else [9]*n\\n   @lru_cache(None)\\n   def dp(pos,balance,rem,tight):\\n    if pos==n:return int(balance==0 and rem==0)\\n    upper=lim[pos] if tight else 9\\n    ans=0\\n    for d in range(1 if pos==0 else 0,upper+1):\\n     ans+=dp(pos+1,balance+(1 if d%2==0 else -1),(rem*10+d)%k,tight and d==upper)\\n    return ans\\n   total+=dp(0,0,0,True)\\n  return total\\n return upto(high)-upto(low-1)\\nfor t in [(10,20,3),(1,10,1),(5,5,2),(1,1,1),(19,50,2),(94,94,9),(94,100,1),(52,396,9),(47,735,2),(90,110,16),(934,991,1),(1,1000000000,1),(33340762,612987024,1),(36954768,642296821,14),(17946863,807558969,17)]: print(t,countbeaut(*t))\"}",
