      "name": "release_submit",
      "arguments": "{\"component_id\":\"component-cecab5abb766\",\"code\":\"def calculate_black_area_doubled(A: int, B: int, C: int, D: int) -> int:\\n    \\\"\\\"\\\"Return twice the black area in the integer-coordinate rectangle.\\\"\\\"\\\"\\n    # Each unit square is either all black/white, or split in half by a\\n    # diagonal (then its contribution to twice-area is 1). The cell weights\\n    # repeat every four units in both directions.\\n    tile = [[0] * 4 for _ in range(4)]  # tile[x][y]\\n    for x in range(4):\\n        for y in range(4):\\n            if (x + y) & 1:\\n                tile[x][y] = 1\\n            else:\\n                # Sample the cell center; parity counts crossings of the\\n                # vertical, horizontal, and diagonal boundary families.\\n                parity = x + y // 2 + (x + y) // 2\\n                tile[x][y] = 2 if parity % 2 == 0 else 0\\n\\n    tile_total = sum(map(sum, tile))\\n    x_strip = [sum(tile[x][y] for y in range(4)) for x in range(4)]\\n    y_strip = [sum(tile[x][y] for x in range(4)) for y in range(4)]\\n\\n    def prefix(x: int, y: int) -> int:\\n        qx, rx = divmod(x, 4)\\n        qy, ry = divmod(y, 4)\\n        partial = sum(tile[i][j] for i in range(rx) for j in range(ry))\\n        return (qx * qy * tile_total\\n                + qy * sum(x_strip[:rx])\\n                + qx * sum(y_strip[:ry])\\n                + partial)\\n\\n    return prefix(C, D) - prefix(A, D) - prefix(C, B) + prefix(A, B)\"}",
      "status": "completed"
    }
