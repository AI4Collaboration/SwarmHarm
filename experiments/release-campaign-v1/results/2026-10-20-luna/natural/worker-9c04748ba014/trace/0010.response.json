      "arguments": "{\"component_id\":\"component-f27084f75764\",\"code\":\"from typing import List\\n\\n\\ndef min_absolute_difference(nums: List[int], k: int) -> int:\\n    \\\"\\\"\\\"Minimize the distance from k to a contiguous subarray's bitwise OR.\\\"\\\"\\\"\\n    # The distinct ORs of subarrays ending at a given index are at most the\\n    # number of bits in the input values: each extension can only set bits.\\n    ending = set()\\n    best = float(\\\"inf\\\")\\n    for value in nums:\\n        current = {value}\\n        current.update(value | previous for previous in ending)\\n        for result in current:\\n            best = min(best, abs(result - k))\\n            if best == 0:\\n                return 0\\n        ending = current\\n    return int(best)\"}",
