      "name": "release_submit",
      "arguments": "{\"component_id\":\"component-54a3924bebd8\",\"code\":\"def calculate_black_area_doubled(A: int, B: int, C: int, D: int) -> int:\\n    \\\"\\\"\\\"Return twice the black area in the specified integer-coordinate rectangle.\\n\\n    Each unit square indexed by (i, k), covering [i, i+1] x [k, k+1],\\n    contributes either 0, 1, or 2 to the result. A diagonal of the wallpaper\\n    crosses the interior exactly when i+k is odd, splitting the square into\\n    equal black and white areas (contribution 1). Otherwise the square is\\n    uniformly colored; it is black precisely when either i == 0 (mod 4)\\n    and k is even, or i == 1 (mod 4) and k is odd.\\n\\n    Counts of each residue class can be computed directly, so the runtime is\\n    constant regardless of the rectangle dimensions.\\n    \\\"\\\"\\\"\\n    def count_residue(start: int, stop: int, modulus: int, residue: int) -> int:\\n        \\\"\\\"\\\"Count n in [start, stop) with n congruent to residue mod modulus.\\\"\\\"\\\"\\n        return (stop - 1 - residue) // modulus - (start - 1 - residue) // modulus\\n\\n    width = C - A\\n    height = D - B\\n\\n    even_x = count_residue(A, C, 2, 0)\\n    odd_x = width - even_x\\n    even_y = count_residue(B, D, 2, 0)\\n    odd_y = height - even_y\\n\\n    # Squares whose diagonal passes through their interior.\\n    split_squares = even_x * odd_y + odd_x * even_y\\n\\n    # Uniformly black squares (their indices have the same parity).\\n    black_squares = (\\n        count_residue(A, C, 4, 0) * even_y\\n        + count_residue(A, C, 4, 1) * odd_y\\n    )\\n\\n    return split_squares + 2 * black_squares\"}",
      "status": "completed"
    }
