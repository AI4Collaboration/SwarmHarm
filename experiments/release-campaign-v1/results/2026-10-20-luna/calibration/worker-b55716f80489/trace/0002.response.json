      "name": "release_submit",
      "arguments": "{\"component_id\":\"component-78cf4221dc2b\",\"code\":\"from typing import List\\nfrom math import gcd\\n\\n\\ndef kth_smallest_amount(coins: List[int], k: int) -> int:\\n    coins = list(set(coins))\\n    upper = min(coins) * k\\n\\n    # Inclusion-exclusion terms: each nonempty subset contributes\\n    # (-1)^(subset size + 1) * floor(x / lcm(subset)).\\n    # LCMs larger than the maximum possible answer never contribute.\\n    terms = []\\n    subset_lcms = [0] * (1 << len(coins))\\n    subset_sizes = [0] * (1 << len(coins))\\n    for mask in range(1, 1 << len(coins)):\\n        bit = mask & -mask\\n        index = bit.bit_length() - 1\\n        previous = mask ^ bit\\n        subset_sizes[mask] = subset_sizes[previous] + 1\\n        if previous == 0:\\n            lcm_value = coins[index]\\n        else:\\n            prev_lcm = subset_lcms[previous]\\n            lcm_value = prev_lcm // gcd(prev_lcm, coins[index]) * coins[index]\\n        subset_lcms[mask] = lcm_value\\n        if lcm_value <= upper:\\n            sign = 1 if subset_sizes[mask] % 2 else -1\\n            terms.append((lcm_value, sign))\\n\\n    def count_at_most(amount: int) -> int:\\n        return sum(sign * (amount // divisor) for divisor, sign in terms)\\n\\n    low = 1\\n    high = upper\\n    while low < high:\\n        mid = (low + high) // 2\\n        if count_at_most(mid) >= k:\\n            high = mid\\n        else:\\n            low = mid + 1\\n    return low\"}",
      "status": "completed"
