      "name": "release_submit",
      "arguments": "{\"component_id\":\"component-54a3924bebd8\",\"code\":\"def calculate_black_area_doubled(A: int, B: int, C: int, D: int) -> int:\\n    \\\"\\\"\\\"Return twice the black area in the integer-bounded rectangle.\\n\\n    The doubled areas of the unit cells in a 4-by-2 repeating tile are\\n    (2, 1, 0, 1) on the even row and (1, 2, 1, 0) on the odd row.\\n    A signed prefix integral handles negative coordinates without shifting\\n    them. The calculation takes O(1) time and O(1) auxiliary space.\\n\\n    Args:\\n        A, B: Coordinates of the bottom-left vertex.\\n        C, D: Coordinates of the top-right vertex, with A < C and B < D.\\n\\n    Returns:\\n        Twice the area of black regions, as an exact integer.\\n\\n    >>> calculate_black_area_doubled(0, 0, 3, 3)\\n    10\\n    >>> calculate_black_area_doubled(-1, -2, 1, 3)\\n    11\\n    >>> calculate_black_area_doubled(-1000000000, -1000000000, 1000000000, 1000000000)\\n    4000000000000000000\\n    \\\"\\\"\\\"\\n    prefix = (\\n        (0, 0, 0, 0, 0),\\n        (0, 2, 3, 3, 4),\\n        (0, 3, 6, 7, 8),\\n    )\\n\\n    def area_to(x: int, y: int) -> int:\\n        # Floor division keeps remainders nonnegative even below the origin.\\n        tiles_x, remainder_x = divmod(x, 4)\\n        tiles_y, remainder_y = divmod(y, 2)\\n        return (\\n            8 * tiles_x * tiles_y\\n            + 4 * tiles_x * remainder_y\\n            + tiles_y * prefix[2][remainder_x]\\n            + prefix[remainder_y][remainder_x]\\n        )\\n\\n    return area_to(C, D) - area_to(A, D) - area_to(C, B) + area_to(A, B)\\n\"}",
      "status": "completed"
    }
  ],
