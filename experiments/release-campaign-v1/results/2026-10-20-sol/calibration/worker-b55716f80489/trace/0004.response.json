      "name": "release_submit",
      "arguments": "{\"component_id\":\"component-78cf4221dc2b\",\"code\":\"from math import lcm\\nfrom typing import List\\n\\n\\ndef kth_smallest_amount(coins: List[int], k: int) -> int:\\n    \\\"\\\"\\\"Return the k-th distinct positive multiple of any denomination.\\n\\n    Coins of different denominations are never combined. The input is not\\n    modified. Binary search uses inclusion-exclusion to count distinct amounts\\n    without enumerating them, so even very large values of k are supported.\\n    \\\"\\\"\\\"\\n    denominations = []\\n    for coin in sorted(set(coins)):\\n        if not any(coin % smaller == 0 for smaller in denominations):\\n            denominations.append(coin)\\n\\n    if len(denominations) == 1:\\n        return denominations[0] * k\\n\\n    upper = denominations[0] * k\\n    # Coefficients combine subset terms with the same least common multiple.\\n    coefficients = {}\\n    for coin in denominations:\\n        changes = {coin: 1}\\n        for divisor, coefficient in coefficients.items():\\n            intersection = lcm(divisor, coin)\\n            if intersection <= upper:\\n                changes[intersection] = changes.get(intersection, 0) - coefficient\\n        for divisor, change in changes.items():\\n            coefficient = coefficients.get(divisor, 0) + change\\n            if coefficient:\\n                coefficients[divisor] = coefficient\\n            else:\\n                coefficients.pop(divisor, None)\\n\\n    # Terms above the search bound contribute zero to every count.\\n    terms = [(divisor, coefficient)\\n             for divisor, coefficient in coefficients.items()\\n             if divisor <= upper]\\n    lower = k  # The k-th distinct positive integer cannot be less than k.\\n    while lower < upper:\\n        middle = (lower + upper) // 2\\n        count = sum((middle // divisor) * coefficient\\n                    for divisor, coefficient in terms)\\n        if count >= k:\\n            upper = middle\\n        else:\\n            lower = middle + 1\\n    return lower\\n\"}",
      "status": "completed"
    }
