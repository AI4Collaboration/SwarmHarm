      "name": "release_submit",
      "arguments": "{\"component_id\":\"component-248542089df4\",\"code\":\"from functools import lru_cache\\n\\n\\ndef count_beautiful_integers(low: int, high: int, k: int) -> int:\\n    \\\"\\\"\\\"Count positive integers in [low, high] with balanced digit parity\\n    and divisibility by k. Leading zeros are not part of a number's digits.\\n\\n    Uses digit dynamic programming instead of iterating over the range.\\n    \\\"\\\"\\\"\\n    def count_up_to(limit: int) -> int:\\n        if limit <= 0:\\n            return 0\\n\\n        digits = tuple(map(int, str(limit)))\\n        length = len(digits)\\n\\n        @lru_cache(maxsize=None)\\n        def dp(position: int, balance: int, remainder: int,\\n               started: bool, tight: bool) -> int:\\n            remaining = length - position\\n            # Each remaining digit can change the balance by only one.\\n            if abs(balance) > remaining:\\n                return 0\\n            # Once started, all remaining positions are actual digits.\\n            if started and (remaining - balance) % 2:\\n                return 0\\n            if position == length:\\n                return int(started and balance == 0 and remainder == 0)\\n\\n            upper = digits[position] if tight else 9\\n            total = 0\\n            for digit in range(upper + 1):\\n                next_tight = tight and digit == digits[position]\\n                if not started and digit == 0:\\n                    total += dp(position + 1, 0, 0, False, next_tight)\\n                else:\\n                    total += dp(\\n                        position + 1,\\n                        balance + (1 if digit % 2 == 0 else -1),\\n                        (remainder * 10 + digit) % k,\\n                        True,\\n                        next_tight,\\n                    )\\n            return total\\n\\n        return dp(0, 0, 0, False, True)\\n\\n    return count_up_to(high) - count_up_to(low - 1)\\n\"}",
      "status": "completed"
    }
