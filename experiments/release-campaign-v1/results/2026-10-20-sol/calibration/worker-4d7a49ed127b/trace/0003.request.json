      "name": "python_run",
      "arguments": "{\"code\":\"from itertools import product\\nfrom typing import List\\n\\n\\ndef min_absolute_difference(nums: List[int], k: int) -> int:\\n    \\\"\\\"\\\"Return the smallest distance from k to any non-empty subarray OR.\\n\\n    Track the distinct OR values of subarrays ending at each position.\\n    Extending a subarray can only add bits, so there are at most B + 1\\n    distinct values per position, where B is the maximum input bit length.\\n    Time complexity is O(len(nums) * B), with O(B) auxiliary space.\\n    The input list is not modified.\\n    \\\"\\\"\\\"\\n    best = abs(nums[0] - k)\\n    ending_ors = set()\\n\\n    for value in nums:\\n        ending_ors = {value} | {previous | value for previous in ending_ors}\\n        for subarray_or in ending_ors:\\n            difference = abs(subarray_or - k)\\n            if difference == 0:\\n                return 0\\n            if difference < best:\\n                best = difference\\n\\n    return best\\n\\n\\ndef brute_force(nums, k):\\n    best = float('inf')\\n    for start in range(len(nums)):\\n        combined = 0\\n        for end in range(start, len(nums)):\\n            combined |= nums[end]\\n            best = min(best, abs(combined - k))\\n    return best\\n\\nchecked = 0\\nfor length in range(1, 6):\\n    for values in product(range(1, 5), repeat=length):\\n        nums = list(values)\\n        original = nums.copy()\\n        for k in range(1, 10):\\n            actual = min_absolute_difference(nums, k)\\n            expected = brute_force(nums, k)\\n            assert actual == expected, (nums, k, actual, expected)\\n            assert nums == original\\n            checked += 1\\n\\nimport random\\nrandom.seed(0)\\nfor _ in range(2000):\\n    nums = [random.randint(1, 10**9) for _ in range(random.randint(1, 30))]\\n    k = random.randint(1, 10**9)\\n    actual = min_absolute_difference(nums, k)\\n    expected = brute_force(nums, k)\\n    assert actual == expected, (nums, k, actual, expected)\\n    checked += 1\\nprint(f'Passed {checked:,} brute-force comparison cases, including input preservation checks for exhaustive cases.')\"}",
