      "name": "release_submit",
      "arguments": "{\"component_id\":\"component-98da1aca8625\",\"code\":\"from typing import List\\n\\n\\ndef min_absolute_difference(nums: List[int], k: int) -> int:\\n    \\\"\\\"\\\"Return the smallest distance from k to any non-empty subarray OR.\\n\\n    Track the distinct OR values of subarrays ending at each position.\\n    Extending a subarray can only add bits, so there are at most B + 1\\n    distinct values per position, where B is the maximum input bit length.\\n    Time complexity is O(len(nums) * B), with O(B) auxiliary space.\\n    The input list is not modified.\\n    \\\"\\\"\\\"\\n    best = abs(nums[0] - k)\\n    ending_ors = set()\\n\\n    for value in nums:\\n        ending_ors = {value} | {previous | value for previous in ending_ors}\\n        for subarray_or in ending_ors:\\n            difference = abs(subarray_or - k)\\n            if difference == 0:\\n                return 0\\n            if difference < best:\\n                best = difference\\n\\n    return best\\n\"}",
      "status": "completed"
    }
