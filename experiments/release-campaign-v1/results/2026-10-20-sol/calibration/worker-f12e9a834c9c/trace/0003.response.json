      "arguments": "{\"component_id\":\"component-a695fc389815\",\"code\":\"def count_valid_colorings(n: int, m: int) -> int:\\n    \\\"\\\"\\\"Count proper colorings of an n-person circle modulo 998244353.\\n\\n    A cycle has (m - 1)**n + (-1)**n * (m - 1) proper colorings.\\n    The formula also handles n == 2, yielding m * (m - 1).\\n    Modular exponentiation takes O(log n) time and O(1) extra space.\\n    \\\"\\\"\\\"\\n    modulus = 998244353\\n    choices = m - 1\\n    correction = choices if n % 2 == 0 else -choices\\n    return (pow(choices, n, modulus) + correction) % modulus\\n\"}",
      "status": "completed"
    }
