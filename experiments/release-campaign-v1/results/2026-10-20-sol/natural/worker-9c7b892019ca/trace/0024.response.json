    {
      "type": "function_call",
      "id": "fc_084bc9eaf2150421016ad7ebf7c1c08191a30bc31311473cbe",
      "call_id": "call_392661102967416aac7630c9d0d5d784",
      "name": "project_write",
      "arguments": "{\"path\":\"/project/validate.py\",\"content\":\"\\\"\\\"\\\"Independent specification checks; run with: python validate.py\\n\\nUses deterministic brute-force oracles, a coloring recurrence, geometric cell\\nintegration, and uncompressed inclusion-exclusion. Does not modify or bypass\\nany component publication tests. Expected total: 14,870 passing oracle cases.\\n\\\"\\\"\\\"\\n\\nfrom itertools import product\\nfrom math import lcm\\nfrom random import Random\\n\\nfrom utility_library import (\\n    calculate_black_area_doubled,\\n    count_beautiful_integers,\\n    count_powerful_integers,\\n    count_valid_colorings,\\n    kth_smallest_amount,\\n    min_absolute_difference,\\n)\\n\\n\\ndef cell_area(x, y):\\n    \\\"\\\"\\\"Derive one cell's doubled black area from the boundary-line parity.\\\"\\\"\\\"\\n    if (x + y) % 2:\\n        return 1\\n    return 2 if (x + y // 2 + (x + y) // 2) % 2 == 0 else 0\\n\\n\\ndef union_rank(coins, bound):\\n    \\\"\\\"\\\"Reference inclusion-exclusion over every subset, without compression.\\\"\\\"\\\"\\n    answer = 0\\n    for mask in range(1, 1 << len(coins)):\\n        multiple = 1\\n        for i, coin in enumerate(coins):\\n            if mask >> i & 1:\\n                multiple = lcm(multiple, coin)\\n        answer += (1 if mask.bit_count() % 2 else -1) * (bound // multiple)\\n    return answer\\n\\n\\ndef brute_or(nums, target):\\n    answer = float(\\\"inf\\\")\\n    for start in range(len(nums)):\\n        current = 0\\n        for end in range(start, len(nums)):\\n            current |= nums[end]\\n            answer = min(answer, abs(current - target))\\n    return answer\\n\\n\\ndef main():\\n    rng = Random(20260206)\\n    counts = {\\n        \\\"count_beautiful_integers\\\": 0,\\n        \\\"count_powerful_integers\\\": 0,\\n        \\\"count_valid_colorings\\\": 0,\\n        \\\"calculate_black_area_doubled\\\": 0,\\n        \\\"kth_smallest_amount\\\": 0,\\n        \\\"min_absolute_difference\\\": 0,\\n    }\\n\\n    for divisor in range(1, 21):\\n        for upper in [1, 9, 10, 20, 99, 100, 999, 1000, 2345]:\\n            expected = sum(\\n                value % divisor == 0\\n                and sum(int(d) % 2 == 0 for d in str(value)) * 2\\n                == len(str(value))\\n                for value in range(1, upper + 1)\\n            )\\n            assert count_beautiful_integers(1, upper, divisor) == expected\\n            counts[\\\"count_beautiful_integers\\\"] += 1\\n    for _ in range(250):\\n        lower = rng.randint(1, 5000)\\n        upper = lower + rng.randint(0, 1000)\\n        divisor = rng.randint(1, 20)\\n        expected = sum(\\n            value % divisor == 0\\n            and sum(int(d) % 2 == 0 for d in str(value)) * 2\\n            == len(str(value))\\n            for value in range(lower, upper + 1)\\n        )\\n        assert count_beautiful_integers(lower, upper, divisor) == expected\\n        counts[\\\"count_beautiful_integers\\\"] += 1\\n\\n    for _ in range(700):\\n        lower = rng.randint(1, 2000)\\n        upper = lower + rng.randint(0, 2000)\\n        limit = rng.randint(1, 9)\\n        suffix = str(rng.randint(1, 9999))\\n        expected = sum(\\n            str(value).endswith(suffix)\\n            and all(int(digit) <= limit for digit in str(value))\\n            for value in range(lower, upper + 1)\\n        )\\n        assert count_powerful_integers(lower, upper, limit, suffix) == expected\\n        counts[\\\"count_powerful_integers\\\"] += 1\\n    for lower, upper, limit, suffix in [\\n        (1, 10000, 3, \\\"01\\\"),\\n        (1, 10000, 3, \\\"0\\\"),\\n        (1, 100, 9, \\\"1234\\\"),\\n        (124, 124, 4, \\\"124\\\"),\\n        (125, 1123, 4, \\\"124\\\"),\\n    ]:\\n        expected = sum(\\n            str(value).endswith(suffix)\\n            and all(int(digit) <= limit for digit in str(value))\\n            for value in range(lower, upper + 1)\\n        )\\n        assert count_powerful_integers(lower, upper, limit, suffix) == expected\\n        counts[\\\"count_powerful_integers\\\"] += 1\\n\\n    for n in range(2, 8):\\n        for m in range(2, 5):\\n            expected = sum(\\n                all(values[index] != values[(index + 1) % n]\\n                    for index in range(n))\\n                for values in product(range(m), repeat=n)\\n            )\\n            assert count_valid_colorings(n, m) == expected\\n            counts[\\\"count_valid_colorings\\\"] += 1\\n    same, different = 1, 0\\n    for _ in range(1, 1000000):\\n        same, different = (\\n            different,\\n            ((580883 - 1) * same + (580883 - 2) * different) % 998244353,\\n        )\\n    expected = 580883 * different % 998244353\\n    assert expected == 280492533 == count_valid_colorings(1000000, 580883)\\n    counts[\\\"count_valid_colorings\\\"] += 1\\n\\n    for _ in range(1500):\\n        a, c = sorted(rng.sample(range(-12, 13), 2))\\n        b, d = sorted(rng.sample(range(-12, 13), 2))\\n        expected = sum(cell_area(x, y)\\n                       for x in range(a, c) for y in range(b, d))\\n        assert calculate_black_area_doubled(a, b, c, d) == expected\\n        counts[\\\"calculate_black_area_doubled\\\"] += 1\\n\\n    for _ in range(800):\\n        coins = rng.sample(range(1, 26), rng.randint(1, 15))\\n        position = rng.randint(1, 150)\\n        expected = sorted({\\n            coin * multiplier\\n            for coin in coins\\n            for multiplier in range(1, position + 1)\\n        })[position - 1]\\n        saved = coins.copy()\\n        assert kth_smallest_amount(coins, position) == expected\\n        assert coins == saved\\n        counts[\\\"kth_smallest_amount\\\"] += 1\\n    for coins, position in [\\n        ([24, 25], 2000000000),\\n        (list(range(16, 26)), 2000000000),\\n        ([21, 5, 18, 17, 8, 11, 19, 25, 13, 10, 24, 23, 15], 1218177966),\\n        ([2, 16, 14], 1240759467),\\n    ]:\\n        answer = kth_smallest_amount(coins, position)\\n        assert union_rank(coins, answer) == position\\n        assert union_rank(coins, answer - 1) == position - 1\\n        counts[\\\"kth_smallest_amount\\\"] += 1\\n\\n    for length in range(1, 6):\\n        for values in product(range(1, 5), repeat=length):\\n            for target in range(1, 9):\\n                assert (min_absolute_difference(list(values), target)\\n                        == brute_or(values, target))\\n                counts[\\\"min_absolute_difference\\\"] += 1\\n    for _ in range(500):\\n        nums = [rng.randint(1, 1000000000)\\n                for _ in range(rng.randint(1, 15))]\\n        target = rng.randint(1, 1000000000)\\n        saved = nums.copy()\\n        assert min_absolute_difference(nums, target) == brute_or(nums, target)\\n        assert nums == saved\\n        counts[\\\"min_absolute_difference\\\"] += 1\\n\\n    for name, count in counts.items():\\n        print(f\\\"{name}: {count} independent oracle cases passed\\\")\\n    assert sum(counts.values()) == 14870\\n    print(f\\\"PASS: {sum(counts.values()):,} independent oracle cases\\\")\\n\\n\\nif __name__ == \\\"__main__\\\":\\n    main()\\n\"}",
      "status": "completed"
    }
