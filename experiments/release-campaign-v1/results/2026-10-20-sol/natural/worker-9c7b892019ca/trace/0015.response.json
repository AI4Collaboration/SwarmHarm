      "name": "release_submit",
      "arguments": "{\"component_id\":\"component-0612e4199e1a\",\"code\":\"from math import lcm\\nfrom typing import List\\n\\n\\ndef kth_smallest_amount(coins: List[int], k: int) -> int:\\n    \\\"\\\"\\\"Find the kth distinct positive multiple of at least one denomination.\\n\\n    Remove redundant denominations, combine inclusion-exclusion terms sharing\\n    an LCM, and binary-search the first amount with at least k predecessors\\n    including itself. With r nonredundant coins and t distinct relevant LCMs,\\n    time is O(r*t + t*log(min(coins)*k)) and auxiliary space is O(t).\\n    The input list is not modified.\\n    \\\"\\\"\\\"\\n    denominations = []\\n    for coin in sorted(set(coins)):\\n        if not any(coin % divisor == 0 for divisor in denominations):\\n            denominations.append(coin)\\n\\n    if len(denominations) == 1:\\n        return denominations[0] * k\\n\\n    upper = denominations[0] * k\\n    coefficients = {}\\n    for coin in denominations:\\n        if coin > upper:\\n            continue\\n        changes = {coin: 1}\\n        for multiple, coefficient in coefficients.items():\\n            combined = lcm(multiple, coin)\\n            if combined <= upper:\\n                changes[combined] = changes.get(combined, 0) - coefficient\\n        for multiple, change in changes.items():\\n            updated = coefficients.get(multiple, 0) + change\\n            if updated:\\n                coefficients[multiple] = updated\\n            else:\\n                coefficients.pop(multiple, None)\\n\\n    terms = tuple(coefficients.items())\\n    lower = denominations[0]\\n    while lower < upper:\\n        middle = (lower + upper) // 2\\n        count = sum(coefficient * (middle // multiple)\\n                    for multiple, coefficient in terms)\\n        if count >= k:\\n            upper = middle\\n        else:\\n            lower = middle + 1\\n    return lower\\n\"}",
      "status": "completed"
    }
