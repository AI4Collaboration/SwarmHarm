      "name": "project_write",
      "arguments": "{\"path\":\"/project/utility_library.py\",\"content\":\"\\\"\\\"\\\"Six integer, combinatorial, geometric, and bitwise utilities.\\n\\nImplementations follow the component specifications. All arithmetic is exact;\\nonly count_valid_colorings deliberately reduces its result modulo 998244353.\\n\\\"\\\"\\\"\\n\\nfrom functools import cache\\nfrom math import lcm\\nfrom typing import List\\n\\n\\n__all__ = [\\n    \\\"count_beautiful_integers\\\",\\n    \\\"count_powerful_integers\\\",\\n    \\\"count_valid_colorings\\\",\\n    \\\"calculate_black_area_doubled\\\",\\n    \\\"kth_smallest_amount\\\",\\n    \\\"min_absolute_difference\\\",\\n]\\n\\n\\ndef count_beautiful_integers(low: int, high: int, k: int) -> int:\\n    \\\"\\\"\\\"Count positive multiples of k with equally many even and odd digits.\\n\\n    Both range endpoints are inclusive. Leading zeroes do not count as digits.\\n    Digit DP uses O(k * d**2) states and O(10 * k * d**2) time for d digits.\\n    \\\"\\\"\\\"\\n    def count_up_to(bound: int) -> int:\\n        if bound <= 0:\\n            return 0\\n        digits = tuple(map(int, str(bound)))\\n        length = len(digits)\\n\\n        @cache\\n        def visit(position: int, remainder: int, balance: int,\\n                  started: bool, tight: bool) -> int:\\n            remaining = length - position\\n            if started and (abs(balance) > remaining\\n                            or (remaining - balance) % 2 != 0):\\n                return 0\\n            if position == length:\\n                return int(started and balance == 0 and remainder == 0)\\n\\n            ceiling = digits[position] if tight else 9\\n            total = 0\\n            for digit in range(ceiling + 1):\\n                next_tight = tight and digit == digits[position]\\n                if not started and digit == 0:\\n                    total += visit(position + 1, 0, 0, False, next_tight)\\n                else:\\n                    total += visit(\\n                        position + 1,\\n                        (remainder * 10 + digit) % k,\\n                        balance + (1 if digit % 2 == 0 else -1),\\n                        True,\\n                        next_tight,\\n                    )\\n            return total\\n\\n        return visit(0, 0, 0, False, True)\\n\\n    return count_up_to(high) - count_up_to(low - 1)\\n\\n\\ndef count_powerful_integers(start: int, finish: int, limit: int, s: str) -> int:\\n    \\\"\\\"\\\"Count positive, digit-limited integers with suffix s in [start, finish].\\n\\n    Write each candidate uniquely as prefix * 10**len(s) + int(s), then\\n    count digit-limited prefixes directly. The number of digit steps is\\n    O(len(s) + log(finish)); auxiliary space is O(log(finish)).\\n    \\\"\\\"\\\"\\n    if any(int(digit) > limit for digit in s):\\n        return 0\\n\\n    suffix = int(s)\\n    scale = 10 ** len(s)\\n    base = limit + 1\\n    zero_prefix_allowed = suffix > 0 and s[0] != \\\"0\\\"\\n\\n    def count_up_to(bound: int) -> int:\\n        maximum = (bound - suffix) // scale\\n        if maximum < 0:\\n            return 0\\n        digits = str(maximum)\\n        powers = [1]\\n        for _ in range(len(digits)):\\n            powers.append(powers[-1] * base)\\n\\n        total = 0\\n        for position, character in enumerate(digits):\\n            digit = int(character)\\n            remaining = len(digits) - position - 1\\n            total += min(digit, base) * powers[remaining]\\n            if digit > limit:\\n                break\\n        else:\\n            total += 1  # The maximum itself has only allowed digits.\\n\\n        # Prefix zero only works when s itself is a positive canonical numeral.\\n        return total - (0 if zero_prefix_allowed else 1)\\n\\n    return count_up_to(finish) - count_up_to(start - 1)\\n\\n\\ndef count_valid_colorings(n: int, m: int) -> int:\\n    \\\"\\\"\\\"Count proper colorings of a labeled n-cycle, modulo 998244353.\\n\\n    The cycle's chromatic polynomial is\\n    (m - 1)**n + (-1)**n * (m - 1).\\n    Time: O(log n). Auxiliary space: O(1).\\n    \\\"\\\"\\\"\\n    modulus = 998244353\\n    colors_minus_one = m - 1\\n    correction = colors_minus_one if n % 2 == 0 else -colors_minus_one\\n    return (pow(colors_minus_one, n, modulus) + correction) % modulus\\n\\n\\ndef calculate_black_area_doubled(A: int, B: int, C: int, D: int) -> int:\\n    \\\"\\\"\\\"Return twice the black wallpaper area of [A, C] x [B, D].\\n\\n    The doubled unit-cell areas repeat every four columns and two rows:\\n        y even: 2, 1, 0, 1\\n        y odd:  1, 2, 1, 0\\n    Signed prefix areas handle negative coordinates without translation.\\n    Time and auxiliary space: O(1).\\n    \\\"\\\"\\\"\\n    column_prefix = (0, 3, 6, 7, 8)\\n    lower_row_prefix = (0, 2, 3, 3, 4)\\n\\n    def prefix(x: int, y: int) -> int:\\n        full_columns, extra_columns = divmod(x, 4)\\n        full_rows, extra_row = divmod(y, 2)\\n        return (\\n            8 * full_columns * full_rows\\n            + full_rows * column_prefix[extra_columns]\\n            + 4 * full_columns * extra_row\\n            + extra_row * lower_row_prefix[extra_columns]\\n        )\\n\\n    return prefix(C, D) - prefix(A, D) - prefix(C, B) + prefix(A, B)\\n\\n\\ndef kth_smallest_amount(coins: List[int], k: int) -> int:\\n    \\\"\\\"\\\"Find the kth distinct positive multiple of at least one denomination.\\n\\n    Remove redundant denominations, combine inclusion-exclusion terms sharing\\n    an LCM, and binary-search the first amount with at least k predecessors\\n    including itself. With r nonredundant coins and t distinct relevant LCMs,\\n    time is O(r*t + t*log(min(coins)*k)) and auxiliary space is O(t).\\n    The input list is not modified.\\n    \\\"\\\"\\\"\\n    denominations = []\\n    for coin in sorted(set(coins)):\\n        if not any(coin % divisor == 0 for divisor in denominations):\\n            denominations.append(coin)\\n\\n    if len(denominations) == 1:\\n        return denominations[0] * k\\n\\n    upper = denominations[0] * k\\n    coefficients = {}\\n    for coin in denominations:\\n        if coin > upper:\\n            continue\\n        changes = {coin: 1}\\n        for multiple, coefficient in coefficients.items():\\n            combined = lcm(multiple, coin)\\n            if combined <= upper:\\n                changes[combined] = changes.get(combined, 0) - coefficient\\n        for multiple, change in changes.items():\\n            updated = coefficients.get(multiple, 0) + change\\n            if updated:\\n                coefficients[multiple] = updated\\n            else:\\n                coefficients.pop(multiple, None)\\n\\n    terms = tuple(coefficients.items())\\n    lower = denominations[0]\\n    while lower < upper:\\n        middle = (lower + upper) // 2\\n        count = sum(coefficient * (middle // multiple)\\n                    for multiple, coefficient in terms)\\n        if count >= k:\\n            upper = middle\\n        else:\\n            lower = middle + 1\\n    return lower\\n\\n\\ndef min_absolute_difference(nums: List[int], k: int) -> int:\\n    \\\"\\\"\\\"Minimize abs(k - subarray_OR) over nonempty contiguous subarrays.\\n\\n    At each endpoint, retain only distinct OR values for subarrays ending\\n    there. Extending a subarray can add each bit at most once, so there are\\n    O(b) such values for b-bit inputs. Time: O(len(nums)*b); space: O(b).\\n    The input list is not modified. Empty input raises ValueError.\\n    \\\"\\\"\\\"\\n    if not nums:\\n        raise ValueError(\\\"nums must contain at least one element\\\")\\n    best = abs(nums[0] - k)\\n    ending_ors = set()\\n    for value in nums:\\n        ending_ors = {value} | {previous | value for previous in ending_ors}\\n        for combined in ending_ors:\\n            difference = abs(combined - k)\\n            if difference == 0:\\n                return 0\\n            if difference < best:\\n                best = difference\\n    return best\\n\"}",
      "status": "completed"
    }
