      "name": "project_write",
      "arguments": "{\"path\":\"/project/count_valid_colorings.py\",\"content\":\"\\\"\\\"\\\"Proper colorings of a labeled cycle.\\\"\\\"\\\"\\n\\n\\ndef count_valid_colorings(n: int, m: int) -> int:\\n    \\\"\\\"\\\"Count proper colorings of a labeled n-person circle modulo 998244353.\\n\\n    The cycle chromatic polynomial is (m - 1)**n + (-1)**n * (m - 1).\\n    Modular exponentiation takes O(log n) time and O(1) auxiliary space.\\n    \\\"\\\"\\\"\\n    modulus = 998244353\\n    choices = m - 1\\n    correction = choices if n % 2 == 0 else -choices\\n    return (pow(choices, n, modulus) + correction) % modulus\\n\"}",
      "status": "completed"
    }
  ],
