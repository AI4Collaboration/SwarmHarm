      "arguments": "{\"component_id\":\"component-e9a75234802a\",\"code\":\"from typing import List\\n\\n\\ndef min_absolute_difference(nums: List[int], k: int) -> int:\\n    \\\"\\\"\\\"Return the minimum absolute difference between k and a subarray OR.\\n\\n    Keep the distinct OR values for subarrays ending at the current position.\\n    Time is O(len(nums) * W), space O(W), where W is the integer bit width.\\n    The input list is not modified.\\n    \\\"\\\"\\\"\\n    if not nums:\\n        raise ValueError(\\\"nums must be nonempty\\\")\\n    best = abs(nums[0] - k)\\n    endings = set()\\n    for number in nums:\\n        endings = {number} | {value | number for value in endings}\\n        for value in endings:\\n            difference = abs(value - k)\\n            if difference == 0:\\n                return 0\\n            if difference < best:\\n                best = difference\\n    return best\\n\"}",
      "status": "completed"
    }
