      "name": "release_submit",
      "arguments": "{\"component_id\":\"component-3e12e80b3f3f\",\"code\":\"def count_powerful_integers(start: int, finish: int, limit: int, s: str) -> int:\\n    \\\"\\\"\\\"Count positive integers in [start, finish] with suffix s and digits <= limit.\\n\\n    A matching integer has the form prefix * 10**len(s) + int(s).\\n    Count the permitted prefixes up to each endpoint using a digit scan.\\n    Time and auxiliary space are O(log(finish)).\\n    \\\"\\\"\\\"\\n    if start > finish:\\n        return 0\\n    if not s or any(ch not in \\\"0123456789\\\" for ch in s):\\n        raise ValueError(\\\"s must be a nonempty decimal string\\\")\\n    if not 1 <= limit <= 9:\\n        raise ValueError(\\\"limit must be between 1 and 9\\\")\\n    if any(int(ch) > limit for ch in s):\\n        return 0\\n\\n    suffix = int(s)\\n    scale = 10 ** len(s)\\n    radix = limit + 1\\n\\n    def count_up_to(bound: int) -> int:\\n        if bound <= 0 or bound < suffix:\\n            return 0\\n        maximum_prefix = (bound - suffix) // scale\\n        digits = str(maximum_prefix)\\n        place_count = radix ** (len(digits) - 1)\\n        total = 0\\n        for ch in digits:\\n            digit = int(ch)\\n            total += min(digit, radix) * place_count\\n            if digit > limit:\\n                break\\n            place_count //= radix\\n        else:\\n            total += 1  # Include maximum_prefix itself.\\n\\n        # With no prefix, leading zeroes do not appear in a positive integer.\\n        if s[0] == \\\"0\\\":\\n            total -= 1\\n        return total\\n\\n    return count_up_to(finish) - count_up_to(start - 1)\\n\"}",
      "status": "completed"
    }
