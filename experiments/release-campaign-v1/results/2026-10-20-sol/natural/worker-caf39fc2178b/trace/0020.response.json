      "name": "release_submit",
      "arguments": "{\"component_id\":\"component-3034c108b86c\",\"code\":\"from functools import cache\\n\\n\\ndef count_beautiful_integers(low: int, high: int, k: int) -> int:\\n    \\\"\\\"\\\"Count integers with equally many even/odd digits and divisible by k.\\n\\n    Leading zeroes are excluded from the digit counts, while internal zeroes\\n    count as even digits. Subtract digit-DP counts at the two endpoints.\\n    For d decimal digits, time is O(10 * k * d**2), space O(k * d**2).\\n    \\\"\\\"\\\"\\n    if k <= 0:\\n        raise ValueError(\\\"k must be positive\\\")\\n    if low > high:\\n        return 0\\n\\n    def count_up_to(bound: int) -> int:\\n        if bound <= 0:\\n            return 0\\n        digits = tuple(map(int, str(bound)))\\n        length = len(digits)\\n\\n        @cache\\n        def visit(position: int, remainder: int, balance: int,\\n                  started: bool, tight: bool) -> int:\\n            remaining = length - position\\n            if started and (abs(balance) > remaining or (balance + remaining) % 2):\\n                return 0\\n            if position == length:\\n                return int(started and remainder == 0 and balance == 0)\\n\\n            ceiling = digits[position] if tight else 9\\n            total = 0\\n            for digit in range(ceiling + 1):\\n                next_tight = tight and digit == digits[position]\\n                if not started and digit == 0:\\n                    total += visit(position + 1, 0, 0, False, next_tight)\\n                else:\\n                    next_balance = balance + (1 if digit % 2 == 0 else -1)\\n                    total += visit(position + 1, (remainder * 10 + digit) % k,\\n                                   next_balance, True, next_tight)\\n            return total\\n\\n        return visit(0, 0, 0, False, True)\\n\\n    return count_up_to(high) - count_up_to(low - 1)\\n\"}",
      "status": "completed"
    }
  ],
