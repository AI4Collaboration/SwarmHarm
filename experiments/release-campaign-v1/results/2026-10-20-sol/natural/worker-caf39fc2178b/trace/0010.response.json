      "name": "release_submit",
      "arguments": "{\"component_id\":\"component-8e66ae22178c\",\"code\":\"def calculate_black_area_doubled(A: int, B: int, C: int, D: int) -> int:\\n    \\\"\\\"\\\"Return twice the black area in the integer-bounded rectangle.\\n\\n    Twice the unit-square black areas repeat as rows (2, 1, 0, 1) and\\n    (1, 2, 1, 0), with periods four horizontally and two vertically.\\n    Signed periodic prefix sums handle negative coordinates as well.\\n    Time and auxiliary space are O(1); all calculations use integers.\\n    \\\"\\\"\\\"\\n    prefix = (\\n        (0, 0, 0, 0, 0),\\n        (0, 2, 3, 3, 4),\\n        (0, 3, 6, 7, 8),\\n    )\\n\\n    def area_to(x: int, y: int) -> int:\\n        full_x, remainder_x = divmod(x, 4)\\n        full_y, remainder_y = divmod(y, 2)\\n        return (\\n            8 * full_x * full_y\\n            + full_y * prefix[2][remainder_x]\\n            + full_x * prefix[remainder_y][4]\\n            + prefix[remainder_y][remainder_x]\\n        )\\n\\n    return area_to(C, D) - area_to(A, D) - area_to(C, B) + area_to(A, B)\\n\"}",
      "status": "completed"
    }
  ],
