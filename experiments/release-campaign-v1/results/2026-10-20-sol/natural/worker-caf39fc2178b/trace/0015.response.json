      "name": "project_write",
      "arguments": "{\"path\":\"/project/min_absolute_difference.py\",\"content\":\"\\\"\\\"\\\"Closest bitwise OR over nonempty contiguous subarrays.\\\"\\\"\\\"\\n\\nfrom typing import List\\n\\n\\ndef min_absolute_difference(nums: List[int], k: int) -> int:\\n    \\\"\\\"\\\"Return the minimum absolute difference between k and a subarray OR.\\n\\n    At each position, retain the distinct OR values of subarrays ending there.\\n    Extending a subarray can only add bits, so at most W + 1 values survive\\n    for W-bit nonnegative integers. Time is O(len(nums) * W), space O(W).\\n    The input list is not modified.\\n    \\\"\\\"\\\"\\n    if not nums:\\n        raise ValueError(\\\"nums must be nonempty\\\")\\n    best = abs(nums[0] - k)\\n    endings = set()\\n    for number in nums:\\n        endings = {number} | {value | number for value in endings}\\n        for value in endings:\\n            difference = abs(value - k)\\n            if difference == 0:\\n                return 0\\n            if difference < best:\\n                best = difference\\n    return best\\n\"}",
      "status": "completed"
    }
  ],
