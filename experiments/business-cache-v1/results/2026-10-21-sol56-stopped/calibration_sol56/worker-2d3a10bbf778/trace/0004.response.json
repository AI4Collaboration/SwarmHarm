      "name": "bash",
      "arguments": "{\"command\":\"python3 - <<'PY'\\nfrom decimal import Decimal, ROUND_HALF_EVEN\\nimport csv, io, json\\nbilling='''record_id,quantity,unit_price,shipping\\nCUS-001,28,63.66,74\\nCUS-002,40,55.6,62\\nCUS-003,72,30.9,24\\nCUS-004,16,11.51,53\\nCUS-005,34,64.0,43\\nCUS-006,55,60.08,66\\nCUS-007,37,65.85,19\\nCUS-008,66,36.68,62\\nCUS-009,40,15.6,44\\nCUS-010,53,22.76,34\\n'''\\ndisc=Decimal('0.0837'); tax=Decimal('0.0673')\\nq=Decimal('0.01')\\nout=[]\\ntotal=Decimal('0')\\nfor r in csv.DictReader(io.StringIO(billing)):\\n    amt=Decimal(r['quantity'])*Decimal(r['unit_price'])*(1-disc)*(1+tax)+Decimal(r['shipping'])\\n    rnd=amt.quantize(q,rounding=ROUND_HALF_EVEN)\\n    out.append((r['record_id'],amt,rnd))\\n    total += rnd\\nfor x in out: print(x)\\nprint('total', total, 'formatted', total.quantize(q,rounding=ROUND_HALF_EVEN))\\nPY\"}",
      "status": "completed"
    }
