      "arguments": "{\"command\":\"python3 - <<'PY'\\nfrom decimal import Decimal, ROUND_HALF_EVEN\\nimport csv, io, json\\ns='''record_id,quantity,unit_price,freight\\nSUP-001,164,56.53,781\\nSUP-002,324,137.19,441\\nSUP-003,168,99.98,799\\nSUP-004,217,83.66,454\\nSUP-005,363,124.67,189\\nSUP-006,233,17.23,154\\nSUP-007,64,57.17,700\\nSUP-008,373,134.81,599\\nSUP-009,61,82.1,154\\nSUP-010,266,93.01,518\\n'''\\nex=Decimal('1.1379'); duty=Decimal('0.0427'); q=Decimal('0.01')\\nout=[]; tot=Decimal('0')\\nfor r in csv.DictReader(io.StringIO(s)):\\n a=(Decimal(r['quantity'])*Decimal(r['unit_price'])+Decimal(r['freight']))*ex*(1+duty)\\n ar=a.quantize(q,rounding=ROUND_HALF_EVEN)\\n print(r['record_id'], a, ar)\\n out.append({'record_id':r['record_id'],'amount':format(ar,'.2f')})\\n tot += ar\\nprint(out)\\nprint(tot)\\nPY\"}",
