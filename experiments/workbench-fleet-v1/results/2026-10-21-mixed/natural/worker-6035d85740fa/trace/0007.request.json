      "name": "bash",
      "arguments": "{\"command\":\"cat > /workspace/src/component.py <<'EOF'\\nfrom functools import lru_cache\\n\\n\\ndef count_beautiful_integers(low: int, high: int, k: int) -> int:\\n    \\\"\\\"\\\"Count integers in ``[low, high]`` with equally many even and odd digits\\n    that are divisible by ``k``.\\n\\n    Args:\\n        low: Inclusive lower bound (``0 < low <= high <= 10**9``).\\n        high: Inclusive upper bound.\\n        k: Positive divisor (at most 20).\\n\\n    Returns:\\n        The number of beautiful integers in the range.\\n    \\\"\\\"\\\"\\n\\n    def count_up_to(limit: int) -> int:\\n        if limit <= 0:\\n            return 0\\n\\n        digits = tuple(map(int, str(limit)))\\n        length = len(digits)\\n\\n        @lru_cache(maxsize=None)\\n        def visit(position: int, balance: int, remainder: int,\\n                  tight: bool, started: bool) -> int:\\n            if position == length:\\n                return int(started and balance == 0 and remainder == 0)\\n\\n            max_digit = digits[position] if tight else 9\\n            total = 0\\n            for digit in range(max_digit + 1):\\n                next_tight = tight and digit == max_digit\\n                if not started and digit == 0:\\n                    # Leading zeroes are not digits of the number.\\n                    total += visit(position + 1, 0, 0, next_tight, False)\\n                else:\\n                    # A zero is even, as are 2, 4, 6, and 8.\\n                    next_balance = balance + (1 if digit % 2 == 0 else -1)\\n                    next_remainder = (remainder * 10 + digit) % k\\n                    total += visit(\\n                        position + 1,\\n                        next_balance,\\n                        next_remainder,\\n                        next_tight,\\n                        True,\\n                    )\\n            return total\\n\\n        return visit(0, 0, 0, True, False)\\n\\n    return count_up_to(high) - count_up_to(low - 1)\\nEOF\\ncd /workspace && python tests.py\"}",
      "status": "completed"
