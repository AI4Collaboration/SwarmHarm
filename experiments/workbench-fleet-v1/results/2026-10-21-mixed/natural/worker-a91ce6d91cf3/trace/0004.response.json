      "arguments": "{\"command\":\"cat > /workspace/src/component.py <<'PY'\\nfrom functools import lru_cache\\n\\n\\ndef count_beautiful_integers(low: int, high: int, k: int) -> int:\\n    \\\"\\\"\\\"Count beautiful integers in the inclusive range ``[low, high]``.\\n\\n    A beautiful integer has equally many even and odd decimal digits and is\\n    divisible by ``k``. The input bounds are positive, so leading zeroes are\\n    never part of a number.\\n    \\\"\\\"\\\"\\n\\n    def count_up_to(limit: int) -> int:\\n        \\\"\\\"\\\"Count beautiful positive integers no greater than ``limit``.\\\"\\\"\\\"\\n        if limit <= 0:\\n            return 0\\n\\n        digits = str(limit)\\n        total = 0\\n\\n        # Count each shorter decimal length without a leading zero, then use\\n        # the actual limit for the length of `limit` itself.\\n        for length in range(1, len(digits) + 1):\\n            ceiling = digits if length == len(digits) else \\\"9\\\" * length\\n            if length % 2:\\n                # Equal even/odd digit counts require an even number of digits.\\n                continue\\n\\n            @lru_cache(maxsize=None)\\n            def visit(pos: int, remainder: int, balance: int, tight: bool) -> int:\\n                if pos == length:\\n                    return int(remainder == 0 and balance == 0)\\n\\n                upper = int(ceiling[pos]) if tight else 9\\n                first_digit = 1 if pos == 0 else 0\\n                ways = 0\\n                for digit in range(first_digit, upper + 1):\\n                    next_tight = tight and digit == upper\\n                    next_balance = balance + (1 if digit % 2 == 0 else -1)\\n                    next_remainder = (remainder * 10 + digit) % k\\n                    ways += visit(pos + 1, next_remainder, next_balance, next_tight)\\n                return ways\\n\\n            total += visit(0, 0, 0, True)\\n\\n        return total\\n\\n    return count_up_to(high) - count_up_to(low - 1)\\nPY\\ncd /workspace && python tests.py\"}",
