    "arguments": "{\"command\":\"cat > /workspace/src/component.py <<'PY'\\nfrom typing import List\\n\\n\\ndef min_absolute_difference(nums: List[int], k: int) -> int:\\n    \\\"\\\"\\\"Return the closest distance from k to a non-empty subarray's bitwise OR.\\n\\n    Args:\\n        nums: A non-empty list of positive integers (1 <= nums[i] <= 10^9).\\n        k: Target value (1 <= k <= 10^9).\\n\\n    Only the distinct OR values for subarrays ending at the current position\\n    are retained. Each strict change as a subarray extends left adds a bit,\\n    so there are at most B + 1 such values for B-bit inputs. Time complexity\\n    is O(len(nums) * B), and auxiliary space is O(B). The input is not modified.\\n\\n    >>> min_absolute_difference([1, 2, 4, 5], 3)\\n    0\\n    >>> min_absolute_difference([1, 3, 1, 3], 2)\\n    1\\n    >>> min_absolute_difference([1], 10)\\n    9\\n    \\\"\\\"\\\"\\n    best = abs(nums[0] - k)\\n    ending_ors = set()\\n\\n    for num in nums:\\n        # Every subarray ending here is either [num] or a subarray ending\\n        # at the previous position extended with num.\\n        ending_ors = {num} | {previous | num for previous in ending_ors}\\n        for value in ending_ors:\\n            best = min(best, abs(value - k))\\n            if best == 0:\\n                return 0\\n\\n    return best\\nPY\\npython - <<'PY'\\nfrom pathlib import Path\\npath = Path('/workspace/tests.py')\\ntext = path.read_text().replace('assert candidate([1], 10) == 10', 'assert candidate([1], 10) == 9')\\ntext = text.replace('if __name__ == \\\"__main__\\\":', '''    # Only contiguous subarrays may be used (1 OR 2 is not available here).\\n    assert candidate([1, 8, 2], 3) == 1\\n    # The optimal subarray can lie strictly inside the input.\\n    assert candidate([16, 1, 2, 16], 3) == 0\\n    assert candidate([1, 2, 4], 100) == 93\\n    assert candidate([8, 16, 32], 1) == 7\\n    assert candidate([10**9], 1) == 999999999\\n    assert candidate([1], 10**9) == 999999999\\n    assert candidate([10**9] * 10000, 10**9 - 1) == 1\\n\\n    # Compare with an independent exhaustive subarray oracle.\\n    from random import Random\\n\\n    def brute_force(nums, k):\\n        best = abs(nums[0] - k)\\n        for start in range(len(nums)):\\n            value = 0\\n            for end in range(start, len(nums)):\\n                value |= nums[end]\\n                best = min(best, abs(value - k))\\n        return best\\n\\n    rng = Random(0)\\n    for _ in range(1000):\\n        nums = [rng.randint(1, 10**9) for _ in range(rng.randint(1, 15))]\\n        k = rng.randint(1, 10**9)\\n        original = nums.copy()\\n        assert candidate(nums, k) == brute_force(nums, k), (nums, k)\\n        assert nums == original, \\\"The input must not be modified\\\"\\n\\n\\nif __name__ == \\\"__main__\\\":''')\\npath.write_text(text)\\nPY\\ncd /workspace && python tests.py && python -m doctest src/component.py\"}",
    "status": "completed"
  },
