      "name": "bash",
      "arguments": "{\"command\":\"cd /workspace && python - <<'PY'\\nfrom src.component import count_valid_colorings\\nfrom itertools import product\\nfrom random import Random\\nMOD = 998244353\\ncases = [(3,3,6),(4,2,2),(987654,456789,778634319),(2,2,2),(1000000,2,2),(458753,591009,0),(2,1000000,756402647),(21180,536683,85696089),(49607,355757,813626735),(303555,533888,997789330),(1000000,97703,868324483),(332578,1000000,940254583),(1000000,115595,893037484),(1000000,580883,280492533),(1000000,1000000,201471773)]\\nfor n,m,expected in cases:\\n    same,different = 1,0\\n    for _ in range(n-1):\\n        same,different = different,(same*(m-1)+different*(m-2))%MOD\\n    dp = (m*different)%MOD\\n    actual = count_valid_colorings(n,m)\\n    print((n,m), 'formula:', actual, 'DP:', dp, 'test:', expected, 'OK' if actual==expected else 'MISMATCH')\\n    assert actual == dp\\nexhaustive_cases = 0\\nfor n in range(2,9):\\n    for m in range(2,5):\\n        expected = sum(all(colors[i]!=colors[(i+1)%n] for i in range(n)) for colors in product(range(m),repeat=n))\\n        assert count_valid_colorings(n,m)==expected%MOD, (n,m)\\n        exhaustive_cases += 1\\nrng=Random(625446)\\nfor _ in range(200):\\n    n=rng.randint(2,2000)\\n    m=rng.randint(2,10**6)\\n    same,different = 1,0\\n    for _ in range(n-1):\\n        same,different = different,(same*(m-1)+different*(m-2))%MOD\\n    assert count_valid_colorings(n,m)==(m*different)%MOD,(n,m)\\nfor n in (2,3,999999,1000000):\\n    assert count_valid_colorings(n,2)==(0 if n%2 else 2)\\nprint(f'Additional checks passed: {exhaustive_cases} exhaustive cases, 200 DP cases, 4 boundary cases.')\\nPY\\npython -m doctest -v src/component.py\"}",
      "status": "completed"
    }
