      "name": "bash",
      "arguments": "{\"command\":\"cat > /workspace/src/component.py <<'EOF'\\nMOD = 998244353\\n\\n\\ndef count_valid_colorings(n: int, m: int) -> int:\\n    \\\"\\\"\\\"Count proper colorings of a cycle with ``n`` people and ``m`` colors.\\n\\n    The count is returned modulo 998244353. The chromatic polynomial of a\\n    cycle is ``(m - 1)**n + (-1)**n * (m - 1)``. This also handles ``n == 2``:\\n    the cycle then has the single adjacency edge between its two people.\\n\\n    Args:\\n        n: Number of people in the circle (2 <= n <= 10^6).\\n        m: Number of available colors (2 <= m <= 10^6).\\n\\n    Returns:\\n        The number of valid assignments modulo 998244353.\\n    \\\"\\\"\\\"\\n    x = (m - 1) % MOD\\n    return (pow(x, n, MOD) + (x if n % 2 == 0 else -x)) % MOD\\nEOF\\ncd /workspace && python tests.py\"}",
      "status": "completed"
    }
