      "name": "bash",
      "arguments": "{\"command\":\"cd /workspace && python - <<'PY'\\nfrom src.component import count_powerful_integers\\nfor l in range(1,10):\\n for s in ['1','0','2','12','03','101']:\\n  # s '03' is allowed suffix literal; own routine handles it if digit valid\\n  for a,b in [(1,200),(10,999),(43,777),(1000,1234)]:\\n   want=sum(str(x).endswith(s) and all(int(c)<=l for c in str(x)) for x in range(a,b+1))\\n   got=count_powerful_integers(a,b,l,s)\\n   if got!=want: print('BAD',l,s,a,b,got,want); raise SystemExit\\nprint('Random-style brute comparisons passed.')\\nPY\"}",
