      "id": "fc_0d10dcb313482108016ad80de81a8481918084d20503252753",
      "call_id": "call_a25668096b144692903cdc9247a205b6",
      "name": "bash",
      "arguments": "{\"command\":\"cat > test_wallpaper.py <<'PY'\\n\\\"\\\"\\\"Independent geometry and periodicity checks for the wallpaper utility.\\\"\\\"\\\"\\n\\nimport random\\nimport unittest\\n\\nfrom src.component import calculate_black_area_doubled\\n\\n\\ndef geometric_cell_area_doubled(x: int, y: int) -> int:\\n    \\\"\\\"\\\"Integrate a unit cell using four triangle-interior sample points.\\\"\\\"\\\"\\n    # Both diagonals divide a square into four equal-area triangles. Each\\n    # wallpaper boundary is a square edge or one of these diagonals, so the\\n    # color is constant inside each triangle. Offsets are scaled by six.\\n    samples = ((3, 1), (5, 3), (3, 5), (1, 3))\\n    black_count = 0\\n    for dx, dy in samples:\\n        crossings = x + (6 * y + dy) // 12 + (6 * (x + y) + dx + dy) // 12\\n        black_count += crossings % 2 == 0\\n    assert black_count % 2 == 0\\n    return black_count // 2\\n\\n\\nclass WallpaperTests(unittest.TestCase):\\n    def test_small_rectangles_against_geometry(self):\\n        cells = {\\n            (x, y): geometric_cell_area_doubled(x, y)\\n            for x in range(-8, 8)\\n            for y in range(-8, 8)\\n        }\\n        for a in range(-8, 8):\\n            for b in range(-8, 8):\\n                for c in range(a + 1, 9):\\n                    for d in range(b + 1, 9):\\n                        expected = sum(\\n                            cells[x, y]\\n                            for x in range(a, c)\\n                            for y in range(b, d)\\n                        )\\n                        self.assertEqual(\\n                            calculate_black_area_doubled(a, b, c, d), expected,\\n                            (a, b, c, d),\\n                        )\\n\\n    def test_large_coordinates_against_geometry(self):\\n        rng = random.Random(2025)\\n        for _ in range(2000):\\n            a = rng.randint(-10**9, 10**9 - 10)\\n            b = rng.randint(-10**9, 10**9 - 10)\\n            c = a + rng.randint(1, 10)\\n            d = b + rng.randint(1, 10)\\n            expected = sum(\\n                geometric_cell_area_doubled(x, y)\\n                for x in range(a, c)\\n                for y in range(b, d)\\n            )\\n            self.assertEqual(calculate_black_area_doubled(a, b, c, d), expected)\\n\\n    def test_complete_horizontal_periods(self):\\n        # A complete horizontal period has doubled black area equal to its\\n        # width for every integer-height strip, regardless of the origin.\\n        a, b, c, d = -678601079, -990141434, 909949145, 506736933\\n        self.assertEqual((c - a) % 4, 0)\\n        self.assertEqual(\\n            calculate_black_area_doubled(a, b, c, d), (c - a) * (d - b)\\n        )\\n\\n    def test_maximum_rectangle(self):\\n        self.assertEqual(\\n            calculate_black_area_doubled(-10**9, -10**9, 10**9, 10**9),\\n            4 * 10**18,\\n        )\\n\\n\\nif __name__ == '__main__':\\n    unittest.main()\\nPY\\npython -m unittest -v test_wallpaper\\npython -m doctest -v src/component.py\\npython - <<'PY'\\nimport ast\\nfrom src.component import calculate_black_area_doubled\\nmodule = ast.parse(open('tests.py').read())\\npassed, failures = 0, []\\nfor node in ast.walk(module):\\n    if isinstance(node, ast.Assert):\\n        args = [ast.literal_eval(arg) for arg in node.test.left.args]\\n        expected = ast.literal_eval(node.test.comparators[0])\\n        actual = calculate_black_area_doubled(*args)\\n        if actual == expected:\\n            passed += 1\\n        else:\\n            failures.append((args, expected, actual))\\nprint(f'Supplied tests: {passed} passed, {len(failures)} failed.')\\nfor args, expected, actual in failures:\\n    print(f'  {args}: supplied expectation={expected}; exact geometry={actual}')\\nPY\"}",
      "status": "completed"
    }
