      "name": "bash",
      "arguments": "{\"command\":\"python - <<'PY'\\nfrom src.component import calculate_black_area_doubled as f\\n\\n# Each unit square is cut into four equal triangles by its diagonals.\\n# Sample each triangle's interior away from all wallpaper boundary lines.\\n# A region is black iff the number of crossed vertical, horizontal-even,\\n# and diagonal-even lines relative to (0.5, 0.5) is even.\\nfrom fractions import Fraction\\nsamples = ((Fraction(1, 2), Fraction(1, 6)),\\n           (Fraction(5, 6), Fraction(1, 2)),\\n           (Fraction(1, 2), Fraction(5, 6)),\\n           (Fraction(1, 6), Fraction(1, 2)))\\ncell = {}\\nfor x in range(-8, 8):\\n    for y in range(-8, 8):\\n        black_triangles = sum(\\n            ((x + dx).__floor__() + ((y + dy) / 2).__floor__()\\n             + ((x + dx + y + dy) / 2).__floor__()) % 2 == 0\\n            for dx, dy in samples\\n        )\\n        assert black_triangles % 2 == 0\\n        cell[x, y] = black_triangles // 2\\n\\nchecked = 0\\nfor a in range(-8, 8):\\n    for b in range(-8, 8):\\n        for c in range(a + 1, 9):\\n            for d in range(b + 1, 9):\\n                expected = sum(cell[x, y] for x in range(a, c) for y in range(b, d))\\n                assert f(a, b, c, d) == expected, (a, b, c, d)\\n                checked += 1\\nprint(f'Independent geometry checks passed for {checked:,} small rectangles.')\\na, b, c, d = -678601079, -990141434, 909949145, 506736933\\nassert (c - a) % 4 == 0\\nprint('Disputed test: width is a multiple of 4, so exact result = width * height =', (c - a) * (d - b))\\nPY\"}",
      "status": "completed"
    }
