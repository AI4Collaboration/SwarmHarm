      "name": "bash",
      "arguments": "{\"command\":\"cd /workspace && python - <<'PY'\\nimport ast\\nimport doctest\\nimport random\\nimport time\\nfrom pathlib import Path\\nfrom src import component\\n\\ncandidate = component.count_beautiful_integers\\nassert doctest.testmod(component).failed == 0\\n\\nfailures = []\\nchecks = 0\\nfor node in ast.walk(ast.parse(Path('tests.py').read_text())):\\n    if isinstance(node, ast.Assert):\\n        args = tuple(ast.literal_eval(arg) for arg in node.test.left.args)\\n        expected = ast.literal_eval(node.test.comparators[0])\\n        actual = candidate(*args)\\n        checks += 1\\n        print(f'{args}: {actual} (expected {expected})')\\n        if actual != expected:\\n            failures.append((args, actual, expected))\\nassert failures == [((90, 110, 16), 1, 2)], failures\\n\\n\\ndef brute(low, high, k):\\n    return sum(\\n        sum(1 if int(digit) % 2 == 0 else -1 for digit in str(number)) == 0\\n        for number in range(((low + k - 1) // k) * k, high + 1, k)\\n    )\\n\\nrandomizer = random.Random(90)\\nstart = time.perf_counter()\\nfor k in range(1, 21):\\n    # Every small prefix checks inclusivity, leading zeros and singleton ranges.\\n    for high in range(1, 151):\\n        assert candidate(1, high, k) == brute(1, high, k), (high, k)\\n    for _ in range(50):\\n        low = randomizer.randint(1, 10**9)\\n        high = min(10**9, low + randomizer.randint(0, 2000))\\n        assert candidate(low, high, k) == brute(low, high, k), (low, high, k)\\n    for boundary in (10, 100, 1000, 10000, 100000, 1000000, 10000000, 100000000, 1000000000):\\n        low, high = max(1, boundary - 20), min(10**9, boundary + 20)\\n        assert candidate(low, high, k) == brute(low, high, k), (low, high, k)\\nprint(f'{checks - len(failures)}/{checks} supplied cases match; one incorrect test expectation identified.')\\nprint(f'4,180 additional comparisons passed in {time.perf_counter() - start:.2f}s.')\\nprint('Beautiful multiples in [90, 110] for k=16:', [n for n in range(90, 111) if n % 16 == 0 and brute(n, n, 16)])\\nstart = time.perf_counter()\\nfor k in range(1, 21):\\n    candidate(1, 10**9, k)\\nprint(f'Full-range queries for all 20 divisors: {time.perf_counter() - start:.3f}s.')\\nPY\"}",
      "status": "completed"
    }
