      "name": "bash",
      "arguments": "{\"command\":\"cat > /workspace/src/component.py <<'PY'\\nfrom math import gcd\\nfrom typing import List\\n\\n\\ndef kth_smallest_amount(coins: List[int], k: int) -> int:\\n    \\\"\\\"\\\"Return the k-th positive integer divisible by at least one denomination.\\n\\n    Each denomination contributes its positive multiples, and amounts that are\\n    multiples of more than one denomination are counted only once. The count of\\n    such amounts up to a limit is computed with inclusion-exclusion, then a\\n    binary search finds the first limit whose count is at least ``k``.\\n\\n    Args:\\n        coins: Distinct positive coin denominations.\\n        k: The 1-based position to find.\\n\\n    Returns:\\n        The k-th smallest amount in the union of the denominations' multiples.\\n    \\\"\\\"\\\"\\n    if not coins:\\n        raise ValueError(\\\"coins must contain at least one denomination\\\")\\n    if k < 1:\\n        raise ValueError(\\\"k must be positive\\\")\\n\\n    # If a denomination is a multiple of another, all of its multiples are\\n    # already included in the other denomination's sequence.\\n    denominations = sorted(set(coins))\\n    useful_coins = [\\n        coin for coin in denominations\\n        if not any(coin != other and coin % other == 0 for other in denominations)\\n    ]\\n\\n    # The k-th multiple of the smallest denomination is always an upper bound.\\n    low = 1\\n    high = useful_coins[0] * k\\n\\n    # Precompute the LCM for each nonempty subset for inclusion-exclusion.\\n    # LCMs greater than high contribute zero throughout the binary search.\\n    subset_lcms = []\\n    n = len(useful_coins)\\n    for mask in range(1, 1 << n):\\n        bit = mask & -mask\\n        index = bit.bit_length() - 1\\n        previous_mask = mask ^ bit\\n        if previous_mask:\\n            previous_lcm = subset_lcms[previous_mask - 1]\\n            coin = useful_coins[index]\\n            subset_lcm = previous_lcm // gcd(previous_lcm, coin) * coin\\n        else:\\n            subset_lcm = useful_coins[index]\\n        subset_lcms.append(subset_lcm)\\n\\n    subset_terms = [\\n        (subset_lcms[mask - 1], 1 if mask.bit_count() % 2 else -1)\\n        for mask in range(1, 1 << n)\\n        if subset_lcms[mask - 1] <= high\\n    ]\\n\\n    def count_at_most(limit: int) -> int:\\n        return sum(sign * (limit // subset_lcm) for subset_lcm, sign in subset_terms)\\n\\n    while low < high:\\n        middle = (low + high) // 2\\n        if count_at_most(middle) >= k:\\n            high = middle\\n        else:\\n            low = middle + 1\\n    return low\\nPY\\ncd /workspace && python tests.py\"}",
