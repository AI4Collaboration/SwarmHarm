      "name": "bash",
      "arguments": "{\"command\":\"cat > /workspace/test_geometry.py <<'PY'\\n\\\"\\\"\\\"Independent checks against the wallpaper's line-crossing color rule.\\\"\\\"\\\"\\n\\nimport unittest\\n\\nfrom src.component import calculate_black_area_doubled\\n\\n\\ndef cell_area_doubled(x: int, y: int) -> int:\\n    \\\"\\\"\\\"Sum the colors of the two half-cell triangles using exact arithmetic.\\\"\\\"\\\"\\n    black_triangles = 0\\n    for offset in (1, 3):\\n        # Points (x + 1/4, y + 1/4) and (x + 3/4, y + 3/4)\\n        # sample both sides of any diagonal through the unit cell.\\n        x4, y4 = 4 * x + offset, 4 * y + offset\\n        crossings = x4 // 4 + y4 // 8 + (x4 + y4) // 8\\n        black_triangles += crossings % 2 == 0\\n    return black_triangles\\n\\n\\nclass WallpaperGeometryTests(unittest.TestCase):\\n    def test_small_rectangles_against_geometry(self):\\n        for a in range(-6, 6):\\n            for c in range(a + 1, 7):\\n                for b in range(-6, 6):\\n                    for d in range(b + 1, 7):\\n                        expected = sum(\\n                            cell_area_doubled(x, y)\\n                            for x in range(a, c)\\n                            for y in range(b, d)\\n                        )\\n                        self.assertEqual(\\n                            calculate_black_area_doubled(a, b, c, d),\\n                            expected,\\n                            (a, b, c, d),\\n                        )\\n\\n    def test_white_cell_below_origin(self):\\n        # There are no dividing lines inside this square; it is wholly white.\\n        self.assertEqual(calculate_black_area_doubled(-1, -1, 0, 0), 0)\\n\\n    def test_coordinate_limits(self):\\n        self.assertEqual(\\n            calculate_black_area_doubled(-10**9, -10**9, 10**9, 10**9),\\n            4 * 10**18,\\n        )\\n        for x in (-10**9, 10**9 - 1):\\n            for y in (-10**9, 10**9 - 1):\\n                self.assertEqual(\\n                    calculate_black_area_doubled(x, y, x + 1, y + 1),\\n                    cell_area_doubled(x, y),\\n                )\\n\\n\\nif __name__ == '__main__':\\n    unittest.main()\\nPY\\ncd /workspace && python -m unittest -v test_geometry && python -m doctest src/component.py\"}",
      "status": "completed"
    }
