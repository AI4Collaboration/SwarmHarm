      "arguments": "{\"command\":\"cd /workspace && python - <<'PY'\\nimport ast\\nfrom src.component import calculate_black_area_doubled\\nmodule = ast.parse(open('tests.py').read())\\npassed = failed = 0\\nfor node in ast.walk(module):\\n    if isinstance(node, ast.Assert):\\n        call = node.test.left\\n        args = tuple(ast.literal_eval(arg) for arg in call.args)\\n        expected = ast.literal_eval(node.test.comparators[0])\\n        actual = calculate_black_area_doubled(*args)\\n        if actual == expected:\\n            passed += 1\\n        else:\\n            failed += 1\\n            print(f'FAIL {args}: expected={expected}, actual={actual}')\\nprint(f'Supplied cases: {passed} passed, {failed} failed.')\\nPY\"}",
