      "name": "bash",
      "arguments": "{\"command\":\"cat > /workspace/src/component.py <<'PY'\\nfrom math import lcm\\nfrom typing import List\\n\\n\\ndef kth_smallest_amount(coins: List[int], k: int) -> int:\\n    \\\"\\\"\\\"Return the k-th smallest positive amount divisible by a coin denomination.\\n\\n    Each denomination contributes its positive multiples to the set of amounts.\\n    An amount divisible by multiple denominations is counted only once.\\n\\n    Args:\\n        coins: Distinct positive coin denominations.\\n        k: 1-based position in the ordered set of possible amounts.\\n\\n    Returns:\\n        The k-th smallest amount that is a multiple of at least one denomination.\\n    \\\"\\\"\\\"\\n    # Inclusion-exclusion computes the size of the union of the sets of\\n    # multiples. Group equal LCMs to reduce work when denominations overlap.\\n    lcm_coefficients = {}\\n    n = len(coins)\\n    for mask in range(1, 1 << n):\\n        common_multiple = 1\\n        bits = 0\\n        for i, coin in enumerate(coins):\\n            if mask & (1 << i):\\n                common_multiple = lcm(common_multiple, coin)\\n                bits += 1\\n        sign = 1 if bits % 2 else -1\\n        lcm_coefficients[common_multiple] = lcm_coefficients.get(common_multiple, 0) + sign\\n\\n    def count_at_most(amount: int) -> int:\\n        return sum(\\n            coefficient * (amount // common_multiple)\\n            for common_multiple, coefficient in lcm_coefficients.items()\\n            if common_multiple <= amount and coefficient\\n        )\\n\\n    # The k-th multiple of the smallest denomination is always an upper bound.\\n    low, high = 1, min(coins) * k\\n    while low < high:\\n        middle = (low + high) // 2\\n        if count_at_most(middle) >= k:\\n            high = middle\\n        else:\\n            low = middle + 1\\n    return low\\nPY\\npython /workspace/tests.py\"}",
