      "name": "bash",
      "arguments": "{\"command\":\"python - <<'PY'\\nfrom pathlib import Path\\npath = Path('/workspace/tests.py')\\ntext = path.read_text()\\nmarker = 'if __name__ == \\\"__main__\\\":\\\\n'\\naddition = '''def check_against_brute_force(candidate):\\n    \\\"\\\"\\\"Independently verify digit balance, divisibility, and range boundaries.\\\"\\\"\\\"\\n    from random import Random\\n\\n    def brute_force(low, high, k):\\n        return sum(\\n            1\\n            for number in range(low, high + 1)\\n            if number % k == 0\\n            and 2 * sum(digit in \\\"02468\\\" for digit in str(number))\\n            == len(str(number))\\n        )\\n\\n    # Include singletons, internal zero digits, and changes in digit length.\\n    ranges = [\\n        (1, 9), (1, 10), (10, 10), (11, 11), (99, 101),\\n        (1001, 1001), (1020, 1020), (9900, 10100),\\n        (12345000, 12345200), (999999990, 1000000000),\\n    ]\\n    for k in range(1, 21):\\n        for low, high in ranges:\\n            assert candidate(low, high, k) == brute_force(low, high, k), (\\n                low, high, k\\n            )\\n\\n    random = Random(0)\\n    for _ in range(200):\\n        digits = random.randint(1, 9)\\n        low = random.randint(10 ** (digits - 1), 10 ** digits - 1)\\n        high = min(10 ** 9, low + random.randint(0, 200))\\n        k = random.randint(1, 20)\\n        assert candidate(low, high, k) == brute_force(low, high, k), (\\n            low, high, k\\n        )\\n\\n\\n'''\\ntext = text.replace(marker, addition + marker)\\ntext = text.replace('    check(count_beautiful_integers)\\\\n',\\n                    '    check(count_beautiful_integers)\\\\n'\\n                    '    check_against_brute_force(count_beautiful_integers)\\\\n')\\npath.write_text(text)\\nPY\\ncd /workspace && time python tests.py && python -m doctest src/component.py && python - <<'PY'\\nfrom time import perf_counter\\nfrom src.component import count_beautiful_integers\\nstart = perf_counter()\\nresults = [count_beautiful_integers(1, 10**9, k) for k in range(1, 21)]\\nprint('Full-bound checks for all 20 divisors: %.3fs' % (perf_counter() - start))\\nassert results[0] == 24894045\\nassert all(0 <= result <= results[0] for result in results)\\nPY\"}",
