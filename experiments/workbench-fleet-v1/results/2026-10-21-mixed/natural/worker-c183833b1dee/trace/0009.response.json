      "name": "bash",
      "arguments": "{\"command\":\"cat > /workspace/tests_geometry.py <<'PY'\\n\\\"\\\"\\\"Independent geometry and property checks; run with python tests_geometry.py.\\\"\\\"\\\"\\n\\nfrom itertools import combinations\\nfrom random import Random\\nimport unittest\\n\\nfrom src.component import calculate_black_area_doubled as area\\n\\n\\ndef geometric_cell(x: int, y: int) -> int:\\n    \\\"\\\"\\\"Count black half-squares using the parity of the defining lines.\\\"\\\"\\\"\\n    doubled_area = 0\\n    # These points sample the two equal-area sides of any diagonal crossing\\n    # the unit square. Coordinates are scaled by four to avoid floats.\\n    for offset in (1, 3):\\n        sx, sy = 4 * x + offset, 4 * y + offset\\n        crossings = sx // 4 + sy // 8 + (sx + sy) // 8\\n        doubled_area += int(crossings % 2 == 0)\\n    return doubled_area\\n\\n\\nclass WallpaperTests(unittest.TestCase):\\n    def test_exhaustive_small_rectangles(self):\\n        for a, c in combinations(range(-8, 9), 2):\\n            for b, d in combinations(range(-6, 7), 2):\\n                expected = sum(\\n                    geometric_cell(x, y)\\n                    for x in range(a, c)\\n                    for y in range(b, d)\\n                )\\n                self.assertEqual(area(a, b, c, d), expected, (a, b, c, d))\\n\\n    def test_large_rectangle_properties(self):\\n        rng = Random(2026)\\n        for _ in range(10000):\\n            a, c = sorted(rng.sample(range(-10**9, 10**9 + 1), 2))\\n            b, d = sorted(rng.sample(range(-10**9, 10**9 + 1), 2))\\n            value = area(a, b, c, d)\\n            self.assertIs(type(value), int)\\n            self.assertLessEqual(0, value)\\n            self.assertLessEqual(value, 2 * (c - a) * (d - b))\\n            # Shift toward the origin so shifted coordinates stay in range.\\n            dx = -4 if a >= -10**9 + 4 else 4\\n            dy = -2 if b >= -10**9 + 2 else 2\\n            if c + dx <= 10**9 and d + dy <= 10**9:\\n                self.assertEqual(value, area(a + dx, b + dy, c + dx, d + dy))\\n            midx, midy = (a + c) // 2, (b + d) // 2\\n            if a < midx < c:\\n                self.assertEqual(value, area(a, b, midx, d) + area(midx, b, c, d))\\n            if b < midy < d:\\n                self.assertEqual(value, area(a, b, c, midy) + area(a, midy, c, d))\\n\\n    def test_maximum_extent(self):\\n        self.assertEqual(\\n            area(-10**9, -10**9, 10**9, 10**9),\\n            4_000_000_000_000_000_000,\\n        )\\n\\n    def test_even_height_fixture_by_row_pairs(self):\\n        # The supplied tests.py expects ...837 for this input. An independent\\n        # count over complete row pairs establishes ...836 instead.\\n        a, b, c, d = -706598544, 47244307, -105634155, 938741675\\n        self.assertEqual(a % 4, 0)\\n        full_tiles, remaining_columns = divmod(c - a, 4)\\n        row_pairs, remaining_rows = divmod(d - b, 2)\\n        self.assertEqual((remaining_columns, remaining_rows), (1, 0))\\n        expected = (8 * full_tiles + 3) * row_pairs\\n        self.assertEqual(expected, 535758171500976836)\\n        self.assertEqual(area(a, b, c, d), expected)\\n\\n\\nif __name__ == '__main__':\\n    unittest.main()\\nPY\\ncd /workspace && python tests_geometry.py && python -m doctest src/component.py && python - <<'PY'\\nimport ast\\nfrom src.component import calculate_black_area_doubled\\n\\npassed = 0\\nfailed = []\\nfor node in ast.walk(ast.parse(open('tests.py').read())):\\n    if isinstance(node, ast.Assert):\\n        args = tuple(ast.literal_eval(arg) for arg in node.test.left.args)\\n        expected = ast.literal_eval(node.test.comparators[0])\\n        actual = calculate_black_area_doubled(*args)\\n        if actual == expected:\\n            passed += 1\\n        else:\\n            failed.append((args, expected, actual))\\nprint(f'Supplied assertions: {passed} passed, {len(failed)} failed.')\\nfor args, expected, actual in failed:\\n    print(f'  {args}: fixture={expected}, actual={actual}')\\nPY\"}",
      "status": "completed"
    }
