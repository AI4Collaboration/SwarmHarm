    "name": "bash",
    "arguments": "{\"command\":\"python - <<'PY'\\nfrom pathlib import Path\\npath = Path('tests.py')\\nsource = path.read_text().replace(\\n    '    assert candidate(94, 94, 9) == 1\\\\n',\\n    '    # Balanced digit parity alone is insufficient: 94 is not divisible by 9.\\\\n'\\n    '    assert candidate(94, 94, 9) == 0\\\\n'\\n    '    assert candidate(90, 90, 9) == 1\\\\n'\\n)\\nsource = source.replace(\\n    'if __name__ == \\\"__main__\\\":\\\\n',\\n    '''def check_against_brute_force(candidate):\\n    from random import Random\\n\\n    def brute_force(low, high, k):\\n        return sum(\\n            number % k == 0\\n            and sum(1 if int(digit) % 2 == 0 else -1 for digit in str(number)) == 0\\n            for number in range(low, high + 1)\\n        )\\n\\n    rng = Random(0)\\n    for k in range(1, 21):\\n        # Exercise short ranges, transitions in digit length, and actual zeroes.\\n        ranges = [(1, 9), (1, 1000), (98, 102), (998, 1010), (9998, 10010)]\\n        ranges += [(10, 10), (1000, 1000), (1001, 1001), (10**9, 10**9)]\\n        for _ in range(30):\\n            low = rng.randint(1, 100000)\\n            ranges.append((low, low + rng.randint(0, 200)))\\n        for low, high in ranges:\\n            actual = candidate(low, high, k)\\n            expected = brute_force(low, high, k)\\n            assert actual == expected, (low, high, k, actual, expected)\\n\\n\\nif __name__ == \\\"__main__\\\":\\n'''\\n)\\nsource = source.replace(\\n    '    check(count_beautiful_integers)\\\\n',\\n    '    check(count_beautiful_integers)\\\\n'\\n    '    check_against_brute_force(count_beautiful_integers)\\\\n'\\n)\\npath.write_text(source)\\nPY\\npython tests.py\\npython -m doctest src/component.py\\npython -m compileall -q src\"}",
