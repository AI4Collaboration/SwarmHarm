      "name": "bash",
      "arguments": "{\"command\":\"cat > /workspace/src/component.py <<'PY'\\nfrom functools import lru_cache\\n\\n\\ndef count_beautiful_integers(low: int, high: int, k: int) -> int:\\n    \\\"\\\"\\\"Count integers in ``[low, high]`` with equally many even and odd digits\\n    that are divisible by ``k``.\\n\\n    Args:\\n        low: Inclusive lower bound (``0 < low <= high <= 10**9``).\\n        high: Inclusive upper bound.\\n        k: Positive divisor (at most 20).\\n\\n    Returns:\\n        The number of beautiful integers in the given range.\\n    \\\"\\\"\\\"\\n\\n    def count_up_to(limit: int) -> int:\\n        if limit <= 0:\\n            return 0\\n\\n        digits = tuple(map(int, str(limit)))\\n        n = len(digits)\\n\\n        @lru_cache(maxsize=None)\\n        def visit(position: int, remainder: int, balance: int,\\n                  started: bool, tight: bool) -> int:\\n            \\\"\\\"\\\"Count completions; balance is even-digit count minus odd-digit count.\\\"\\\"\\\"\\n            if position == n:\\n                return int(started and remainder == 0 and balance == 0)\\n\\n            maximum = digits[position] if tight else 9\\n            total = 0\\n            for digit in range(maximum + 1):\\n                next_tight = tight and digit == maximum\\n                if not started and digit == 0:\\n                    # Leading zeroes are not digits of the represented number.\\n                    total += visit(position + 1, 0, 0, False, next_tight)\\n                else:\\n                    next_balance = balance + (1 if digit % 2 == 0 else -1)\\n                    total += visit(\\n                        position + 1,\\n                        (remainder * 10 + digit) % k,\\n                        next_balance,\\n                        True,\\n                        next_tight,\\n                    )\\n            return total\\n\\n        return visit(0, 0, 0, False, True)\\n\\n    return count_up_to(high) - count_up_to(low - 1)\\nPY\\ncd /workspace && python tests.py\"}",
      "status": "completed"
    }
