      "name": "bash",
      "arguments": "{\"command\":\"cd /workspace && python - <<'PY'\\nfrom src.component import min_absolute_difference\\nfor nums, k, expected in [([1,2,4,5],3,0), ([1,3,1,3],2,1), ([1],10,9), ([1,2,4,8],15,0), ([5,10,15],7,1)]:\\n    result = min_absolute_difference(nums, k)\\n    print(nums, k, result, 'expected', expected)\\n    assert result == expected\\n\\n# Compare against exhaustive enumeration for a range of small inputs.\\nfrom itertools import product\\nfor n in range(1, 6):\\n    for nums in product(range(1, 8), repeat=n):\\n        for k in range(1, 8):\\n            brute = min(abs(k - __import__('functools').reduce(int.__or__, nums[i:j]))\\n                        for i in range(n) for j in range(i + 1, n + 1))\\n            assert min_absolute_difference(list(nums), k) == brute\\nprint('exhaustive checks passed')\\nPY\"}",
