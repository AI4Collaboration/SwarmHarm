    {
      "type": "function_call",
      "id": "fc_0107bebf89703bd0016ad8094fb4788191a2d535a27fe01a7e",
      "call_id": "call_1dd42c01de084aceb7f0b83cb79ab751",
      "name": "bash",
      "arguments": "{\"command\":\"cat > /workspace/test_component_regression.py <<'PY'\\n\\\"\\\"\\\"Independent geometry and invariant checks for the wallpaper utility.\\\"\\\"\\\"\\n\\nimport itertools\\nimport random\\nimport unittest\\n\\nfrom src.component import calculate_black_area_doubled\\n\\n\\ndef geometric_cell_area_doubled(x, y):\\n    \\\"\\\"\\\"Count black half-squares using exact triangle-centroid coordinates.\\n\\n    Away from boundaries, crossing each of x = integer, y = even, or\\n    x + y = even flips the parity of the sum of their floor functions.\\n    The centroids (x + t/3, y + t/3), t = 1, 2, sample the two halves\\n    of a unit square without touching any wallpaper line.\\n    \\\"\\\"\\\"\\n    return sum(\\n        (x + (3 * y + t) // 6 + (3 * (x + y) + 2 * t) // 6) % 2 == 0\\n        for t in (1, 2)\\n    )\\n\\n\\nclass WallpaperTests(unittest.TestCase):\\n    def test_specification_examples(self):\\n        self.assertEqual(calculate_black_area_doubled(0, 0, 3, 3), 10)\\n        self.assertEqual(calculate_black_area_doubled(-1, -2, 1, 3), 11)\\n        self.assertEqual(\\n            calculate_black_area_doubled(-10**9, -10**9, 10**9, 10**9),\\n            4_000_000_000_000_000_000,\\n        )\\n\\n    def test_all_small_rectangles_against_geometry(self):\\n        coordinates = range(-6, 7)\\n        cells = {\\n            (x, y): geometric_cell_area_doubled(x, y)\\n            for x in coordinates\\n            for y in coordinates\\n        }\\n        for a, c in itertools.combinations(coordinates, 2):\\n            for b, d in itertools.combinations(coordinates, 2):\\n                expected = sum(\\n                    cells[x, y] for x in range(a, c) for y in range(b, d)\\n                )\\n                with self.subTest(rectangle=(a, b, c, d)):\\n                    self.assertEqual(\\n                        calculate_black_area_doubled(a, b, c, d), expected\\n                    )\\n\\n    def test_unit_cells_at_coordinate_limits(self):\\n        for x in (-10**9, -10**9 + 1, -1, 0, 1, 10**9 - 2, 10**9 - 1):\\n            for y in (-10**9, -10**9 + 1, -1, 0, 1, 10**9 - 2, 10**9 - 1):\\n                self.assertEqual(\\n                    calculate_black_area_doubled(x, y, x + 1, y + 1),\\n                    geometric_cell_area_doubled(x, y),\\n                )\\n\\n    def test_large_rectangle_invariants(self):\\n        rng = random.Random(6485)\\n        for _ in range(2000):\\n            a, c = sorted(rng.sample(range(-10**8, 10**8), 2))\\n            b, d = sorted(rng.sample(range(-10**8, 10**8), 2))\\n            actual = calculate_black_area_doubled(a, b, c, d)\\n            self.assertIsInstance(actual, int)\\n            self.assertGreaterEqual(actual, 0)\\n            self.assertLessEqual(actual, 2 * (c - a) * (d - b))\\n            dx = 4 * rng.randint(-10**8, 10**8)\\n            dy = 2 * rng.randint(-10**8, 10**8)\\n            self.assertEqual(\\n                calculate_black_area_doubled(a + dx, b + dy, c + dx, d + dy),\\n                actual,\\n            )\\n            if c - a > 1:\\n                x = rng.randrange(a + 1, c)\\n                self.assertEqual(\\n                    calculate_black_area_doubled(a, b, x, d)\\n                    + calculate_black_area_doubled(x, b, c, d),\\n                    actual,\\n                )\\n            if d - b > 1:\\n                y = rng.randrange(b + 1, d)\\n                self.assertEqual(\\n                    calculate_black_area_doubled(a, b, c, y)\\n                    + calculate_black_area_doubled(a, y, c, d),\\n                    actual,\\n                )\\n\\n\\nif __name__ == '__main__':\\n    unittest.main()\\nPY\\ncd /workspace && python -m unittest -v test_component_regression && python -m doctest src/component.py\"}",
      "status": "completed"
    }
  ],
