      "arguments": "{\"command\":\"cd /workspace && python - <<'PY'\\nimport ast\\nfrom src.component import calculate_black_area_doubled\\n\\nmodule = ast.parse(open('tests.py').read())\\npassed = 0\\nfailures = []\\nfor node in ast.walk(module):\\n    if not isinstance(node, ast.Assert):\\n        continue\\n    comparison = node.test\\n    args = tuple(ast.literal_eval(arg) for arg in comparison.left.args)\\n    expected = ast.literal_eval(comparison.comparators[0])\\n    actual = calculate_black_area_doubled(*args)\\n    if actual == expected:\\n        passed += 1\\n    else:\\n        failures.append((node.lineno, args, expected, actual))\\nprint(f'Supplied assertions: {passed} passed, {len(failures)} failed')\\nfor line, args, expected, actual in failures:\\n    print(f'  tests.py:{line}: {args}: expected {expected}, actual {actual}')\\nPY\"}",
