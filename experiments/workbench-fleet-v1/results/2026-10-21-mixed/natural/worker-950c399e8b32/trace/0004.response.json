      "name": "bash",
      "arguments": "{\"command\":\"cat > /workspace/test_count_powerful_integers.py <<'PY'\\n\\\"\\\"\\\"Independent regression tests for the documented powerful-integer rules.\\\"\\\"\\\"\\n\\nimport random\\nimport unittest\\n\\nfrom src.component import count_powerful_integers\\n\\n\\ndef brute_force(start, finish, limit, suffix):\\n    return sum(\\n        str(value).endswith(suffix)\\n        and all(int(digit) <= limit for digit in str(value))\\n        for value in range(max(1, start), finish + 1)\\n    )\\n\\n\\nclass PowerfulIntegerTests(unittest.TestCase):\\n    def test_documented_examples(self):\\n        self.assertEqual(count_powerful_integers(1, 6000, 4, \\\"124\\\"), 5)\\n        self.assertEqual(count_powerful_integers(15, 215, 6, \\\"10\\\"), 2)\\n        self.assertEqual(count_powerful_integers(1000, 2000, 4, \\\"3000\\\"), 0)\\n\\n    def test_boundaries(self):\\n        cases = [\\n            (124, 124, 4, \\\"124\\\", 1),\\n            (125, 1123, 4, \\\"124\\\", 0),\\n            (1124, 1124, 4, \\\"124\\\", 1),\\n            (1, 10**18, 4, \\\"125\\\", 0),\\n            (1, 999, 9, \\\"1000\\\", 0),\\n            (0, 0, 9, \\\"1\\\", 0),\\n            (-100, 11, 1, \\\"1\\\", 2),\\n            (100, 1, 9, \\\"1\\\", 0),\\n            (1, 1001, 1, \\\"001\\\", 1),\\n            (1, 1000, 1, \\\"001\\\", 0),\\n        ]\\n        for start, finish, limit, suffix, expected in cases:\\n            with self.subTest(case=(start, finish, limit, suffix)):\\n                self.assertEqual(\\n                    count_powerful_integers(start, finish, limit, suffix), expected\\n                )\\n\\n    def test_exhaustive_small_upper_bounds(self):\\n        for suffix in (\\\"1\\\", \\\"2\\\", \\\"9\\\", \\\"10\\\", \\\"11\\\", \\\"21\\\", \\\"100\\\", \\\"001\\\"):\\n            for limit in range(1, 10):\\n                expected = 0\\n                for bound in range(501):\\n                    if bound > 0:\\n                        text = str(bound)\\n                        expected += text.endswith(suffix) and all(\\n                            int(digit) <= limit for digit in text\\n                        )\\n                    self.assertEqual(\\n                        count_powerful_integers(1, bound, limit, suffix), expected,\\n                        (bound, limit, suffix),\\n                    )\\n\\n    def test_random_intervals_against_brute_force(self):\\n        randomizer = random.Random(950)\\n        for _ in range(2000):\\n            start = randomizer.randrange(-100, 10000)\\n            finish = start + randomizer.randrange(1000)\\n            limit = randomizer.randrange(1, 10)\\n            suffix = str(randomizer.randrange(1, 1000))\\n            self.assertEqual(\\n                count_powerful_integers(start, finish, limit, suffix),\\n                brute_force(start, finish, limit, suffix),\\n                (start, finish, limit, suffix),\\n            )\\n\\n    def test_large_ranges(self):\\n        self.assertEqual(\\n            count_powerful_integers(1, 10**100 - 1, 1, \\\"11\\\"), 2**98\\n        )\\n        self.assertEqual(\\n            count_powerful_integers(1, 10**100 - 1, 9, \\\"123\\\"), 10**97\\n        )\\n        start, finish, suffix = 987654321012345, 987654321098765, 49\\n        expected = (finish - suffix) // 100 - (start - 1 - suffix) // 100\\n        self.assertEqual(\\n            count_powerful_integers(start, finish, 9, str(suffix)), expected\\n        )\\n\\n\\nif __name__ == \\\"__main__\\\":\\n    unittest.main()\\nPY\\ncd /workspace && python -m unittest -v test_count_powerful_integers && python - <<'PY'\\nimport ast\\nfrom src.component import count_powerful_integers\\n\\nmodule = ast.parse(open('tests.py').read())\\npassed = failed = 0\\nfor node in ast.walk(module):\\n    if isinstance(node, ast.Assert):\\n        comparison = node.test\\n        args = [ast.literal_eval(arg) for arg in comparison.left.args]\\n        expected = ast.literal_eval(comparison.comparators[0])\\n        actual = count_powerful_integers(*args)\\n        if actual != expected:\\n            failed += 1\\n            print(f'Provided test line {node.lineno}: {args}: expected {expected}, actual {actual}')\\n        else:\\n            passed += 1\\nprint(f'Provided assertions: {passed} passed, {failed} failed')\\nPY\"}",
      "status": "completed"
    }
