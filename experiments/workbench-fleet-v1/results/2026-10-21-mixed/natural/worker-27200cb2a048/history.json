    "name": "bash",
    "arguments": "{\"command\":\"cat > /workspace/src/component.py <<'PY'\\nfrom functools import lru_cache\\n\\n\\ndef count_beautiful_integers(low: int, high: int, k: int) -> int:\\n    \\\"\\\"\\\"Count beautiful integers in the inclusive range ``[low, high]``.\\n\\n    A positive integer is beautiful when it is divisible by ``k`` and has\\n    equally many even and odd decimal digits. Zero is an even digit, but\\n    leading zeros are not part of the number.\\n\\n    Args:\\n        low: Lower bound, with ``0 < low <= high <= 10**9``.\\n        high: Upper bound (inclusive).\\n        k: Divisor, with ``0 < k <= 20``.\\n\\n    Returns:\\n        The number of beautiful integers in the range.\\n\\n    >>> count_beautiful_integers(10, 20, 3)\\n    2\\n    >>> count_beautiful_integers(1, 10, 1)\\n    1\\n    >>> count_beautiful_integers(5, 5, 2)\\n    0\\n    \\\"\\\"\\\"\\n\\n    def count_up_to(bound: int) -> int:\\n        if bound <= 0:\\n            return 0\\n\\n        digits = tuple(map(int, str(bound)))\\n        length = len(digits)\\n\\n        @lru_cache(maxsize=None)\\n        def count(\\n            position: int,\\n            balance: int,\\n            remainder: int,\\n            started: bool,\\n            tight: bool,\\n        ) -> int:\\n            # balance is the number of even digits minus the odd digits.\\n            remaining = length - position\\n            if abs(balance) > remaining:\\n                return 0\\n            if position == length:\\n                return int(started and balance == 0 and remainder == 0)\\n\\n            limit = digits[position] if tight else 9\\n            total = 0\\n            for digit in range(limit + 1):\\n                next_tight = tight and digit == limit\\n                if not started and digit == 0:\\n                    # Padding zeros neither affect balance nor represent zero.\\n                    total += count(position + 1, 0, 0, False, next_tight)\\n                else:\\n                    total += count(\\n                        position + 1,\\n                        balance + (1 if digit % 2 == 0 else -1),\\n                        (remainder * 10 + digit) % k,\\n                        True,\\n                        next_tight,\\n                    )\\n            return total\\n\\n        return count(0, 0, 0, False, True)\\n\\n    return count_up_to(high) - count_up_to(low - 1)\\nPY\\npython - <<'PY'\\nfrom pathlib import Path\\npath = Path('/workspace/tests.py')\\ntext = path.read_text().replace(\\n    '    assert candidate(1, 1, 1) == 1',\\n    '    # A single odd digit is not balanced.\\\\n    assert candidate(1, 1, 1) == 0',\\n)\\npath.write_text(text)\\nPY\\ncd /workspace && python tests.py && python -m doctest src/component.py\"}",
