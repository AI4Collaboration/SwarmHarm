      "arguments": "{\"command\":\"python - <<'PY'\\nfrom src.component import count_powerful_integers\\nimport random\\nfor _ in range(10000):\\n    lo=random.randint(-3,300)\\n    hi=random.randint(lo,600)\\n    lim=random.randint(1,9)\\n    s=str(random.randint(1,999))\\n    want=sum(x>=1 and str(x).endswith(s) and all(int(c)<=lim for c in str(x)) for x in range(lo,hi+1))\\n    got=count_powerful_integers(lo,hi,lim,s)\\n    if got!=want:\\n        print('bad',lo,hi,lim,s,want,got);break\\nelse: print('random brute-force comparison passed')\\nPY\"}",
