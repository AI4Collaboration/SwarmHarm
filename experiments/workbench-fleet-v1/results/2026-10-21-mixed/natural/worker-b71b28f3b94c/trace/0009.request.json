      "name": "bash",
      "arguments": "{\"command\":\"cat > /workspace/src/component.py <<'PY'\\nfrom functools import cache\\n\\n\\ndef count_beautiful_integers(low: int, high: int, k: int) -> int:\\n    \\\"\\\"\\\"Count integers in [low, high] with balanced digit parity and divisible by k.\\n\\n    Even and odd digits must occur equally often. Zero is an even digit,\\n    but leading zeros are not part of a number's decimal representation.\\n\\n    Args:\\n        low: Inclusive lower bound, with 0 < low <= high <= 10**9.\\n        high: Inclusive upper bound.\\n        k: Divisor, with 0 < k <= 20.\\n\\n    Returns:\\n        The number of beautiful integers in the range.\\n\\n    >>> count_beautiful_integers(10, 20, 3)\\n    2\\n    >>> count_beautiful_integers(1, 10, 1)\\n    1\\n    >>> count_beautiful_integers(5, 5, 2)\\n    0\\n    \\\"\\\"\\\"\\n    def count_up_to(bound: int) -> int:\\n        if bound <= 0:\\n            return 0\\n\\n        digits = tuple(map(int, str(bound)))\\n        length = len(digits)\\n\\n        @cache\\n        def count(\\n            position: int,\\n            balance: int,\\n            remainder: int,\\n            started: bool,\\n            tight: bool,\\n        ) -> int:\\n            # Balance is the number of even digits minus the number of odd\\n            # digits. Each remaining digit can change it by only one.\\n            remaining = length - position\\n            if abs(balance) > remaining:\\n                return 0\\n            if started and (remaining - balance) % 2:\\n                return 0\\n            if position == length:\\n                return int(started and balance == 0 and remainder == 0)\\n\\n            limit = digits[position] if tight else 9\\n            total = 0\\n            for digit in range(limit + 1):\\n                next_tight = tight and digit == digits[position]\\n                if not started and digit == 0:\\n                    # Skip leading zeros without changing balance or remainder.\\n                    total += count(position + 1, 0, 0, False, next_tight)\\n                else:\\n                    total += count(\\n                        position + 1,\\n                        balance + (1 if digit % 2 == 0 else -1),\\n                        (remainder * 10 + digit) % k,\\n                        True,\\n                        next_tight,\\n                    )\\n            return total\\n\\n        return count(0, 0, 0, False, True)\\n\\n    return count_up_to(high) - count_up_to(low - 1)\\nPY\\ncd /workspace && python tests.py && python -m doctest src/component.py\"}",
      "status": "completed"
    },
