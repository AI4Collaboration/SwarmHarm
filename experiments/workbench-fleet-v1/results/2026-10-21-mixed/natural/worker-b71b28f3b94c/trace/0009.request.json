      "name": "bash",
      "arguments": "{\"command\":\"python - <<'PY'\\nfrom pathlib import Path\\npath = Path('/workspace/tests.py')\\ntext = path.read_text().replace(\\n    '    assert candidate(52, 396, 9) == 6\\\\n',\\n    '    # The qualifying multiples are 54, 63, 72, 81, and 90.\\\\n'\\n    '    assert candidate(52, 396, 9) == 5\\\\n'\\n)\\npath.write_text(text)\\nPY\\ncd /workspace && python tests.py && python -m doctest src/component.py && python - <<'PY'\\nfrom math import comb\\nfrom random import Random\\nfrom time import perf_counter\\nfrom src.component import count_beautiful_integers\\n\\n\\ndef brute(low, high, k):\\n    return sum(\\n        n % k == 0 and sum(int(digit) % 2 for digit in str(n)) * 2 == len(str(n))\\n        for n in range(low, high + 1)\\n    )\\n\\n\\nstart = perf_counter()\\nrng = Random(242)\\nchecked = 0\\nfor k in range(1, 21):\\n    for _ in range(75):\\n        low = rng.randint(1, 10000)\\n        high = low + rng.randint(0, 500)\\n        expected = brute(low, high, k)\\n        actual = count_beautiful_integers(low, high, k)\\n        assert actual == expected, (low, high, k, actual, expected)\\n        checked += 1\\n    for _ in range(25):\\n        low = rng.randint(1, 10**9 - 500)\\n        high = low + rng.randint(0, 500)\\n        expected = brute(low, high, k)\\n        actual = count_beautiful_integers(low, high, k)\\n        assert actual == expected, (low, high, k, actual, expected)\\n        checked += 1\\n    for power in range(1, 10):\\n        boundary = 10**power\\n        low, high = max(1, boundary - 10), min(10**9, boundary + 10)\\n        expected = brute(low, high, k)\\n        actual = count_beautiful_integers(low, high, k)\\n        assert actual == expected, (low, high, k, actual, expected)\\n        checked += 1\\n    for n in (1, 9, 10, 11, 12, 99, 100, 101, 1000, 1001, 100001, 99999999, 100000000, 999999999, 10**9):\\n        assert count_beautiful_integers(n, n, k) == brute(n, n, k), (n, k)\\n        checked += 1\\n\\n# Independent combinatorial oracle for all complete decimal lengths.\\nfor length in range(1, 10):\\n    expected = sum(\\n        9 * comb(n - 1, n // 2) * 5**(n - 1)\\n        for n in range(2, length + 1, 2)\\n    )\\n    assert count_beautiful_integers(1, 10**length - 1, 1) == expected\\n    checked += 1\\n\\nprint(f'{checked} independent cross-checks passed in {perf_counter() - start:.2f}s.')\\nstart = perf_counter()\\nfor k in range(1, 21):\\n    count_beautiful_integers(1, 10**9, k)\\nprint(f'Full-range counts for all 20 divisors completed in {perf_counter() - start:.3f}s.')\\nPY\"}",
