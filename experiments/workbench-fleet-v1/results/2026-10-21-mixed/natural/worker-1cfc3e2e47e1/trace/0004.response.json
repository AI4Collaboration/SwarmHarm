      "name": "bash",
      "arguments": "{\"command\":\"cd /workspace && python -m doctest -v src/component.py && python - <<'PY'\\nfrom itertools import product\\nfrom random import Random\\nfrom time import perf_counter\\nfrom src.component import min_absolute_difference\\n\\n\\ndef brute_force(nums, k):\\n    best = float('inf')\\n    for start in range(len(nums)):\\n        value = 0\\n        for end in range(start, len(nums)):\\n            value |= nums[end]\\n            best = min(best, abs(value - k))\\n    return best\\n\\n\\nchecked = 0\\nfor length in range(1, 6):\\n    for values in product(range(1, 8), repeat=length):\\n        nums = list(values)\\n        for k in range(1, 16):\\n            actual = min_absolute_difference(nums, k)\\n            expected = brute_force(nums, k)\\n            assert actual == expected, (nums, k, actual, expected)\\n            checked += 1\\n\\nrng = Random(118)\\nfor _ in range(3000):\\n    nums = [rng.randint(1, 10**9) for _ in range(rng.randint(1, 40))]\\n    original = nums[:]\\n    k = rng.randint(1, 10**9)\\n    assert min_absolute_difference(nums, k) == brute_force(nums, k)\\n    assert nums == original\\n    checked += 1\\n\\ntry:\\n    min_absolute_difference([], 1)\\nexcept ValueError:\\n    pass\\nelse:\\n    raise AssertionError('Expected ValueError for an empty list')\\n\\n# Repeated powers of two produce many distinct OR values per endpoint.\\nnums = [1 << (i % 30) for i in range(100_000)]\\nstart = perf_counter()\\nassert min_absolute_difference(nums, 10**9) == 6632961\\nprint(f'100,000-element performance case: {perf_counter() - start:.3f}s')\\nprint(f'Brute-force comparison passed for {checked:,} cases; input preservation and empty-input checks passed.')\\nPY\"}",
      "status": "completed"
    }
