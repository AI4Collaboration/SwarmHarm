      "name": "bash",
      "arguments": "{\"command\":\"cat > /workspace/src/component.py <<'PY'\\nfrom typing import List\\n\\n\\nMOD = 998244353\\n\\n\\ndef count_valid_colorings(n: int, m: int) -> int:\\n    \\\"\\\"\\\"Count proper colorings of a cycle, modulo 998244353.\\n\\n    There are ``m`` available colors and each of the ``n`` people must\\n    differ in color from their two neighbors.  The chromatic polynomial of\\n    an n-cycle is ``(m - 1)**n + (-1)**n * (m - 1)``.\\n\\n    Args:\\n        n: Number of people in the circle (2 <= n <= 10^6).\\n        m: Number of available colors (2 <= m <= 10^6).\\n\\n    Returns:\\n        The number of valid assignments modulo 998244353.\\n    \\\"\\\"\\\"\\n    q = m - 1\\n    result = pow(q, n, MOD)\\n    if n % 2 == 0:\\n        result += q\\n    else:\\n        result -= q\\n    return result % MOD\\nPY\\npython /workspace/tests.py\"}",
