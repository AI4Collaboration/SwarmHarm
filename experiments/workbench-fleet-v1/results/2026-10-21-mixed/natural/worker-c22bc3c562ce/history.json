    "name": "bash",
    "arguments": "{\"command\":\"cat > /workspace/src/component.py <<'PY'\\ndef count_valid_colorings(n: int, m: int) -> int:\\n    \\\"\\\"\\\"Count proper colorings of a labeled n-person circle with m colors.\\n\\n    Return the count modulo 998244353. The supported inputs are\\n    2 <= n <= 10**6 and 2 <= m <= 10**6.\\n\\n    The chromatic polynomial of a cycle is\\n    (m - 1)**n + (-1)**n * (m - 1). Modular exponentiation evaluates\\n    this expression in O(log n) time and O(1) auxiliary space.\\n\\n    >>> count_valid_colorings(3, 3)\\n    6\\n    >>> count_valid_colorings(4, 2)\\n    2\\n    >>> count_valid_colorings(987654, 456789)\\n    778634319\\n    \\\"\\\"\\\"\\n    modulus = 998244353\\n    alternatives = m - 1\\n    correction = -alternatives if n % 2 else alternatives\\n    return (pow(alternatives, n, modulus) + correction) % modulus\\nPY\\ncd /workspace && python tests.py\"}",
    "status": "completed"
  },
