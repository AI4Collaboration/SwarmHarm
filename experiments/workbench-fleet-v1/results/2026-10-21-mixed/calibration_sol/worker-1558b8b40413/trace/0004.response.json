      "call_id": "call_0227e0f401b84d349d4872eb66f95431",
      "name": "bash",
      "arguments": "{\"command\":\"cd /workspace && python - <<'PY'\\nfrom math import comb\\nfrom random import Random\\nfrom time import perf_counter\\nfrom src.component import count_beautiful_integers\\n\\n\\ndef is_balanced(n):\\n    digits = str(n)\\n    return sum(int(d) % 2 == 0 for d in digits) * 2 == len(digits)\\n\\n\\ndef brute(low, high, k):\\n    return sum(n % k == 0 and is_balanced(n) for n in range(low, high + 1))\\n\\n\\nchecks = 0\\n# All small prefixes for every supported divisor, including low - 1 == 0.\\nfor k in range(1, 21):\\n    expected = 0\\n    for high in range(1, 301):\\n        expected += high % k == 0 and is_balanced(high)\\n        actual = count_beautiful_integers(1, high, k)\\n        assert actual == expected, (1, high, k, actual, expected)\\n        checks += 1\\n\\n# Random intervals and transitions between digit lengths, plus upper-limit cases.\\nrng = Random(1558)\\nfor k in range(1, 21):\\n    intervals = [(max(1, 10**p - 100), min(10**9, 10**p + 100))\\n                 for p in range(1, 10)]\\n    intervals += [(10**9, 10**9), (10, 10), (1001, 1001),\\n                  (99999999, 99999999)]\\n    for _ in range(30):\\n        low = rng.randint(1, 10**9)\\n        intervals.append((low, min(10**9, low + rng.randint(0, 300))))\\n    for low, high in intervals:\\n        actual = count_beautiful_integers(low, high, k)\\n        expected = brute(low, high, k)\\n        assert actual == expected, (low, high, k, actual, expected)\\n        checks += 1\\n\\n# Independent combinatorial counts for all complete even digit lengths.\\nexpected = 0\\nfor length in (2, 4, 6, 8):\\n    expected += 9 * comb(length - 1, length // 2) * 5 ** (length - 1)\\n    assert count_beautiful_integers(1, 10**length - 1, 1) == expected\\n    checks += 1\\n\\nstart = perf_counter()\\nfor k in range(1, 21):\\n    count_beautiful_integers(1, 10**9, k)\\nprint(f'{checks} independent cross-checks passed.')\\nprint(f'Full-range counts for all 20 divisors: {perf_counter() - start:.3f}s')\\nPY\"}",
      "status": "completed"
    }
  ],
