      "name": "bash",
      "arguments": "{\"command\":\"python - <<'PY'\\nfrom pathlib import Path\\npath = Path('/workspace/tests.py')\\ntext = path.read_text()\\ntext = text.replace('if __name__ == \\\"__main__\\\":', '''def check_extended(candidate):\\n    from random import Random\\n\\n    def brute_force(nums, k):\\n        best = abs(nums[0] - k)\\n        for start in range(len(nums)):\\n            combined = 0\\n            for end in range(start, len(nums)):\\n                combined |= nums[end]\\n                best = min(best, abs(combined - k))\\n        return best\\n\\n    # Non-adjacent elements cannot be combined without the middle element.\\n    assert candidate([1, 8, 2], 3) == 1\\n    assert candidate([8, 8, 8], 1) == 7\\n    assert candidate([1, 2, 4], 20) == 13\\n    assert candidate([10**9], 1) == 999999999\\n    assert candidate([1], 10**9) == 999999999\\n    assert candidate([10**9, 10**9], 10**9) == 0\\n\\n    nums = [1 << bit for bit in range(30)]\\n    original = nums[:]\\n    assert candidate(nums, 10**9) == brute_force(nums, 10**9)\\n    assert nums == original\\n\\n    rng = Random(77)\\n    for bound in (31, 10**9):\\n        for _ in range(1000):\\n            nums = [rng.randint(1, bound) for _ in range(rng.randint(1, 15))]\\n            k = rng.randint(1, bound)\\n            original = nums[:]\\n            assert candidate(nums, k) == brute_force(nums, k), (nums, k)\\n            assert nums == original\\n\\n    try:\\n        candidate([], 1)\\n    except ValueError:\\n        pass\\n    else:\\n        raise AssertionError(\\\"An empty input must raise ValueError\\\")\\n\\n\\nif __name__ == \\\"__main__\\\":''')\\ntext = text.replace('    check(min_absolute_difference)\\\\n', '    check(min_absolute_difference)\\\\n    check_extended(min_absolute_difference)\\\\n')\\npath.write_text(text)\\nPY\\ncd /workspace && python tests.py && python - <<'PY'\\nfrom time import perf_counter\\nfrom src.component import min_absolute_difference\\n\\nnums = [1 << (i % 29) for i in range(100000)]\\nstart = perf_counter()\\nassert min_absolute_difference(nums, 1 << 29) == 1\\nprint(f'100,000-element performance check passed in {perf_counter() - start:.3f}s.')\\nPY\"}",
