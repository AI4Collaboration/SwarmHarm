      "name": "bash",
      "arguments": "{\"command\":\"cat > /workspace/test_kth_smallest_amount.py <<'PY'\\n\\\"\\\"\\\"Independent regression checks for kth_smallest_amount.\\\"\\\"\\\"\\nimport itertools\\nimport math\\nimport random\\nimport unittest\\n\\nfrom src.component import kth_smallest_amount\\n\\n\\ndef brute_force(coins, k):\\n    # The first k multiples of each coin contain the first k union members.\\n    amounts = {coin * multiplier\\n               for coin in coins for multiplier in range(1, k + 1)}\\n    return sorted(amounts)[k - 1]\\n\\n\\ndef reference_count(coins, limit):\\n    # Enumerate every subset directly, independently of the implementation's\\n    # pruning and coefficient aggregation.\\n    count = 0\\n    for size in range(1, len(coins) + 1):\\n        sign = 1 if size % 2 else -1\\n        for subset in itertools.combinations(coins, size):\\n            count += sign * (limit // math.lcm(*subset))\\n    return count\\n\\n\\nclass KthSmallestAmountTests(unittest.TestCase):\\n    def test_exhaustive_small_inputs(self):\\n        for size in range(1, 5):\\n            for coins in itertools.combinations(range(1, 11), size):\\n                for k in (1, 2, 3, 7, 20, 50):\\n                    with self.subTest(coins=coins, k=k):\\n                        self.assertEqual(\\n                            kth_smallest_amount(list(coins), k),\\n                            brute_force(coins, k),\\n                        )\\n\\n    def test_randomized_inputs_and_input_preservation(self):\\n        rng = random.Random(2025)\\n        for _ in range(200):\\n            coins = rng.sample(range(1, 26), rng.randint(1, 15))\\n            original = coins.copy()\\n            k = rng.randint(1, 150)\\n            with self.subTest(coins=coins, k=k):\\n                self.assertEqual(kth_smallest_amount(coins, k),\\n                                 brute_force(coins, k))\\n                self.assertEqual(coins, original)\\n\\n    def test_large_rank_boundaries(self):\\n        rng = random.Random(2026)\\n        cases = [([25], 2_000_000_000),\\n                 ([24, 25], 2_000_000_000),\\n                 (list(range(11, 26)), 2_000_000_000)]\\n        cases += [(rng.sample(range(1, 26), rng.randint(1, 15)),\\n                   rng.randint(1_000_000_000, 2_000_000_000))\\n                  for _ in range(20)]\\n        for coins, k in cases:\\n            with self.subTest(coins=coins, k=k):\\n                result = kth_smallest_amount(coins, k)\\n                self.assertEqual(reference_count(coins, result), k)\\n                self.assertEqual(reference_count(coins, result - 1), k - 1)\\n\\n\\nif __name__ == '__main__':\\n    unittest.main()\\nPY\\ncd /workspace && python tests.py && python -m unittest -v test_kth_smallest_amount && python -m doctest src/component.py\"}",
