      "name": "bash",
      "arguments": "{\"command\":\"cd /workspace && python - <<'PY'\\nimport random\\nfrom src.component import count_powerful_integers\\n\\n\\ndef brute_force(start, finish, limit, suffix):\\n    return sum(\\n        str(value).endswith(suffix)\\n        and all(int(digit) <= limit for digit in str(value))\\n        for value in range(max(start, 1), finish + 1)\\n    )\\n\\n\\nregressions = [\\n    ((124, 124, 4, '124'), 1),\\n    ((123, 123, 4, '124'), 0),\\n    ((125, 1123, 4, '124'), 0),\\n    ((124, 1124, 4, '124'), 2),\\n    ((1, 100000, 3, '124'), 0),\\n    ((1, 100, 9, '1000'), 0),\\n    ((100, 10, 9, '1'), 0),\\n    ((-100, 100, 1, '1'), 2),\\n    ((0, 0, 9, '0'), 0),\\n    ((1, 1001, 9, '001'), 1),\\n    ((1, 100, 9, '00'), 1),\\n    ((1, 10**100, 1, '1'), 2**99),\\n    ((1, 10**100, 1, '11'), 2**98),\\n    ((1, 10**100, 1, '0'), 2**99),\\n    ((1, 10**100, 9, '1'), 10**99),\\n]\\nfor arguments, expected in regressions:\\n    actual = count_powerful_integers(*arguments)\\n    assert actual == expected, (arguments, actual, expected)\\n\\nrng = random.Random(20251021)\\nfor _ in range(10000):\\n    start = rng.randint(-20, 1000)\\n    finish = rng.randint(-20, 1000)\\n    limit = rng.randint(1, 9)\\n    suffix = str(rng.randint(0, 1100))\\n    if rng.random() < 0.15:\\n        suffix = '0' * rng.randint(1, 2) + suffix\\n    arguments = start, finish, limit, suffix\\n    actual = count_powerful_integers(*arguments)\\n    expected = brute_force(*arguments)\\n    assert actual == expected, (arguments, actual, expected)\\n\\nprint(f'{len(regressions)} edge/large-number regressions passed.')\\nprint('10,000 seeded brute-force comparisons passed.')\\nPY\"}",
      "status": "completed"
    }
  ],
