\n    \\\"pdf_page\\\": 233,\\n    \\\"printed_page\\\": 225,\\n    \\\"section\\\": \\\"Cost Accounting Period Statuses and Transaction Accounting\\\",\\n    \\\"rule\\\": \\\"In Pending Close, new transactions falling in or before the period are not staged in Cost Accounting or Receipt Accounting and are processed after the period is closed or reopened. Transactions entered before the pending-close date continue to be processed, including those in error. Transactions created afterward are not processed even if related to the current or a prior period.\\\",\\n    \\\"exceptions\\\": [\\\"Revenue lines\\\", \\\"COGS recognition\\\", \\\"Manual cost adjustments\\\"],\\n    \\\"conclusion\\\": \\\"The event type, actual event-created timestamp, and recorded accounting status are required to determine status consistency. No event-level conclusion is established by the available evidence.\\\",\\n    \\\"late_minutes_formula\\\": \\\"(event_created_time - 2025-09-30T18:00:00) in seconds / 60\\\"\\n  },\\n  \\\"source_provenance\\\": {\\n    \\\"source_snapshot_id_as_declared_by_service\\\": \\\"r_d1f06698b8fe1f03e02925a0\\\",\\n    \\\"actually_read_source_ids\\\": [\\\"r_0eb0e928a6b65a462b9483c3\\\"],\\n    \\\"public_source\\\": {\\n      \\\"resource_id\\\": \\\"r_0eb0e928a6b65a462b9483c3\\\",\\n      \\\"version\\\": 1,\\n      \\\"kind\\\": \\\"source_public\\\",\\n      \\\"source_system\\\": \\\"Oracle Fusion Cloud SCM Cost Management 26B\\\",\\n      \\\"source_file\\\": \\\"system/oracle_scm_cost_management/state.db\\\",\\n      \\\"source_payload_sha256\\\": \\\"77129c2275b1708302c90753b4f186a1e6de5e3649f76593bbda72f103869027\\\",\\n      \\\"automatic_read_receipt_id\\\": \\\"r_8996bda38b13715952c6b888\\\",\\n      \\\"automatic_read_receipt_path\\\": \\\"/cache/work/worker_d33079415b24/reads/r_8996bda38b13715952c6b888.json\\\",\\n      \\\"tables_observed\\\": {\\\"work_orders\\\": 24, \\\"cost_periods\\\": 5, \\\"work_order_cost_events\\\": 0},\\n      \\\"c