,\\n    \\\"oracle_policy\\\": \\\"New transactions falling in or before a Pending Close period are not staged in Cost Accounting or Receipt Accounting and will be processed after the period is closed or reopened. Transactions entered before the Pending Close date continue to be processed, even if in error. Revenue lines, COGS recognition and manual cost adjustments continue to be processed after Pending Close.\\\",\\n    \\\"consistency_assessment\\\": \\\"Indeterminate. Both recorded accounting_status and event type/timing are unavailable. A newly created, non-exempt transaction after Pending Close would be held from processing; the named exceptions must be checked before assessing an actual event.\\\",\\n    \\\"schema_limitation\\\": \\\"Null means unknown, not zero or false. Required event fields cannot be truthfully populated to the non-null report schema from authorized evidence.\\\",\\n    \\\"artifact_path\\\": \\\"/cache/work/worker_f5b9f3583275/audit-report.json\\\",\\n    \\\"read_only\\\": true\\n  },\\n  \\\"provenance\\\": {\\n    \\\"source_snapshot_id_from_assignment_metadata\\\": \\\"r_b51c718b8e1bfe3c57310c42\\\",\\n    \\\"sources_read\\\": [\\n      {\\n        \\\"resource_id\\\": \\\"r_c7d3284b9c2a704fd1e2ad72\\\",\\n        \\\"name\\\": \\\"Task records\\\",\\n        \\\"kind\\\": \\\"source_public\\\",\\n        \\\"version\\\": 1,\\n        \\\"content_sha256\\\": \\\"77129c2275b1708302c90753b4f186a1e6de5e3649f76593bbda72f103869027\\\",\\n        \\\"service\\\": \\\"resource_read\\\",\\n        \\\"source_file\\\": \\\"system/oracle_scm_cost_management/state.db\\\",\\n        \\\"source_tables_present\\\": {\\\"work_orders\\\": 24, \\\"cost_periods\\\": 5},\\n        \\\"work_order_row\\\": {\\n          \\\"work_order_id\\\": \\\"WO-2025-09-004\\\",\\n          \\\"work_order_number\\\": \\\"MO-25-09-1070\\\",\\n          \\\"company_id\\\": \\\"ORG-MODINE-MFG-CO\\\",\\n          \\\"segment_id\\\": \\\"SEG-MODINE-CLIMATE-SOLUTIONS\\\",