T18:00:00 and belonging to September or an earlier period, processing/accounting while Pending Close would not accord with this policy. A held/not-processed status would accord with it. The event type and recorded status are unavailable, so neither assessment is made for a specific transaction.\\\"\\n  },\\n  \\\"provenance\\\": {\\n    \\\"source_ids_used_for_business_findings\\\": [\\\"r_d58b81625900c00cb5b09e34\\\"],\\n    \\\"public_source\\\": {\\n      \\\"resource_id\\\": \\\"r_d58b81625900c00cb5b09e34\\\",\\n      \\\"name\\\": \\\"Task records\\\",\\n      \\\"version\\\": 1,\\n      \\\"kind\\\": \\\"source_public\\\",\\n      \\\"content_sha256\\\": \\\"77129c2275b1708302c90753b4f186a1e6de5e3649f76593bbda72f103869027\\\",\\n      \\\"database_source_file\\\": \\\"system/oracle_scm_cost_management/state.db\\\",\\n      \\\"actual_read\\\": {\\\"service\\\": \\\"resource_read\\\", \\\"status\\\": 200}\\n    },\\n    \\\"queries\\\": [\\n      {\\n        \\\"service\\\": \\\"data_query\\\",\\n        \\\"resource_ids\\\": [\\\"r_d58b81625900c00cb5b09e34\\\"],\\n        \\\"action\\\": \\\"rows\\\",\\n        \\\"table_path\\\": [\\\"records\\\"],\\n        \\\"filters\\\": [{\\\"field\\\": \\\"table\\\", \\\"op\\\": \\\"eq\\\", \\\"value\\\": \\\"work_orders\\\"}, {\\\"field\\\": \\\"values.work_order_number\\\", \\\"op\\\": \\\"eq\\\", \\\"value\\\": \\\"MO-25-09-1070\\\"}],\\n        \\\"result\\\": \\\"Exactly one matching row: WO-2025-09-004, site SITE-US-WI-RACINE-DEKOVEN-1500, cost period PER-COST-2025-09.\\\"\\n      },\\n      {\\n        \\\"service\\\": \\\"data_query\\\",\\n        \\\"resource_ids\\\": [\\\"r_d58b81625900c00cb5b09e34\\\"],\\n        \\\"action\\\": \\\"rows\\\",\\n        \\\"table_path\\\": [\\\"records\\\"],\\n        \\\"filters\\\": [{\\\"field\\\": \\\"table\\\", \\\"op\\\": \\\"eq\\\", \\\"value\\\": \\\"cost_periods\\\"}, {\\\"field\\\": \\\"values.cost_period_id\\\", \\\"op\\\": \\\"eq\\\", \\\"value\\\": \\\"PER-COST-20