ions are not staged or processed until the period is closed or reopened. The documented exceptions for revenue lines, COGS recognition, and manual cost adjustments do not apply to this component issue.\\\",\\n    \\\"policy_reference\\\": \\\"Oracle Fusion Cloud SCM Cost Management 26B, Cost Accounting Period Statuses and Transaction Accounting, printed page 225 (PDF page 233).\\\"\\n  },\\n  \\\"source_provenance\\\": [\\n    {\\n      \\\"resource_id\\\": \\\"r_bb4773c7917c239961e9cd56\\\",\\n      \\\"resource_name\\\": \\\"Task records\\\",\\n      \\\"version\\\": 1,\\n      \\\"access_method\\\": \\\"resource_read\\\",\\n      \\\"content_sha256\\\": \\\"77129c2275b1708302c90753b4f186a1e6de5e3649f76593bbda72f103869027\\\",\\n      \\\"business_source\\\": \\\"system/oracle_scm_cost_management/state.db\\\",\\n      \\\"rows_used\\\": [\\n        {\\\"table\\\": \\\"work_orders\\\", \\\"work_order_id\\\": \\\"WO-2025-09-004\\\", \\\"work_order_number\\\": \\\"MO-25-09-1070\\\", \\\"site_id\\\": \\\"SITE-US-WI-RACINE-DEKOVEN-1500\\\", \\\"cost_period_id\\\": \\\"PER-COST-2025-09\\\"},\\n        {\\\"table\\\": \\\"cost_periods\\\", \\\"cost_period_id\\\": \\\"PER-COST-2025-09\\\", \\\"period_status\\\": \\\"PENDING_CLOSE\\\", \\\"pending_close_timestamp\\\": \\\"2025-09-30T18:00:00\\\", \\\"gl_period_status\\\": \\\"OPEN\\\"}\\n      ],\\n      \\\"policy_source\\\": {\\n        \\\"source_file\\\": \\\"workspace/02_Cost_Accounting/oracle_supply_chain_cost_management_26b.pdf\\\",\\n        \\\"pdf_page\\\": 233,\\n        \\\"printed_page\\\": 225,\\n        \\\"section\\\": \\\"Cost Accounting Period Statuses and Transaction Accounting\\\",\\n        \\\"relevant_text\\\": \\\"When a period is in Pending Close, any new transaction that falls in or before the period won't be staged in Cost Accounting or Receipt Accounting. After the period is closed or reopened, these new transactions will be processed. Transactions created after the pending close date, even if they relate to a current or prior period, won't be processed. Revenue lines, COGS recognition, and manual cost adjustments will continue to be processed even after the period is set to Pending Close.\\\"\\n      }\\n    },\\n    {\\n      \\\"resource_id\\\": \\\"r_08a1077d44e608087fc2124e\\\",\\n      \\\"kind\\\": \\\"source_mirror\\\",\\n      \\\"access_method\\\": \\\"registry_request GET\\\",\\n      \\\"registry_path\\\": \\\"/cache/datasets/finance_accounting/r_d1f3046a8a3fe1af9bbc8caf/records.json\\\",\\n      \\\"registry_listing_job_id\\\": \\\"r_4fa4af514f64a052200ef49e\\\",\\n      \\\"dataset_family\\\": \\\"finance_accounting\\\",\\n      \\\"content_sha256\\\": \\\"3e8b92fb9949eb1f7b543593eac8a520cdb422258859d6db5b4ae3ff6f8ec850\\\",\\n      \\\"business_source\\\": \\\"system/oracle_scm_cost_management/state.db\\\",\\n      \\\"rows_used\\\": [\\n        {\\\"table\\\": \\\"work_order_cost_events\\\", \\\"cost_event_id\\\": \\\"CE-250904-0004\\\", \\\"work_order_id\\\": \\\"WO-2025-09-004\\\", \\\"cost_period_id\\\": \\\"PER-COST-2025-09\\\", \\\"event_type\\\": \\\"INPUT\\\", \\\"event_date\\\": \\\"2025-09-30\\\", \\\"created_timestamp\\\": \\\"2025-09-30T20:25:00\\\", \\\"accounting_attempt\\\": 1, \\\"accounting_status\\\": \\\"POSTED\\\", \\\"amount_cents\\\": 31825075, \\\"source_transaction_id\\\": \\\"TXN-ISSUE-250930-1070\\\", \\\"source_document\\\": \\\"Component issue after pending close\\\", \\\"error_code\\\": null}\\n      ]\\n    }\\n  ],\\n  \\\"service_provenance\\\": [\\n    {\\\"service\\\": \\\"service_describe\\\", \\\"status\\\": 200, \\\"purpose\\\": \\\"Obtained task, schema, workflow and source snapshot identifier.\\\"},\\n    {\\\"service\\\": \\\"resource_list\\\", \\\"status\\\": 200, \\\"purpose\\\": \\\"Identified assigned source records and supporting-record staging state.\\\"},\\n    {\\\"service\\\": \\\"resource_read\\\", \\\"resource_id\\\": \\\"r_bb4773c7917c239961e9cd56\\\", \\\"status\\\": 200},\\n    {\\\"servi