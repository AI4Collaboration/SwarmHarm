rce_file\\\": \\\"workspace/02_Cost_Accounting/oracle_supply_chain_cost_management_26b.pdf\\\",\\n    \\\"pdf_page\\\": 233,\\n    \\\"printed_page\\\": 225,\\n    \\\"section\\\": \\\"Cost Accounting Period Statuses and Transaction Accounting\\\",\\n    \\\"rule\\\": \\\"In Pending Close, new transactions falling in or before the period are not staged in Cost Accounting or Receipt Accounting; they are processed after the period is closed or reopened. Transactions entered before Pending Close continue to be processed, including those in error. Transactions created after Pending Close are not processed even if they relate to a current or prior period.\\\",\\n    \\\"exceptions\\\": [\\\"Revenue lines\\\", \\\"COGS recognition\\\", \\\"Manual cost adjustments\\\"],\\n    \\\"general_application\\\": \\\"A newly created, non-exempt transaction for the current or an earlier period should be held from accounting while the period remains Pending Close. No finding about the actual event or its recorded status is made here.\\\"\\n  },\\n  \\\"unresolved_required_fields\\\": [\\\"source_transaction_id\\\", \\\"amount_cents\\\", \\\"event_created_time\\\", \\\"late_minutes\\\", \\\"accounting_status\\\", \\\"status_consistent\\\"],\\n  \\\"null_semantics\\\": \\\"Null means no reportable analyst-authorized transaction evidence, not zero, no event, or a negative consistency verdict. The required answer schema cannot truthfully be fully populated under the current authorization/staging state.\\\",\\n  \\\"source_ids_for_reported_findings\\\": [\\\"r_93a66ab8e6df7328007a9bb6\\\"],\\n  \\\"provenance\\\": {\\n    \\\"public_source\\\": {\\n      \\\"resource_id\\\": \\\"r_93a66ab8e6df7328007a9bb6\\\",\\n      \\\"version\\\": 1,\\n      \\\"read_service\\\": \\\"resource_read\\\",\\n      \\\"read_status\\\": 200,\\n      \\\"content_sha256\\\": \\\"77129c2275b1708302c90753b4f186a1e6de5e3649f76593bbda72f103869027\\\",\\n      \\\"business_source_file\\\": \\\"system/oracle_scm_co