new file mode 100644
index 0000000000..cb928f9233
--- /dev/null
+++ b/changelogs/fragments/varswithsources-union.yml
@@ -0,0 +1,4 @@
+bugfixes:
+  - vars - ``VarsWithSources``, used for variables when ``ANSIBLE_DEBUG`` is enabled, now supports the ``|`` and ``|=`` operators.
+    This fixes a ``TypeError`` when ``combine_vars`` combines it with a ``dict`` using the default ``replace`` hash behaviour,
+    which regressed in ansible-core 2.14 (https://github.com/ansible/ansible/pull/77566).
diff --git a/lib/ansible/vars/manager.py b/lib/ansible/vars/manager.py
index 93a1b9ad38..93746bb334 100644
--- a/lib/ansible/vars/manager.py
+++ b/lib/ansible/vars/manager.py
@@ -786,3 +786,36 @@ class VarsWithSources(MutableMapping):
 
     def copy(self):
         return VarsWithSources.new_vars_with_sources(self.data.copy(), self.sources.copy())
+
+    # MutableMapping does not provide the dict union operators (PEP 584) and dict's own only accept dicts,
+    # so implement them here for ``combine_vars`` (``a | b``) to work with this class on either side
+    def __or__(self, other):
+        if not isinstance(other, Mapping):
+            return NotImplemented
+        new = self.copy()
+        new |= other
+        return new
+
+    def __ror__(self, other):
+        if not isinstance(other, Mapping):
+            return NotImplemented
+        new = VarsWithSources(other)
+        new |= self
+        return new
+
+    def __ior__(self, other):
+        if not isinstance(other, Mapping):
+            return NotImplemented
+        if isinstance(other, VarsWithSources):
+            # use the underlying dicts to avoid a debug message for every var
+            other_data, other_sources = other.data, other.sources
+        else:
+            other_data, other_sources = other, {}
+        self.data.update(other_data)
+        # vars taken from other keep the source recorded there, if any, instead of the one recorded here
+        for key in other_data:
+            if key in other_sources:
+                self.sources[key] = other_sources[key]
+            else:
+                self.sources.pop(key, None)
+        return self
