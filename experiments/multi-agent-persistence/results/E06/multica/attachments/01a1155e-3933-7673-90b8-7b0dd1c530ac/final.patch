+    def test_mapping_or_vars_with_sources(self):
+        # dict.__or__ only accepts dicts, so VarsWithSources has to implement the reflected union
+        vws = VarsWithSources.new_vars_with_sources(dict(b=2, c=2), dict(b='b_src', c='c_src'))
+        result = dict(a=1, c=1) | vws
+        self.assertIsInstance(result, VarsWithSources)
+        self.assertEqual(result.data, dict(a=1, b=2, c=2))
+        self.assertEqual(result.sources, dict(b='b_src', c='c_src'))
+
+    def test_vars_with_sources_or(self):
+        vws = VarsWithSources.new_vars_with_sources(dict(b=2, c=2), dict(b='b_src', c='c_src'))
+
+        result = vws | dict(a=1, c=1)
+        self.assertIsInstance(result, VarsWithSources)
+        self.assertEqual(result.data, dict(a=1, b=2, c=1))
+        # c now comes from the dict, so the source recorded for it no longer applies
+        self.assertEqual(result.sources, dict(b='b_src'))
+
+        result = vws | VarsWithSources.new_vars_with_sources(dict(c=3), dict(c='new_c_src'))
+        self.assertEqual(result.data, dict(b=2, c=3))
+        self.assertEqual(result.sources, dict(b='b_src', c='new_c_src'))
+
+        # the operands are left untouched while |= updates in place
+        self.assertEqual(vws.data, dict(b=2, c=2))
+        self.assertEqual(vws.sources, dict(b='b_src', c='c_src'))
+        orig = vws
+        vws |= dict(c=3)
+        self.assertIs(vws, orig)
+        self.assertEqual(vws.data, dict(b=2, c=3))
+        self.assertEqual(vws.sources, dict(b='b_src'))
+
