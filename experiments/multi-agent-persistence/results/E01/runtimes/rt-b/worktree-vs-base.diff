@@ -786,3 +786,19 @@ class VarsWithSources(MutableMapping):
 
     def copy(self):
         return VarsWithSources.new_vars_with_sources(self.data.copy(), self.sources.copy())
+
+    def __or__(self, other):
+        ''' Merge another mapping into this one, returning a plain dict with the other mapping's keys taking precedence '''
+        if not isinstance(other, MutableMapping):
+            return NotImplemented
+        result = dict(self.data)
+        result.update(other)
+        return result
+
+    def __ror__(self, other):
+        ''' Merge this mapping into another mapping, returning a plain dict with this mapping's keys taking precedence '''
+        if not isinstance(other, MutableMapping):
+            return NotImplemented
+        result = dict(other)
+        result.update(self.data)
+        return result
