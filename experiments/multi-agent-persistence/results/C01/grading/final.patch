+    def test_vars_with_sources_union_operators(self):
+        mapping = dict(a=1, conflict='mapping')
+        vars_with_sources = VarsWithSources.new_vars_with_sources(
+            dict(b=2, conflict='vars_with_sources'), {'b': 'test source'})
+
+        # standard mapping on the left, VarsWithSources on the right
+        result = mapping | vars_with_sources
+        self.assertIsInstance(result, dict)
+        self.assertEqual(result, dict(a=1, b=2, conflict='vars_with_sources'))
+
+        # VarsWithSources on the left, standard mapping on the right
+        result = vars_with_sources | mapping
+        self.assertIsInstance(result, VarsWithSources)
+        self.assertEqual(result, dict(a=1, b=2, conflict='mapping'))
+        self.assertEqual(result.get_source('b'), 'test source')
+
+        # in-place union
+        vars_with_sources |= dict(c=3)
+        self.assertIsInstance(vars_with_sources, VarsWithSources)
+        self.assertEqual(vars_with_sources, dict(b=2, conflict='vars_with_sources', c=3))
