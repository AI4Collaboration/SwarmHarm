+    def test_combine_vars_replace_vars_with_sources_with_dict(self):
+        a = VarsWithSources.new_vars_with_sources(dict(a=1, conflict='vars_with_sources'), {'a': 'test source'})
+        b = dict(b=2, conflict='dict')
+
+        with mock.patch('ansible.constants.DEFAULT_HASH_BEHAVIOUR', 'replace'):
