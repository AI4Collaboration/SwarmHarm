diff --git a/lib/ansible/vars/manager.py b/lib/ansible/vars/manager.py
index 93a1b9ad38..b879386e13 100644
--- a/lib/ansible/vars/manager.py
+++ b/lib/ansible/vars/manager.py
@@ -786,3 +786,28 @@ class VarsWithSources(MutableMapping):
 
     def copy(self):
         return VarsWithSources.new_vars_with_sources(self.data.copy(), self.sources.copy())
+
+    def __or__(self, other):
+        if not isinstance(other, Mapping):
+            return NotImplemented
+
+        # the result keeps the type of the left operand, as the pre-union
+        # implementation of combine_vars() (copy() followed by update()) did
+        result = self.copy()
+        result.update(other)
+        return result
+
+    def __ror__(self, other):
+        if not isinstance(other, Mapping):
+            return NotImplemented
+
+        result = other.copy() if isinstance(other, dict) else dict(other)
+        result.update(self)
+        return result
+
+    def __ior__(self, other):
+        if not isinstance(other, Mapping):
+            return NotImplemented
+
+        self.update(other)
+        return self
