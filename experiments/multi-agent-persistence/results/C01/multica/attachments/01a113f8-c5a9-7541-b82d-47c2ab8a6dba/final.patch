+    def test_vars_with_sources_union(self):
+        vars_with_sources = VarsWithSources(dict(b=2))
+        result = dict(a=1) | vars_with_sources
+        self.assertEqual(result, dict(a=1, b=2))
+        self.assertIsInstance(result, dict)
+        result = vars_with_sources | dict(a=1)
+        self.assertEqual(result, dict(a=1, b=2))
