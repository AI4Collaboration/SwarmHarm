+    def test_combine_vars_replace_with_vars_with_sources(self):
+        vars_with_sources = VarsWithSources.new_vars_with_sources(dict(b=2, c=3), dict(b='src_b', c='src_c'))
+        with mock.patch('ansible.constants.DEFAULT_HASH_BEHAVIOUR', 'replace'):
+            # dict on the left, VarsWithSources on the right
+            self.assertEqual(combine_vars(dict(a=1), vars_with_sources), dict(a=1, b=2, c=3))
+            # keys from the second operand prevail
+            self.assertEqual(combine_vars(dict(a=1, b=0), vars_with_sources), dict(a=1, b=2, c=3))
+            # VarsWithSources on the left, dict on the right
+            self.assertEqual(combine_vars(vars_with_sources, dict(d=4)), dict(b=2, c=3, d=4))
