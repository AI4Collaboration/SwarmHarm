+class TestVarsWithSources(unittest.TestCase):
+
+    def setUp(self):
+        self.vars = VarsWithSources.new_vars_with_sources(dict(a=1, b=2), dict(a='role vars', b='role vars'))
+
+    def test_or_mapping(self):
+        result = self.vars | dict(b=3, c=4)
+        self.assertIsInstance(result, VarsWithSources)
+        self.assertEqual(result.data, dict(a=1, b=3, c=4))
+        # 'b' now comes from a plain dict, so it no longer has a known source
+        self.assertEqual(result.sources, dict(a='role vars'))
+        self.assertEqual(self.vars.data, dict(a=1, b=2))
+        self.assertEqual(self.vars.sources, dict(a='role vars', b='role vars'))
+
+    def test_ror_mapping(self):
+        other = dict(b=3, c=4)
+        result = other | self.vars
+        self.assertIsInstance(result, VarsWithSources)
+        self.assertEqual(result.data, dict(a=1, b=2, c=4))
+        self.assertEqual(result.sources, dict(a='role vars', b='role vars'))
+        self.assertEqual(other, dict(b=3, c=4))
+        self.assertEqual(self.vars.data, dict(a=1, b=2))
+
+    def test_or_vars_with_sources(self):
+        other = VarsWithSources.new_vars_with_sources(dict(b=3, c=4), dict(b='extra vars', c='extra vars'))
+        result = self.vars | other
+        self.assertEqual(result.data, dict(a=1, b=3, c=4))
+        self.assertEqual(result.sources, dict(a='role vars', b='extra vars', c='extra vars'))
+
+    def test_ior(self):
+        result = self.vars
+        result |= dict(b=3, c=4)
+        self.assertIs(result, self.vars)
+        self.assertEqual(result.data, dict(a=1, b=3, c=4))
+        self.assertEqual(result.sources, dict(a='role vars'))
+
+    def test_or_unsupported_type(self):
+        self.assertRaises(TypeError, operator.or_, self.vars, [('b', 3)])
+        self.assertRaises(TypeError, operator.or_, [('b', 3)], self.vars)
