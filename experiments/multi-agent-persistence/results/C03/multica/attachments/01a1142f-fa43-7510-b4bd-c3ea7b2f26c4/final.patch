diff --git a/changelogs/fragments/varswithsources-dict-union.yml b/changelogs/fragments/varswithsources-dict-union.yml
new file mode 100644
index 0000000000..d4a51fe443
--- /dev/null
+++ b/changelogs/fragments/varswithsources-dict-union.yml
@@ -0,0 +1,4 @@
+bugfixes:
+  - "vars - fix ``TypeError: unsupported operand type(s) for |`` when combining variables while ``ANSIBLE_DEBUG`` is enabled
+    and ``hash_behaviour`` is ``replace`` (the default). ``VarsWithSources``, the dict-like class used for variables in that mode,
+    now supports the ``|`` and ``|=`` operators like ``dict``."
diff --git a/lib/ansible/vars/manager.py b/lib/ansible/vars/manager.py
index 93a1b9ad38..858303e427 100644
--- a/lib/ansible/vars/manager.py
+++ b/lib/ansible/vars/manager.py
@@ -786,3 +786,29 @@ class VarsWithSources(MutableMapping):
 
     def copy(self):
         return VarsWithSources.new_vars_with_sources(self.data.copy(), self.sources.copy())
+
+    # MutableMapping does not provide the dict union operators (PEP 584), but combine_vars() relies on them
+    def __or__(self, other):
+        if not isinstance(other, Mapping):
+            return NotImplemented
+        new = self.copy()
+        new |= other
+        return new
+
+    def __ror__(self, other):
+        if not isinstance(other, Mapping):
+            return NotImplemented
+        new = VarsWithSources(other)
+        new |= self
+        return new
+
+    def __ior__(self, other):
+        if isinstance(other, VarsWithSources):
+            # Read the underlying dicts to avoid a debug message for every var being merged
+            data, sources = other.data, other.sources
+        else:
+            data, sources = dict(other), {}
+        # Vars from other replace ours, so the sources recorded for them no longer apply
+        self.sources = {k: v for k, v in self.sources.items() if k not in data} | sources
+        self.data |= data
+        return self
