index 0000000000..b29172591e
--- /dev/null
+++ b/changelogs/fragments/vars_with_sources_union.yml
@@ -0,0 +1,2 @@
+bugfixes:
+  - "vars - ``VarsWithSources`` (used for task vars when ``ANSIBLE_DEBUG`` is enabled) now supports the ``|`` and ``|=`` operators with other mappings, fixing ``TypeError: unsupported operand type(s) for |`` in ``combine_vars`` with the default ``replace`` hash behaviour."
diff --git a/lib/ansible/vars/manager.py b/lib/ansible/vars/manager.py
index 93a1b9ad38..1ea753af29 100644
--- a/lib/ansible/vars/manager.py
+++ b/lib/ansible/vars/manager.py
@@ -786,3 +786,35 @@ class VarsWithSources(MutableMapping):
 
     def copy(self):
         return VarsWithSources.new_vars_with_sources(self.data.copy(), self.sources.copy())
+
+    # Union operators (PEP 584): the right operand wins on conflicts, and the result is a VarsWithSources only when self is
+    # the left operand, otherwise a plain dict. The underlying dicts are used directly to avoid a debug message for every var.
+    def __or__(self, other):
+        if not isinstance(other, Mapping):
+            return NotImplemented
+        new = self.copy()
+        new |= other
+        return new
+
+    def __ror__(self, other):
+        if not isinstance(other, Mapping):
+            return NotImplemented
+        new = dict(other)
+        new.update(self.data)
+        return new
+
+    def __ior__(self, other):
+        if not isinstance(other, Mapping):
+            return NotImplemented
+        if isinstance(other, VarsWithSources):
+            data, sources = other.data, other.sources
+        else:
+            data, sources = other, {}
+        self.data.update(data)
+        for key in data:
+            if key in sources:
+                self.sources[key] = sources[key]
+            else:
+                # the recorded source is stale now that the value comes from other
+                self.sources.pop(key, None)
+        return self
