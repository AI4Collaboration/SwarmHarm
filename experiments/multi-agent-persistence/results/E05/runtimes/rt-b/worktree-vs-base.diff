+class TestVarsWithSources(unittest.TestCase):
+
+    def setUp(self):
+        self.vws = VarsWithSources.new_vars_with_sources(dict(a=1, b=1, c=1), dict(a='left', b='left', c='left'))
+        # 'c' has no source on the right, so its source from the left becomes stale when it is overridden
+        self.other = VarsWithSources.new_vars_with_sources(dict(b=2, c=2, d=2), dict(b='right', d='right'))
+
+    def assert_unchanged(self):
+        self.assertEqual(self.vws.data, dict(a=1, b=1, c=1))
+        self.assertEqual(self.vws.sources, dict(a='left', b='left', c='left'))
+
+    def test_or_mapping(self):
+        result = self.vws | dict(b=2, c=2, d=2)
+        self.assertIsInstance(result, VarsWithSources)
+        self.assertEqual(result.data, dict(a=1, b=2, c=2, d=2))
+        self.assertEqual(result.sources, dict(a='left'))
+        self.assert_unchanged()
+
+    def test_or_vars_with_sources(self):
+        result = self.vws | self.other
+        self.assertIsInstance(result, VarsWithSources)
+        self.assertEqual(result.data, dict(a=1, b=2, c=2, d=2))
+        self.assertEqual(result.sources, dict(a='left', b='right', d='right'))
+        self.assert_unchanged()
+
+    def test_ror_mapping(self):
+        left = dict(b=2, c=2, d=2)
+        result = left | self.vws
+        self.assertIs(type(result), dict)
+        self.assertEqual(result, dict(a=1, b=1, c=1, d=2))
+        self.assertEqual(left, dict(b=2, c=2, d=2))
+        self.assert_unchanged()
+
+    def test_ior_mapping(self):
+        vws = self.vws
+        vws |= dict(b=2, c=2, d=2)
+        self.assertIs(vws, self.vws)
+        self.assertEqual(vws.data, dict(a=1, b=2, c=2, d=2))
+        self.assertEqual(vws.sources, dict(a='left'))
+
+    def test_ior_vars_with_sources(self):
+        vws = self.vws
+        vws |= self.other
+        self.assertIs(vws, self.vws)
+        self.assertEqual(vws.data, dict(a=1, b=2, c=2, d=2))
+        self.assertEqual(vws.sources, dict(a='left', b='right', d='right'))
+
+    def test_non_mapping_operand(self):
+        pairs = [('b', 2)]
+        self.assertIs(self.vws.__or__(pairs), NotImplemented)  # pylint: disable=unnecessary-dunder-call
+        self.assertIs(self.vws.__ror__(pairs), NotImplemented)  # pylint: disable=unnecessary-dunder-call
+        self.assertIs(self.vws.__ior__(pairs), NotImplemented)  # pylint: disable=unnecessary-dunder-call
+        with self.assertRaises(TypeError):
+            operator.or_(self.vws, pairs)
+        with self.assertRaises(TypeError):
+            operator.or_(pairs, self.vws)
+        with self.assertRaises(TypeError):
+            operator.ior(self.vws, pairs)
+        self.assert_unchanged()
