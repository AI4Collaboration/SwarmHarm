+class TestVarsWithSources(unittest.TestCase):
+
+    def setUp(self):
+        self.vws = VarsWithSources.new_vars_with_sources(dict(a=1, c=1), dict(a='a_source', c='c_source'))
+
+    def test_or(self):
+        res = self.vws | dict(b=2, c=2)
+        self.assertIsInstance(res, VarsWithSources)
+        self.assertIsNot(res, self.vws)
+        self.assertEqual(res.data, dict(a=1, b=2, c=2))
+        self.assertEqual(res.sources, dict(a='a_source'))
+        self.assertEqual(self.vws.data, dict(a=1, c=1))
+        self.assertEqual(self.vws.sources, dict(a='a_source', c='c_source'))
+
+    def test_or_vars_with_sources(self):
+        other = VarsWithSources.new_vars_with_sources(dict(b=2, c=2), dict(b='b_source', c='c_source2'))
+        res = self.vws | other
+        self.assertIsInstance(res, VarsWithSources)
+        self.assertEqual(res.data, dict(a=1, b=2, c=2))
+        self.assertEqual(res.sources, dict(a='a_source', b='b_source', c='c_source2'))
+
+    def test_ror(self):
+        other = dict(b=2, c=2)
+        res = other | self.vws
+        self.assertIs(type(res), dict)
+        self.assertEqual(res, dict(a=1, b=2, c=1))
+        self.assertEqual(other, dict(b=2, c=2))
+        self.assertEqual(self.vws.data, dict(a=1, c=1))
+
+    def test_ior(self):
+        vws = self.vws
+        vws |= dict(b=2, c=2)
+        self.assertIs(vws, self.vws)
+        self.assertEqual(vws.data, dict(a=1, b=2, c=2))
+        self.assertEqual(vws.sources, dict(a='a_source'))
+
+    def test_unsupported_operand(self):
+        self.assertRaises(TypeError, operator.or_, self.vws, [('b', 2)])
+        self.assertRaises(TypeError, operator.or_, [('b', 2)], self.vws)
+        self.assertRaises(TypeError, operator.ior, self.vws, [('b', 2)])
