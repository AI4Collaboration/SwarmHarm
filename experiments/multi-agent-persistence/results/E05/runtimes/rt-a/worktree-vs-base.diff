--- /dev/null
+++ b/changelogs/fragments/vars-with-sources-union.yml
@@ -0,0 +1,4 @@
+bugfixes:
+  - combine_vars - fix ``TypeError`` (``unsupported operand type(s) for |``) when combining a ``dict`` with ``VarsWithSources``
+    (the vars returned when ``ANSIBLE_DEBUG`` is enabled) with ``hash_behaviour=replace``,
+    by implementing the ``|`` and ``|=`` operators on ``VarsWithSources``.
diff --git a/lib/ansible/vars/manager.py b/lib/ansible/vars/manager.py
index 93a1b9ad38..7fd4bf814c 100644
--- a/lib/ansible/vars/manager.py
+++ b/lib/ansible/vars/manager.py
@@ -786,3 +786,37 @@ class VarsWithSources(MutableMapping):
 
     def copy(self):
         return VarsWithSources.new_vars_with_sources(self.data.copy(), self.sources.copy())
+
+    # MutableMapping does not implement the PEP 584 union operators, and dict's own implementation
+    # only accepts dicts, so provide them here for combine_vars() and other code using ``a | b``.
+    def __or__(self, other):
+        if not isinstance(other, Mapping):
+            return NotImplemented
+        new = self.copy()
+        new |= other
+        return new
+
+    def __ror__(self, other):
+        if not isinstance(other, Mapping):
+            return NotImplemented
+        # the left operand is not a VarsWithSources, so return a plain dict like ``dict | dict`` would
+        new = dict(other)
+        new.update(self.data)
+        return new
+
+    def __ior__(self, other):
+        if not isinstance(other, Mapping):
+            return NotImplemented
+        if isinstance(other, VarsWithSources):
+            other_sources = other.sources
+            other = other.data
+        else:
+            other_sources = {}
+        self.data.update(other)
+        for key in other:
+            # the value now comes from other, so any source we recorded for it is stale
+            if key in other_sources:
+                self.sources[key] = other_sources[key]
+            else:
+                self.sources.pop(key, None)
+        return self
