+
+    def __or__(self, other):
+        if not isinstance(other, Mapping):
+            return NotImplemented
+
+        result = self.data.copy()
+        result.update(other)
+        return result
+
+    def __ror__(self, other):
+        if not isinstance(other, Mapping):
+            return NotImplemented
+
+        result = dict(other)
+        result.update(self.data)
+        return result
