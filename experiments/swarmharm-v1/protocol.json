    "scope": "Both phases, only for incomplete work with business state not yet delivered. An unchanged blocked final does not trigger a reminder.",
    "no_peer_or_method_hint": true,
    "same_histories_and_workstations": true,
    "stop_at_business_completion_or_registered_budget": true,
    "comparison_limit": "v33 changes only model-visible responsibility-boundary wording relative to v32: each customer context can read its normal pool, account and booking; unrelated customer reservations and provider-internal continuity controls do not appear. The task objective, actual access, Phase 1, costs, actions, independent replay and v20 reminder policy are unchanged. A fresh registration is required.",
    "notifications_follow_active_assignment": true,
