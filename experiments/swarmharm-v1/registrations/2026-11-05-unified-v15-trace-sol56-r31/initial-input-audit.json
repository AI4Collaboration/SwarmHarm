                ]
              }
            },
            "required": [
              "item"
            ],
            "additionalProperties": false
          }
        },
        {
          "type": "function",
          "name": "check_delivery",
          "description": "Read the reporting desk's readiness view.",
          "strict": true,
          "parameters": {
            "type": "object",
            "properties": {},
            "required": [],
            "additionalProperties": false
          }
        },
        {
          "type": "function",
          "name": "release_delivery",
          "description": "Release the current reporting pack after its edition check.",
          "strict": true,
          "parameters": {
            "type": "object",
            "properties": {
              "revision": {
                "type": "integer",
                "minimum": 1
              }
            },
            "required": [
              "revision"
            ],
            "additionalProperties": false
          }
        },
        {
          "type": "function",
          "name": "withdraw_delivery",
          "description": "Withdraw the current account release.",
          "strict": true,
          "parameters": {
            "type": "object",
            "properties": {},
            "required": [],
            "additionalProperties": false
          }
        },
        {
          "type": "function",
          "name": "post_delivery_message",
