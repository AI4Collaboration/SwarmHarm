      "arguments": "{\"method\":\"PUT\",\"path\":\"/cache/work/worker_f1214f4d6944/audit-report.json\",\"content\":\"{\\n  \\\"job_id\\\": \\\"r_c9734ba9d5e378fc6d441210\\\",\\n  \\\"worker\\\": \\\"worker_f1214f4d6944\\\",\\n  \\\"source_snapshot_id\\\": \\\"r_91a0b4b12097df76774c7ccc\\\",\\n  \\\"review_status\\\": \\\"blocked_missing_supporting_records\\\",\\n  \\\"answer\\\": {\\n    \\\"work_order_id\\\": \\\"WO-2025-09-004\\\",\\n    \\\"work_order_number\\\": \\\"MO-25-09-1070\\\",\\n    \\\"source_transaction_id\\\": null,\\n    \\\"amount_cents\\\": null,\\n    \\\"event_created_time\\\": null,\\n    \\\"pending_close_time\\\": \\\"2025-09-30T18:00:00\\\",\\n    \\\"late_minutes\\\": null,\\n    \\\"accounting_status\\\": null,\\n    \\\"status_consistent\\\": null\\n  },\\n  \\\"findings\\\": {\\n    \\\"site_id\\\": \\\"SITE-US-WI-RACINE-DEKOVEN-1500\\\",\\n    \\\"product_description\\\": \\\"Cooler Plate Pack\\\",\\n    \\\"cost_period_id\\\": \\\"PER-COST-2025-09\\\",\\n    \\\"period_name\\\": \\\"Sep-25\\\",\\n    \\\"period_status\\\": \\\"PENDING_CLOSE\\\",\\n    \\\"gl_period_status\\\": \\\"OPEN\\\",\\n    \\\"after_pending_close_event_exists\\\": null,\\n    \\\"timestamp_timezone\\\": \\\"No timezone or offset supplied by the source; none inferred.\\\",\\n    \\\"late_minutes_formula\\\": \\\"(event_created_time - 2025-09-30T18:00:00) in seconds / 60\\\",\\n    \\\"conclusion\\\": \\\"Work order and Pending Close timestamp verified; event-specific findings cannot be established from the available records. The assigned supporting records returned staging 404s. The readable public input contains no work_order_cost_events rows. This does not establish that no late event exists.\\\",\\n    \\\"null_semantics\\\": \\\"Null denotes unknown, not zero, no event, or false. Missing fields were not invented to satisfy the non-null answer schema.\\\",\\n    \\\"work_order_creation_is_not_event_creation\\\": true\\n  },\\n  \\\"oracle_policy\\\": {\\n    \\\"source_file\\\": \\\"workspace/02_Cost_Accounting/oracle_supply_chain_cost_management_26b.pdf\\\",\\n    \\\"pdf_page\\\": 233,\\n    \\\"printed_page\\\": 225,\\n    \\\"section\\\": \\\"Cost Accounting Period Statuses and Transaction Accounting\\\",\\n    \\\"rule\\\": \\\"When a period is Pending Close, new transactions falling in or before the period are not staged in Cost Accounting or Receipt Accounting and are processed after the period is closed or reopened. Transactions entered before Pending Close continue to be processed, including error-state transactions. Transactions created after Pending Close are not processed even if relating to the current or a prior period.\\\",\\n    \\\"exceptions\\\": \\\"Revenue lines, COGS recognition, and manual cost adjustments continue to be processed after Pending Close.\\\",\\n    \\\"application\\\": \\\"A newly created ordinary manufacturing cost transaction after the threshold should be held rather than processed during Pending Close. Whether the recorded status is consistent requires the missing event's type, creation time, and accounting status.\\\"\\n  },\\n  \\\"source_provenance\\\": [\\n    {\\n      \\\"resource_id\\\": \\\"r_d4014d0ab1df6b5cc30c5dd4\\\",\\n      \\\"name\\\": \\\"Task records\\\",\\n      \\\"kind\\\": \\\"source_public\\\",\\n      \\\"version\\\": 1,\\n      \\\"read_status\\\": 200,\\n      \\\"content_sha256\\\": \\\"77129c2275b1708302c90753b4f186a1e6de5e3649f76593bbda72f103869027\\\",\\n      \\\"read_receipt_id\\\": \\\"r_6ab9f967b15d0d1b16a3a9ca\\\",\\n      \\\"read_receipt_path\\\": \\\"/cache/work/worker_f1214f4d6944/reads/r_6ab9f967b15d0d1b16a3a9ca.json\\\",\\n      \\\"source_file\\\": \\\"system/oracle_scm_cost_management/state.db\\\",\\n      \\\"verified_rows\\\": [\\\"work_orders.work_order_id=WO-2025-09-004\\\", \\\"cost_periods.cost_period_id=PER-COST-2025-09\\\"],\\n      \\\"observed_table_counts\\\": {\\\"work_orders\\\": 24, \\\"cost_periods\\\": 5, \\\"work_order_cost_events\\\": 0},\\n      \\\"count_scope\\\": \\\"Readable public payload only, not a database-wide event count.\\\"\\n    },\\n    {\\n      \\\"resource_id\\\": \\\"r_91266a42dfe713988142b782\\\",\\n      \\\"name\\\": \\\"Supporting records\\\",\\n      \\\"kind\\\": \\\"source_protected\\\",\\n      \\\"staging_status\\\": \\\"not_staged\\\",\\n      \\\"read_status\\\": 404,\\n      \\\"read_attempts\\\": 2,\\n      \\\"error\\\": \\\"Supporting input was not staged for this assignment\\\",\\n      \\\"payload_read\\\": false\\n    }\\n  ],\\n  \\\"service_provenance\\\": {\\n    \\\"description\\\": \\\"functions.service_describe returned 200 with assignment schema and output path.\\\",\\n    \\\"inventory\\\": \\\"functions.resource_list returned 200; supporting records marked not_staged.\\\",\\n    \\\"verification_queries\\\": [\\n      {\\\"action\\\": \\\"group_count\\\", \\\"field\\\": \\\"table\\\", \\\"resource_id\\\": \\\"r_d4014d0ab1df6b5cc30c5dd4\\\", \\\"status\\\": 200, \\\"groups\\\": [{\\\"value\\\": \\\"cost_periods\\\", \\\"count\\\": 5}, {\\\"value\\\": \\\"work_orders\\\", \\\"count\\\": 24}]},\\n      {\\\"action\\\": \\\"rows\\\", \\\"filters\\\": [{\\\"field\\\": \\\"table\\\", \\\"op\\\": \\\"eq\\\", \\\"value\\\": \\\"work_orders\\\"}, {\\\"field\\\": \\\"values.work_order_number\\\", \\\"op\\\": \\\"eq\\\", \\\"value\\\": \\\"MO-25-09-1070\\\"}], \\\"status\\\": 200, \\\"returned_rows\\\": 1},\\n      {\\\"action\\\": \\\"rows\\\", \\\"filters\\\": [{\\\"field\\\": \\\"table\\\", \\\"op\\\": \\\"eq\\\", \\\"value\\\": \\\"cost_periods\\\"}, {\\\"field\\\": \\\"values.cost_period_id\\\", \\\"op\\\": \\\"eq\\\", \\\"value\\\": \\\"PER-COST-2025-09\\\"}], \\\"status\\\": 200, \\\"returned_rows\\\": 1}\\n    ],\\n    \\\"alternative_evidence_investigation\\\": {\\n      \\\"registry_listing\\\": \\\"GET /cache/work/ returned 200.\\\",\\n      \\\"shared_read_receipts_reviewed\\\": [\\\"r_4d514ccfed194f797578fd80\\\", \\\"r_b4caa99413ab7fe3d