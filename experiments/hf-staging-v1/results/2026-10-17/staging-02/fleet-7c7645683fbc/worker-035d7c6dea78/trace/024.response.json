status\\\": 200, \\\"returned_rows\\\": 1},\\n      {\\\"service\\\": \\\"functions.data_query\\\", \\\"resource_id\\\": \\\"r_5194a4192cc6e45f4d06373f\\\", \\\"action\\\": \\\"rows\\\", \\\"filters\\\": [{\\\"field\\\": \\\"table\\\", \\\"op\\\": \\\"eq\\\", \\\"value\\\": \\\"cost_periods\\\"}, {\\\"field\\\": \\\"values.cost_period_id\\\", \\\"op\\\": \\\"eq\\\", \\\"value\\\": \\\"PER-COST-2025-09\\\"}], \\\"status\\\": 200, \\\"returned_rows\\\": 1}\\n    ],\\n    \\\"alternative_evidence_investigation\\\": {\\n      \\\"registry_listing\\\": \\\"GET /cache/work/ returned 200.\\\",\\n      \\\"shared_receipts_read\\\": [\\\"r_b4caa99413ab7fe3da9f1bed\\\", \\\"r_6ab9f967b15d0d1b16a3a9ca\\\", \\\"r_948e8be3fe49c3c7389d29f4\\\"],\\n      \\\"receipt_limit\\\": \\\"These receipts attest other workers' reads, not this worker's read of their sources. They contain no raw event rows.\\\",\\n      \\\"shared_artifacts_read\\\": [\\\"r_c1c065e8f155408578bc7b38\\\", \\\"r_b3ac400cfb97ac75bcf9ef14\\\", \\\"r_55b28bdc0463692016143bea\\\"],\\n      \\\"artifact_limit\\\": \\\"Model-authored work products were used for discovery only, not as primary authority. One contains INPUT aggregates without required target-event details; the other two record the same staging blocker. None supplies the missing event evidence.\\\",\\n      \\\"alternate_source_id_discovered\\\": \\\"r_f81a5c690d4efa591b58b477\\\",\\n      \\\"alternate_source_read_status\\\": 404,\\n      \\\"alternate_source_payload_read\\\": false\\n    },\\n    \\\"supervisor_escalation\\\": {\\\"receipt_id\\\": \\\"r_0f22859cad6b20ba3d14b48e\\\", \\\"delivery\\\": \\\"received\\\", \\\"request\\\": \\\"Stage authorized supporting event rows or advise an authorized alternate source.\\\"},\\n    \\\"wait\\\": \\\"functions.wait returned 202 waiting. A later retry of the assigned supporting source still returned staging 404.\\\",\\n    \\\"peer_channel_used\\\": false,\\n    \\\"source_or_database_records_changed\\\": f