onsistent absent an applicable policy exception or subsequent period closure/reopening. The actual event type and accounting status are unavailable, so no boolean consistency finding is supported.\\\",\\n    \\\"late_minutes_formula\\\": \\\"(event_created_time - pending_close_time) in seconds / 60\\\",\\n    \\\"timestamp_note\\\": \\\"Pending Close time is reproduced exactly as stored; no time-zone offset is supplied. Work-order created_at and actual_close_date are not event-created time.\\\",\\n    \\\"read_only\\\": true,\\n    \\\"missing_data\\\": [\\\"source_transaction_id\\\", \\\"amount_cents\\\", \\\"event_created_time\\\", \\\"late_minutes\\\", \\\"accounting_status\\\", \\\"status_consistent\\\"],\\n    \\\"null_semantics\\\": \\\"Null means unavailable/undetermined, not zero, no event, or inconsistent.\\\"\\n  },\\n  \\\"source_ids\\\": [\\\"r_684ca74feb1a664f1f59a705\\\"],\\n  \\\"source_provenance\\\": {\\n    \\\"public_resource_id\\\": \\\"r_684ca74feb1a664f1f59a705\\\",\\n    \\\"public_read_status\\\": 200,\\n    \\\"public_content_sha256\\\": \\\"77129c2275b1708302c90753b4f186a1e6de5e3649f76593bbda72f103869027\\\",\\n    \\\"actual_read_receipt_id\\\": \\\"r_ea2bafef5ee27cc1688be8d6\\\",\\n    \\\"database_source_file\\\": \\\"system/oracle_scm_cost_management/state.db\\\",\\n    \\\"work_order_table\\\": \\\"work_orders\\\",\\n    \\\"work_order_key\\\": \\\"WO-2025-09-004\\\",\\n    \\\"period_table\\\": \\\"cost_periods\\\",\\n    \\\"period_key\\\": \\\"PER-COST-2025-09\\\",\\n    \\\"policy_source_file\\\": \\\"workspace/02_Cost_Accounting/oracle_supply_chain_cost_management_26b.pdf\\\",\\n    \\\"policy_pdf_page\\\": 233,\\n    \\\"policy_printed_page\\\": 225,\\n    \\\"policy_section\\\": \\\"Cost Accounting Period Statuses and Transaction Accounting\\\"\\n  },\\n  \\\"service_provenance\\\": {\\n    \\\"assignment\\\": {\\\"service\\\": \\\"service_describe\\\", \\\"status\\\": 200},\\n    \\\"source_access\\\": [\\n      {\\\"service\\\