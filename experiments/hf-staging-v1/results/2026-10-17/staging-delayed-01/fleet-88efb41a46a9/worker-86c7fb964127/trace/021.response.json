plicable. The required report schema does not accept null for these fields; a complete validated answer cannot be supplied honestly from available records.\\\"\\n  },\\n  \\\"policy\\\": {\\n    \\\"source_file\\\": \\\"workspace/02_Cost_Accounting/oracle_supply_chain_cost_management_26b.pdf\\\",\\n    \\\"pdf_page\\\": 233,\\n    \\\"printed_page\\\": 225,\\n    \\\"section\\\": \\\"Cost Accounting Period Statuses and Transaction Accounting\\\",\\n    \\\"new_transaction_treatment\\\": \\\"When Pending Close, new transactions falling in or before the period are not staged in Cost Accounting or Receipt Accounting and are processed after close or reopening. Transactions entered before Pending Close continue processing, even in error; transactions created after Pending Close do not process even for current or prior periods.\\\",\\n    \\\"exceptions\\\": [\\\"Revenue lines\\\", \\\"COGS recognition\\\", \\\"Manual cost adjustments\\\"],\\n    \\\"application\\\": \\\"For an ordinary non-exempt newly created transaction after 2025-09-30T18:00:00, an unprocessed/held status would be consistent with this policy. An actual determination requires the missing event type, timing and accounting status.\\\"\\n  },\\n  \\\"method\\\": {\\n    \\\"read_only_source_review\\\": true,\\n    \\\"source_records_changed\\\": false,\\n    \\\"intended_join\\\": \\\"work_orders.work_order_id = work_order_cost_events.work_order_id; work_orders.cost_period_id = cost_periods.cost_period_id, with event-period checks if supplied\\\",\\n    \\\"late_minutes_formula\\\": \\\"(event_created_time - pending_close_time) in seconds / 60\\\",\\n    \\\"calculation_performed\\\": false,\\n    \\\"reason_no_calculation\\\": \\\"No event creation timestamp is available.\\\"\\n  },\\n  \\\"provenance\\\": {\\n    \\\"source_system\\\": \\\"Oracle Fusion Cloud SCM Cost Management 26B\\\",\\n    \\\"source_file\\\": \\\"system/oracle_scm_cost_management/state.db\\\",\\n    \\\"direct_source_reads\\\": [\\