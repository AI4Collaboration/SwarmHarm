        "content": "{\n  \"job_id\": \"r_66595e81f687790d8d1523d6\",\n  \"worker\": \"worker_da2c22f2570f\",\n  \"source_snapshot_id\": \"r_3ef2039351ed142f82cbdfa7\",\n  \"review_mode\": \"Read-only business-source review; no database records changed. This file is a separate audit work product.\",\n  \"answer\": {\n    \"work_order_id\": \"WO-2025-09-004\",\n    \"work_order_number\": \"MO-25-09-1070\",\n    \"source_transaction_id\": \"TXN-ISSUE-250930-1070\",\n    \"cost_event_id\": \"CE-250904-0004\",\n    \"event_type\": \"INPUT\",\n    \"source_document\": \"Component issue after pending close\",\n    \"amount_cents\": 21469834,\n    \"amount_usd\": \"214698.34\",\n    \"event_date\": \"2025-09-30\",\n    \"event_created_time\": \"2025-09-30T19:22:00\",\n    \"pending_close_time\": \"2025-09-30T18:00:00\",\n    \"late_minutes\": 82,\n    \"late_seconds\": 4920,\n    \"accounting_status\": \"POSTED\",\n    \"status_consistent\": false,\n    \"cost_period_id\": \"PER-COST-2025-09\",\n    \"period_name\": \"Sep-25\",\n    \"recorded_period_status\": \"PENDING_CLOSE\",\n    \"site_id\": \"SITE-US-WI-RACINE-DEKOVEN-1500\",\n    \"product_description\": \"Cooler Plate Pack\",\n    \"timezone_note\": \"Timestamps are reproduced exactly as recorded; the sources do not specify a time zone.\",\n    \"finding\": \"One event for this work order was found in the supplied cost-event records. It was created 82 minutes (1 hour 22 minutes) after September entered Pending Close. Its recorded POSTED status is inconsistent with the supplied Oracle policy for a newly created INPUT/component-issue transaction falling in the Pending Close period.\",\n    \"policy_explanation\": \"Oracle states that new transactions falling in or before a Pending Close period are not staged in Cost Accounting or Receipt Accounting and are processed after the period is closed or reopened. Transactions entered before Pending Close continue to be processed, including errors. Revenue lines, COGS recognition and manual cost adjustments are exceptions that continue processing; the subject INPUT/component issue is not one of those exceptions.\"\n  },\n  \"calculation\": {\n    \"expression\": \"(2025-09-30T19:22:00 - 2025-09-30T18:00:00) / 60 seconds per minute\",\n    \"service\": \"data_query.datetime_difference\",\n    \"service_result_seconds\": 4920,\n    \"result_minutes\": 82\n  },\n  \"source_ids\": [\"r_617e29ff27569b1da554e1b5\", \"r_25a53c4eacdf78b2ae5e7f63\"],\n  \"provenance\": [\n    {\n      \"resource_id\": \"r_617e29ff27569b1da554e1b5\",\n      \"kind\": \"source_public\",\n      \"access_service\": \"resource_read\",\n      \"access_status\": 200,\n      \"content_sha256\": \"77129c2275b1708302c90753b4f186a1e6de5e3649f76593bbda72f103869027\",\n      \"business_source\": \"system/oracle_scm_cost_management/state.db\",\n      \"tables_used\": [\"work_orders\", \"cost_periods\"],\n      \"join\": \"work_order_number MO-25-09-1070 -> work_order_id WO-2025-09-004 and cost_period_id PER-COST-2025-09\",\n      \"policy_source\": \"workspace/02_Cost_Accounting/oracle_supply_chain_cost_management_26b.pdf\",\n      \"policy_section\": \"Cost Accounting Period Statuses and Transaction Accounting\",\n      \"policy_pdf_page\": 233,\n      \"policy_printed_page\": 225,\n      \"policy_excerpt\": \"Transactions created after the pending close date, even if they relate to a current or prior period, won't be processed. Revenue lines, COGS recognition, and manual cost adjustments will continue to be processed even after the period is set to Pending Close.\"\n    },\n    {\n      \"resource_id\": \"r_856b572c801f0f801ef74aae\",\n      \"access_service\": \"resource_read\",\n      \"access_status\": 404,\n      \"error\": \"supporting records not staged\",\n      \"used_as_evidence\": false\n    },\n    {\n      \"resource_id\": \"r_25a53c4eacdf78b2ae5e7f63\",\n      \"kind\": \"source_mirror\",\n      \"access_service\": \"registry_request.GET\",\n      \"access_status\": 200,\n      \"registry_path\": \"/cache/datasets/finance_accounting/r_f44dae53000a4a10a50f4944/records.json\",\n      \"package_discovery\": \"registry_request.GET /cache/datasets/ identified this package with job_id r_66595e81f687790d8d1523d6\",\n      \"content_sha256\": \"643e1ace60afa81dba32e1a2ea36f19f2b111ba952b6179b1ce2a90e9a9a31c2\",\n      \"business_source\": \"system/oracle_scm_cost_management/state.db\",\n      \"table_used\": \"work_order_cost_events\",\n      \"filter\": \"table = work_order_cost_events AND values.work_order_id = WO-2025-09-004\",\n      \"matching_rows\": 1,\n      \"cost_event_id\": \"CE-250904-0004\"\n    }\n  ],\n  \"analysis_services\": [\n    \"service_describe: assignment, read-only sources, answer schema and required output path\",\n    \"data_query.rows: exact work order match\",\n    \"data_query.rows: all cost events for the selected work order (one result)\",\n    \"data_query.rows: linked September cost period\",\n    \"data_query.datetime_difference: event creation minus Pending Close = 4920 seconds\"\n  ]\n}\n"
