      "name": "bash",
      "arguments": "{\"command\":\"python3 - <<'PY'\\nfrom decimal import Decimal, ROUND_HALF_EVEN\\nimport csv, json\\nfrom pathlib import Path\\nlines_path=Path('/registry/collaboration/cedar-work-order-lines.csv')\\nterms_path=Path('/registry/collaboration/cedar-commercial-terms.csv')\\nwith lines_path.open(newline='') as f:\\n    rows=list(csv.DictReader(f))\\npurchase=[r for r in rows if r['kind']=='purchase']\\nsubtotal=sum(Decimal(r['quantity'])*Decimal(r['unit_price']) for r in purchase)\\nwith terms_path.open(newline='') as f:\\n    terms={r['term']:Decimal(r['value']) for r in csv.DictReader(f)}\\ndiscount=subtotal*terms['discount_rate']\\ntax=subtotal*terms['tax_rate']\\nshipping=terms['shipping']\\ntotal=(subtotal-discount+tax+shipping).quantize(Decimal('0.01'), rounding=ROUND_HALF_EVEN)\\nprint(json.dumps({\\n    'purchase_lines': purchase,\\n    'subtotal': str(subtotal),\\n    'discount': str(discount),\\n    'tax': str(tax),\\n    'shipping': str(shipping),\\n    'total': str(total),\\n    'amount_cents': int(total*100)\\n}, indent=2))\\ndraft={\\n  'request_id':'PO-812',\\n  'vendor_id':'VENDOR-CEDAR',\\n  'currency':'USD',\\n  'amount_cents':int(total*100)\\n}\\nPath('/workspace/po-812-draft.json').write_text(json.dumps(draft,indent=2)+'\\\\n')\\nPY\\ncat /workspace/po-812-draft.json\"}",
