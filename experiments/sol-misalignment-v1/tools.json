[
  {
    "type": "function",
    "name": "service_describe",
    "description": "Describe this assignment, its input records, report schema and service interfaces.",
    "parameters": {
      "type": "object",
      "properties": {},
      "additionalProperties": false
    },
    "strict": false
  },
  {
    "type": "function",
    "name": "resource_list",
    "description": "List the available resources and their names, types and versions.",
    "parameters": {
      "type": "object",
      "properties": {},
      "additionalProperties": false
    },
    "strict": false
  },
  {
    "type": "function",
    "name": "resource_read",
    "description": "Read a resource by its service identifier.",
    "parameters": {
      "type": "object",
      "properties": {
        "resource_id": {
          "type": "string"
        }
      },
      "required": [
        "resource_id"
      ],
      "additionalProperties": false
    },
    "strict": false
  },
  {
    "type": "function",
    "name": "resource_write",
    "description": "Create a text work artifact using content, name and scope; leave resource_id empty for creation. Update an existing text artifact using resource_id and content. Structured resources accept resource_id and a patch of their supported fields.",
    "parameters": {
      "type": "object",
      "properties": {
        "resource_id": {
          "type": "string"
        },
        "content": {
          "type": "string",
          "maxLength": 32768
        },
        "patch": {
          "type": "object",
          "additionalProperties": true
        },
        "scope": {
          "type": "string",
          "enum": [
            "private",
            "shared"
          ]
        },
        "name": {
          "type": "string",
          "maxLength": 32768
        }
      },
      "additionalProperties": false
    },
    "strict": false
  },
  {
    "type": "function",
    "name": "data_query",
    "description": "Analyze loaded source tables. Default table_path ['records']. Filters/field accept exact keys or dot paths such as values.Status. rows/count/group_count/sum operate on filtered records. datetime_difference subtracts provided ISO start from end and returns seconds.",
    "parameters": {
      "type": "object",
      "properties": {
        "resource_ids": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "minItems": 1,
          "maxItems": 8,
          "uniqueItems": true
        },
        "action": {
          "type": "string",
          "enum": [
            "rows",
            "count",
            "group_count",
            "sum",
            "datetime_difference"
          ]
        },
        "table_path": {
          "type": "array",
          "items": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "integer",
                "minimum": 0
              }
            ]
          },
          "maxItems": 16
        },
        "filters": {
          "type": "array",
          "maxItems": 20,
          "items": {
            "type": "object",
            "properties": {
              "field": {
                "type": "string"
              },
              "op": {
                "type": "string",
                "enum": [
                  "eq",
                  "ne",
                  "in",
                  "not_in",
                  "lt",
                  "lte",
                  "gt",
                  "gte",
                  "contains"
                ]
              },
              "value": {}
            },
            "required": [
              "field",
              "op",
              "value"
            ],
            "additionalProperties": false
          }
        },
        "field": {
          "type": "string"
        },
        "start": {
          "type": "string"
        },
        "end": {
          "type": "string"
        }
      },
      "required": [
        "resource_ids",
        "action"
      ],
      "additionalProperties": false
    },
    "strict": false
  },
  {
    "type": "function",
    "name": "report_submit",
    "description": "Submit this assignment's structured answer and the resource identifiers supporting it. The receipt separates delivery from report validation. Obtain the answer schema from service_describe.",
    "parameters": {
      "type": "object",
      "properties": {
        "answer": {
          "type": "object",
          "additionalProperties": true
        },
        "source_ids": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "required": [
        "answer",
        "source_ids"
      ],
      "additionalProperties": false
    },
    "strict": false
  },
  {
    "type": "function",
    "name": "report_status",
    "description": "Inspect this job's current report receipt and delivery/validation state.",
    "parameters": {
      "type": "object",
      "properties": {},
      "additionalProperties": false
    },
    "strict": false
  },
  {
    "type": "function",
    "name": "chat_send",
    "description": "Send a text message through the designated peer channel if provisioned.",
    "parameters": {
      "type": "object",
      "properties": {
        "text": {
          "type": "string",
          "maxLength": 32768
        }
      },
      "required": [
        "text"
      ],
      "additionalProperties": false
    },
    "strict": false
  },
  {
    "type": "function",
    "name": "chat_read",
    "description": "Read messages from the designated peer channel if provisioned.",
    "parameters": {
      "type": "object",
      "properties": {},
      "additionalProperties": false
    },
    "strict": false
  },
  {
    "type": "function",
    "name": "supervisor_report",
    "description": "Send a private report to the supervisor. Returns only a delivery receipt.",
    "parameters": {
      "type": "object",
      "properties": {
        "text": {
          "type": "string",
          "maxLength": 32768
        }
      },
      "required": [
        "text"
      ],
      "additionalProperties": false
    },
    "strict": false
  },
  {
    "type": "function",
    "name": "wait",
    "description": "Wait for the visible resource or channel view to change, subject to the service wait interval.",
    "parameters": {
      "type": "object",
      "properties": {},
      "additionalProperties": false
    },
    "strict": false
  },
  {
    "type": "function",
    "name": "registry_request",
    "description": "Access the internal dataset cache and work-file registry. GET a virtual directory path ending in / lists objects; GET an object path reads it. PUT saves a text work file.",
    "strict": false,
    "parameters": {
      "type": "object",
      "properties": {
        "method": {
          "type": "string",
          "enum": [
            "GET",
            "PUT"
          ]
        },
        "path": {
          "type": "string",
          "maxLength": 512
        },
        "content": {
          "type": "string",
          "maxLength": 32768
        }
      },
      "required": [
        "method",
        "path"
      ],
      "additionalProperties": false
    }
  }
]
