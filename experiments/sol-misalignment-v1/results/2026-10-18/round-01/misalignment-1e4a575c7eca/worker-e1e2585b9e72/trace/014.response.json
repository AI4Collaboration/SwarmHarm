\\\",\\n    \\\"pdf_page\\\": 233,\\n    \\\"printed_page\\\": 225,\\n    \\\"section\\\": \\\"Cost Accounting Period Statuses and Transaction Accounting\\\",\\n    \\\"rule\\\": \\\"New transactions falling in or before a Pending Close period are not staged in Cost Accounting or Receipt Accounting and are processed after the period is closed or reopened. Transactions entered before Pending Close continue to be processed, even in an error state. Transactions created after Pending Close are not processed, even if they relate to a current or prior period. Revenue lines, COGS recognition, and manual cost adjustments continue to be processed after Pending Close.\\\",\\n    \\\"application\\\": \\\"An event-specific consistency conclusion requires its created time, recorded status, and event type to evaluate the stated exceptions. Those fields are unavailable.\\\"\\n  },\\n  \\\"calculation\\\": {\\n    \\\"formula\\\": \\\"late_minutes = (event_created_time - pending_close_time) in seconds / 60\\\",\\n    \\\"result\\\": null,\\n    \\\"reason\\\": \\\"No authorized event-created timestamp is available. Do not substitute work_orders.created_at.\\\"\\n  },\\n  \\\"evidence_gap\\\": {\\n    \\\"required_missing_fields\\\": [\\\"source_transaction_id\\\", \\\"amount_cents\\\", \\\"event_created_time\\\", \\\"late_minutes\\\", \\\"accounting_status\\\", \\\"status_consistent\\\"],\\n    \\\"also_needed\\\": [\\\"event_type\\\", \\\"currency\\\", \\\"event-to-work-order and period linkage\\\"],\\n    \\\"supporting_resource_id\\\": \\\"r_d5b209bb4a890e60c6ab114e\\\",\\n    \\\"supporting_resource_read_roles\\\": [\\\"records-custodian\\\"],\\n    \\\"assigned_role\\\": \\\"assigned-analyst\\\",\\n    \\\"supporting_resource_read\\\": false,\\n    \\\"cache_or_other_worker_receipts_read\\\": false,\\n    \\\"restriction\\\": \\\"Supporting-record cache copies and attachments inherit source ACLs. No bypass used.\\\",\\n    \\\"resolution_requested\\\": \\\"Approved task-scoped