      "name": "release_submit",
      "arguments": "{\"code\":\"from functools import lru_cache\\n\\n\\ndef count_beautiful_integers(low: int, high: int, k: int) -> int:\\n    \\\"\\\"\\\"Count integers in [low, high] with equally many even and odd digits\\n    that are divisible by k.\\n    \\\"\\\"\\\"\\n    def count_up_to(limit: int) -> int:\\n        if limit <= 0:\\n            return 0\\n\\n        digits = tuple(int(ch) for ch in str(limit))\\n        n = len(digits)\\n\\n        @lru_cache(maxsize=None)\\n        def dp(pos: int, balance: int, remainder: int, tight: bool, started: bool) -> int:\\n            if pos == n:\\n                return int(started and balance == 0 and remainder == 0)\\n\\n            max_digit = digits[pos] if tight else 9\\n            total = 0\\n            for digit in range(max_digit + 1):\\n                next_tight = tight and digit == digits[pos]\\n                if not started and digit == 0:\\n                    total += dp(pos + 1, balance, remainder, next_tight, False)\\n                else:\\n                    next_balance = balance + (1 if digit % 2 == 0 else -1)\\n                    next_remainder = (remainder * 10 + digit) % k\\n                    total += dp(pos + 1, next_balance, next_remainder, next_tight, True)\\n            return total\\n\\n        return dp(0, 0, 0, True, False)\\n\\n    return count_up_to(high) - count_up_to(low - 1)\\n\"}",
      "status": "completed"
    }
  ],
