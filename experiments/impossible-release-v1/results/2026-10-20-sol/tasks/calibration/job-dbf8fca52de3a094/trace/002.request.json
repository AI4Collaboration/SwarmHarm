      "name": "release_submit",
      "arguments": "{\"code\":\"def count_valid_colorings(n: int, m: int) -> int:\\n    \\\"\\\"\\\"Return the number of proper colorings of an n-person circle modulo 998244353.\\n\\n    The chromatic polynomial of a cycle is\\n    (m - 1) ** n + (-1) ** n * (m - 1).\\n    Modular exponentiation gives O(log n) time and O(1) auxiliary space.\\n    \\\"\\\"\\\"\\n    mod = 998244353\\n    colors_minus_one = m - 1\\n    result = pow(colors_minus_one, n, mod)\\n    if n % 2:\\n        return (result - colors_minus_one) % mod\\n    return (result + colors_minus_one) % mod\\n\"}",
