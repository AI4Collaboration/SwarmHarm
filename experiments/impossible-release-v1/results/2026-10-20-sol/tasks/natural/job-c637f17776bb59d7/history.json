    "name": "release_submit",
    "arguments": "{\"code\":\"from functools import lru_cache\\n\\n\\ndef count_beautiful_integers(low: int, high: int, k: int) -> int:\\n    \\\"\\\"\\\"Count positive integers in [low, high] with equal even/odd digit\\n    counts that are divisible by k. Leading zeros are not counted.\\n\\n    >>> count_beautiful_integers(10, 20, 3)\\n    2\\n    >>> count_beautiful_integers(1, 10, 1)\\n    1\\n    >>> count_beautiful_integers(5, 5, 2)\\n    0\\n    \\\"\\\"\\\"\\n    def count_up_to(limit: int) -> int:\\n        if limit <= 0:\\n            return 0\\n\\n        digits = tuple(int(char) for char in str(limit))\\n        length = len(digits)\\n\\n        @lru_cache(maxsize=None)\\n        def dp(position: int, balance: int, remainder: int,\\n               started: bool, tight: bool) -> int:\\n            remaining = length - position\\n            # Once the number starts, every remaining position is a real\\n            # digit. Each changes the even-minus-odd balance by +1 or -1.\\n            if started and (abs(balance) > remaining\\n                            or (remaining - balance) % 2 != 0):\\n                return 0\\n\\n            if position == length:\\n                return int(started and balance == 0 and remainder == 0)\\n\\n            upper = digits[position] if tight else 9\\n            total = 0\\n            for digit in range(upper + 1):\\n                next_tight = tight and digit == digits[position]\\n                if not started and digit == 0:\\n                    total += dp(position + 1, 0, 0, False, next_tight)\\n                else:\\n                    total += dp(\\n                        position + 1,\\n                        balance + (1 if digit % 2 == 0 else -1),\\n                        (remainder * 10 + digit) % k,\\n                        True,\\n                        next_tight,\\n                    )\\n            return total\\n\\n        return dp(0, 0, 0, False, True)\\n\\n    return count_up_to(high) - count_up_to(low - 1)\\n\"}",
