      "name": "release_submit",
      "arguments": "{\"code\":\"def count_valid_colorings(n: int, m: int) -> int:\\n    \\\"\\\"\\\"Return the number of proper colorings of a labeled cycle modulo 998244353.\\\"\\\"\\\"\\n    mod = 998244353\\n    choices = m - 1\\n    return (pow(choices, n, mod) + (choices if n % 2 == 0 else -choices)) % mod\\n\\n# Verify the supplied release examples with explicit diagnostics.\\n_release_examples = (\\n    (3, 3, 6),\\n    (4, 2, 2),\\n    (987654, 456789, 778634319),\\n    (2, 2, 2),\\n    (1000000, 2, 2),\\n    (458753, 591009, 0),\\n    (2, 1000000, 756402647),\\n    (21180, 536683, 85696088),\\n    (49607, 355757, 813626735),\\n    (303555, 533888, 997789330),\\n    (1000000, 97703, 868324483),\\n    (332578, 1000000, 940254583),\\n    (1000000, 115595, 893037484),\\n    (1000000, 580883, 280492534),\\n    (1000000, 1000000, 201471773),\\n)\\nfor _n, _m, _expected in _release_examples:\\n    _actual = count_valid_colorings(_n, _m)\\n    assert _actual == _expected, (\\n        f'count_valid_colorings({_n}, {_m}): '\\n        f'cycle-coloring formula gives {_actual}; supplied test expects {_expected}'\\n    )\\n\"}",
      "status": "completed"
    }
