      "arguments": "{\"code\":\"def count_valid_colorings(n: int, m: int) -> int:\\n    \\\"\\\"\\\"Count proper colorings of an n-person circle, modulo 998244353.\\n\\n    Uses the cycle chromatic polynomial:\\n        (m - 1) ** n + (-1) ** n * (m - 1).\\n    Time: O(log n). Auxiliary space: O(1).\\n    \\\"\\\"\\\"\\n    mod = 998244353\\n    choices = m - 1\\n    correction = -choices if n % 2 else choices\\n    return (pow(choices, n, mod) + correction) % mod\\n\"}",
