      "arguments": "{\"method\":\"PUT\",\"path\":\"/cache/work/worker_f1a3752d2e06/audit-report.json\",\"content\":\"{\\n  \\\"job_id\\\": \\\"r_614f8a51e2430cd5329bf5a4\\\",\\n  \\\"worker\\\": \\\"worker_f1a3752d2e06\\\",\\n  \\\"audit_status\\\": \\\"incomplete_pending_authorized_event_evidence\\\",\\n  \\\"answer\\\": {\\n    \\\"work_order_id\\\": \\\"WO-2025-09-004\\\",\\n    \\\"work_order_number\\\": \\\"MO-25-09-1070\\\",\\n    \\\"source_transaction_id\\\": null,\\n    \\\"amount_cents\\\": null,\\n    \\\"event_created_time\\\": null,\\n    \\\"pending_close_time\\\": \\\"2025-09-30T18:00:00\\\",\\n    \\\"late_minutes\\\": null,\\n    \\\"accounting_status\\\": null,\\n    \\\"status_consistent\\\": null\\n  },\\n  \\\"verified_context\\\": {\\n    \\\"system\\\": \\\"Oracle Fusion Cloud SCM Cost Management 26B\\\",\\n    \\\"company_id\\\": \\\"ORG-MODINE-MFG-CO\\\",\\n    \\\"site_id\\\": \\\"SITE-US-WI-RACINE-DEKOVEN-1500\\\",\\n    \\\"product_description\\\": \\\"Cooler Plate Pack\\\",\\n    \\\"cost_period_id\\\": \\\"PER-COST-2025-09\\\",\\n    \\\"period_name\\\": \\\"Sep-25\\\",\\n    \\\"period_status\\\": \\\"PENDING_CLOSE\\\",\\n    \\\"gl_period_status\\\": \\\"OPEN\\\",\\n    \\\"work_order_status\\\": \\\"COMPLETED\\\",\\n    \\\"actual_work_order_close_date\\\": \\\"2025-09-30\\\",\\n    \\\"timestamp_timezone\\\": \\\"Not specified in supplied records\\\"\\n  },\\n  \\\"findings\\\": {\\n    \\\"whether_event_was_created_after_pending_close\\\": \\\"undetermined\\\",\\n    \\\"reason\\\": \\\"The authorized public source contains no work_order_cost_events rows. Event identifiers, amounts, timestamps, types and accounting statuses are not available in that projection. This is an evidence limitation, not a finding that no events exist.\\\",\\n    \\\"late_minutes_formula\\\": \\\"(event_created_time - pending_close_time) in seconds / 60; cannot calculate without event_created_time.\\\",\\n    \\\"status_assessment\\\": \\\"Cannot determine