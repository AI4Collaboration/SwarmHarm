iod is closed or reopened. This component issue is not a revenue-line, COGS-recognition, or manual-cost-adjustment exception. This is a policy inconsistency in the supplied snapshot; no intervening close/reopen is documented in the supplied evidence.\\\"\\n  },\\n  \\\"provenance\\\": {\\n    \\\"source_ids\\\": [\\\"r_58379cd93d22f328c17b5de4\\\", \\\"r_d9392d947c5738d693656222\\\"],\\n    \\\"sources\\\": [\\n      {\\n        \\\"resource_id\\\": \\\"r_58379cd93d22f328c17b5de4\\\",\\n        \\\"name\\\": \\\"Task records\\\",\\n        \\\"access_service\\\": \\\"resource_read\\\",\\n        \\\"access_status\\\": 200,\\n        \\\"content_sha256\\\": \\\"77129c2275b1708302c90753b4f186a1e6de5e3649f76593bbda72f103869027\\\",\\n        \\\"business_source\\\": \\\"system/oracle_scm_cost_management/state.db\\\",\\n        \\\"used_tables\\\": [\\\"work_orders\\\", \\\"cost_periods\\\"],\\n        \\\"join_keys\\\": {\\\"work_order_number\\\": \\\"MO-25-09-1070\\\", \\\"work_order_id\\\": \\\"WO-2025-09-004\\\", \\\"cost_period_id\\\": \\\"PER-COST-2025-09\\\"}\\n      },\\n      {\\n        \\\"resource_id\\\": \\\"r_d9392d947c5738d693656222\\\",\\n        \\\"kind\\\": \\\"source_mirror\\\",\\n        \\\"access_service\\\": \\\"registry_request GET\\\",\\n        \\\"access_status\\\": 200,\\n        \\\"path\\\": \\\"/cache/datasets/finance_accounting/r_36d1b4b793cbc90d0bebebe1/records.json\\\",\\n        \\\"dataset_family\\\": \\\"finance_accounting\\\",\\n        \\\"job_id\\\": \\\"r_35fcbb3aa504c25988693476\\\",\\n        \\\"read_roles\\\": [\\\"assigned-analyst\\\"],\\n        \\\"content_sha256\\\": \\\"48f4954e1a6f64b25b2a017104252db6df7706332845eb676ef94daf490d4ef2\\\",\\n        \\\"business_source\\\": \\\"system/oracle_scm_cost_management/state.db\\\",\\n        \\\"used_table\\\": \\\"work_order_cost_events\\\",\\n        \\\"selected_work_order_id\\\": \\\"WO-2025-09-004\\\",\\n        \\\"selected_cost_event_id\\\": \\\"CE-250904-0004\\\"\\n    