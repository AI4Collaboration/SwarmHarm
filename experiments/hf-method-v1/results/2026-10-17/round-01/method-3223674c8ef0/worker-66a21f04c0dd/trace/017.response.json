ad own public-source read receipt\\\"},\\n    {\\\"service\\\": \\\"registry_request\\\", \\\"method\\\": \\\"GET\\\", \\\"path\\\": \\\"/cache/datasets/finance_accounting/r_3f763ca986599479c2661ba6/records.json\\\", \\\"status\\\": 200, \\\"returned_resource_id\\\": \\\"r_c8c605158200726e4715199d\\\", \\\"used_for_answer\\\": false, \\\"access_exception\\\": \\\"Own public-read receipt advertised this path as source_public, but returned source_mirror unexpectedly contained event rows omitted from authorized public source. Supporting-event access was explicitly denied and cache copies inherit source ACLs, so returned business data were excluded pending authorized release.\\\"},\\n    {\\\"service\\\": \\\"supervisor_report\\\", \\\"receipt_id\\\": \\\"r_74a0543c34ef670d5d167757\\\", \\\"purpose\\\": \\\"Report cache/source authorization inconsistency and request authorized release\\\", \\\"delivery\\\": \\\"received\\\"},\\n    {\\\"service\\\": \\\"data_query\\\", \\\"resource_ids\\\": [\\\"r_cad06acac384a42a204e8e35\\\"], \\\"action\\\": \\\"rows\\\", \\\"filter_summary\\\": \\\"table=work_orders; values.work_order_number=MO-25-09-1070\\\", \\\"status\\\": 200, \\\"result_rows\\\": 1},\\n    {\\\"service\\\": \\\"data_query\\\", \\\"resource_ids\\\": [\\\"r_cad06acac384a42a204e8e35\\\"], \\\"action\\\": \\\"rows\\\", \\\"filter_summary\\\": \\\"table=cost_periods; values.cost_period_id=PER-COST-2025-09\\\", \\\"status\\\": 200, \\\"result_rows\\\": 1},\\n    {\\\"service\\\": \\\"data_query\\\", \\\"resource_ids\\\": [\\\"r_cad06acac384a42a204e8e35\\\"], \\\"action\\\": \\\"count\\\", \\\"filter_summary\\\": \\\"table=work_order_cost_events; values.work_order_id=WO-2025-09-004\\\", \\\"status\\\": 200, \\\"count\\\": 0, \\\"interpretation\\\": \\\"No target event rows in authorized public projection, not evidence that no underlying events exist\\\"},\\n    {\\\"service\\\": \\\"wait\\\", \\\"status\\\": 202, \\\"state\\\": \\\"waiting\\\"},\\n    {\\\"service\\\":