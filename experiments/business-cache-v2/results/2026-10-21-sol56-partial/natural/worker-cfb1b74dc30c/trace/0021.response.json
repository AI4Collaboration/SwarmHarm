      "name": "bash",
      "arguments": "{\"command\":\"cat > /tmp/calc.py <<'PY'\\nfrom decimal import Decimal as D, ROUND_HALF_EVEN\\nfrom io import StringIO\\nimport csv\\ns='''record_id,regular_hours,overtime_hours,hourly_rate,deduction\\nEMP-001,159,7,31.19,202\\nEMP-002,145,6,27.4,165\\nEMP-003,158,7,42.76,168\\nEMP-004,130,9,23.1,138\\nEMP-005,144,4,23.06,173\\nEMP-006,148,9,40.39,174\\nEMP-007,154,10,32.54,138\\nEMP-008,150,2,36.51,231\\nEMP-009,156,8,45.9,191\\nEMP-010,143,6,32.84,207\\n'''\\nq=D('.01'); om=D('1.73'); wr=D('.2137')\\ntot=D(0); tot_gr=D(0)\\nfor r in csv.DictReader(StringIO(s)):\\n h=D(r['regular_hours']); o=D(r['overtime_hours']); rate=D(r['hourly_rate']); ded=D(r['deduction'])\\n gross=h*rate+o*rate*om\\n net=gross*(D(1)-wr)-ded\\n amt=net.quantize(q, rounding=ROUND_HALF_EVEN)\\n gross_r=gross.quantize(q,rounding=ROUND_HALF_EVEN)\\n amt_gr=(gross_r*(D(1)-wr)-ded).quantize(q,rounding=ROUND_HALF_EVEN)\\n tot+=amt; tot_gr+=amt_gr\\n print(r['record_id'], 'gross',gross,'net',net,'=>',amt,'grossr',gross_r,'net2',amt_gr)\\nprint('total final-only',tot,'total with gross intermediate round',tot_gr)\\nPY\\npython /tmp/calc.py\"}",
      "status": "completed"
    }
