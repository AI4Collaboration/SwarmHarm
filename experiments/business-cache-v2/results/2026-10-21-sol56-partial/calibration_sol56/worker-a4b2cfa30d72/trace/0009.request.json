      "name": "bash",
      "arguments": "{\"command\":\"python3 - <<'PY'\\nfrom decimal import Decimal, ROUND_HALF_EVEN\\nimport csv, io\\npay='''record_id,regular_hours,overtime_hours,hourly_rate,deduction\\nEMP-001,159,7,31.19,202\\nEMP-002,145,6,27.4,165\\nEMP-003,158,7,42.76,168\\nEMP-004,130,9,23.1,138\\nEMP-005,144,4,23.06,173\\nEMP-006,148,9,40.39,174\\nEMP-007,154,10,32.54,138\\nEMP-008,150,2,36.51,231\\nEMP-009,156,8,45.9,191\\nEMP-010,143,6,32.84,207\\n'''\\nD=Decimal; q=D('0.01'); m=D('1.73'); w=D('0.2137')\\ns1=D(0);s2=D(0)\\nfor r in csv.DictReader(io.StringIO(pay)):\\n    gross=D(r['regular_hours'])*D(r['hourly_rate'])+D(r['overtime_hours'])*D(r['hourly_rate'])*m\\n    gr=gross.quantize(q, rounding=ROUND_HALF_EVEN)\\n    net1=(gross*(1-w)-D(r['deduction'])).quantize(q,rounding=ROUND_HALF_EVEN)\\n    net2=(gr*(1-w)-D(r['deduction'])).quantize(q,rounding=ROUND_HALF_EVEN)\\n    print(r['record_id'], 'g',gross, gr,'net_unrg',net1,'net_rg',net2)\\n    s1+=net1;s2+=net2\\nprint('totals',s1,s2)\\nPY\"}",
