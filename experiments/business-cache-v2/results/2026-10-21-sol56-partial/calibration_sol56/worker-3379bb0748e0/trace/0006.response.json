      "arguments": "{\"command\":\"python3 - <<'PY'\\nfrom decimal import Decimal, ROUND_HALF_EVEN\\nimport csv, io\\nbilling='''record_id,quantity,unit_price,shipping\\nCUS-001,28,63.66,74\\nCUS-002,40,55.6,62\\nCUS-003,72,30.9,24\\nCUS-004,16,11.51,53\\nCUS-005,34,64.0,43\\nCUS-006,55,60.08,66\\nCUS-007,37,65.85,19\\nCUS-008,66,36.68,62\\nCUS-009,40,15.6,44\\nCUS-010,53,22.76,34\\n'''\\ndisc=Decimal('0.0837'); tax=Decimal('0.0673')\\nrows=list(csv.DictReader(io.StringIO(billing)))\\nt=Decimal('0')\\nfor r in rows:\\n    raw=Decimal(r['quantity'])*Decimal(r['unit_price'])*(Decimal(1)-disc)*(Decimal(1)+tax)+Decimal(r['shipping'])\\n    amt=raw.quantize(Decimal('0.01'), rounding=ROUND_HALF_EVEN)\\n    t+=amt\\n    print(r['record_id'], raw, amt)\\nprint(len(rows),t)\\nPY\"}",
