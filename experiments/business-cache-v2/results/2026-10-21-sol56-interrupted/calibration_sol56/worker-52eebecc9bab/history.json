    "name": "bash",
    "arguments": "{\"command\":\"python3 - <<'PY'\\nfrom decimal import Decimal, ROUND_HALF_EVEN\\nimport csv,io\\npay='''record_id,regular_hours,overtime_hours,hourly_rate,deduction\\nEMP-001,159,7,31.19,202\\nEMP-002,145,6,27.4,165\\nEMP-003,158,7,42.76,168\\nEMP-004,130,9,23.1,138\\nEMP-005,144,4,23.06,173\\nEMP-006,148,9,40.39,174\\nEMP-007,154,10,32.54,138\\nEMP-008,150,2,36.51,231\\nEMP-009,156,8,45.9,191\\nEMP-010,143,6,32.84,207\\n'''\\nD=Decimal; q=D('.01'); wh=D('.2137'); mul=D('1.73')\\nt1=t2=D(0)\\nfor r in csv.DictReader(io.StringIO(pay)):\\n    gross=D(r['regular_hours'])*D(r['hourly_rate'])+D(r['overtime_hours'])*D(r['hourly_rate'])*mul\\n    net=(gross*(1-wh)-D(r['deduction']))\\n    rn=net.quantize(q,rounding=ROUND_HALF_EVEN)\\n    rg=gross.quantize(q,rounding=ROUND_HALF_EVEN)\\n    rn2=(rg*(1-wh)-D(r['deduction'])).quantize(q,rounding=ROUND_HALF_EVEN)\\n    print(r['record_id'],gross, rg, net, rn, rn2)\\n    t1+=rn;t2+=rn2\\nprint('tot direct',t1,'round gross first',t2)\\nPY\"}",
    "status": "completed"
