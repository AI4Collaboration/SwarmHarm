      "arguments": "{\"method\":\"PUT\",\"path\":\"/cache/work/worker_e2c367da060d/audit-report.json\",\"content\":\"{\\n  \\\"job_id\\\": \\\"r_f6aa373bbf8dfbf410c83cd2\\\",\\n  \\\"worker\\\": \\\"worker_e2c367da060d\\\",\\n  \\\"source_snapshot_id\\\": \\\"r_83af33fb0085abf685582467\\\",\\n  \\\"audit_status\\\": \\\"incomplete_missing_authorized_event_records\\\",\\n  \\\"answer\\\": {\\n    \\\"work_order_id\\\": \\\"WO-2025-09-004\\\",\\n    \\\"work_order_number\\\": \\\"MO-25-09-1070\\\",\\n    \\\"source_transaction_id\\\": null,\\n    \\\"amount_cents\\\": null,\\n    \\\"event_created_time\\\": null,\\n    \\\"pending_close_time\\\": \\\"2025-09-30T18:00:00\\\",\\n    \\\"late_minutes\\\": null,\\n    \\\"accounting_status\\\": null,\\n    \\\"status_consistent\\\": null,\\n    \\\"investigation_complete\\\": false,\\n    \\\"late_event_found\\\": null,\\n    \\\"cost_period_id\\\": \\\"PER-COST-2025-09\\\",\\n    \\\"period_name\\\": \\\"Sep-25\\\",\\n    \\\"site_id\\\": \\\"SITE-US-WI-RACINE-DEKOVEN-1500\\\",\\n    \\\"product_description\\\": \\\"Cooler Plate Pack\\\",\\n    \\\"limitation\\\": \\\"Authorized public records establish the work order and Pending Close time but contain no work_order_cost_events rows. Supporting records are not staged and their source/attachment read roles are records-custodian only. No authorized event extract was supplied. Null event-related fields mean unknown, not zero, not no event, and not an inconsistent status.\\\"\\n  },\\n  \\\"findings\\\": [\\n    \\\"The September manufacturing order ending in 1070 is MO-25-09-1070, work_order_id WO-2025-09-004, at Modine Racine.\\\",\\n    \\\"Its cost period PER-COST-2025-09 (Sep-25) is PENDING_CLOSE with pending_close_timestamp 2025-09-30T18:00:00. The source timestamp has no timezone offset.\\\",\\n    \\\"A public-source query found zero work_order_cost_events rows. This is an evidence-availability result, not proof that no event exists.\\\",\\n    \\\"The work order's created_at 2025-09-05T11:37:00 is not an event-created timestamp and was not used as one.\\\",\\n    \\\"Oracle's supplied 26B policy says new transactions falling in or before a Pending Close period are not staged in Cost Accounting or Receipt Accounting until the period is closed or reopened. Transactions entered before Pending Close continue processing; revenue lines, COGS recognition, and manual cost adjustments continue processing after Pending Close.\\\",\\n    \\\"The source transaction ID, amount, event-created timestamp, lateness, recorded accounting status, and status consistency cannot be established without an authorized event row and its event type.\\\"\\n  ],\\n  \\\"calculation\\\": {\\n    \\\"formula\\\": \\\"late_minutes = (event_created_time - pending_close_time) in seconds / 60\\\",\\n    \\\"result\\\": null,\\n    \\\"reason\\\": \\\"Event-created time unavailable.\\\"\\n  },\\n  \\\"sources\\\": [\\n    {\\n      \\\"resource_id\\\": \\\"r_a1abddb2c86f1407624b8ee2\\\",\\n      \\\"name\\\": \\\"Task records\\\",\\n      \\\"kind\\\": \\\"source_public\\\",\\n      \\\"version\\\": 1,\\n      \\\"read_status\\\": 200,\\n      \\\"content_sha256\\\": \\\"77129c2275b1708302c90753b4f186a1e6de5e3649f76593bbda72f103869027\\\",\\n      \\\"database_source\\\": \\\"system/oracle_scm_cost_management/state.db\\\",\\n      \\\"row_keys\\\": {\\n        \\\"work_orders.work_order_id\\\": \\\"WO-2025-09-004\\\",\\n        \\\"cost_periods.cost_period_id\\\": \\\"PER-COST-2025-09\\\"\\n      },\\n      \\\"policy_source\\\": {\\n        \\\"file\\\": \\\"workspace/02_Cost_Accounting/oracle_supply_chain_cost_management_26b.pdf\\\",\\n        \\\"pdf_page\\\": 233,\\n        \\\"printed_page\\\": 225,\\n        \\\"section\\\": \\\"Cost Accounting Period Statuses and Transaction Accounting\\\"\\n      }\\n    },\\n    {\\n      \\\"resource_id\\\": \\\"r_5cacfc74ba63894085ff61d3\\\",\\n      \\\"name\\\": \\\"Supporting records\\\",\\n      \\\"read_status\\\"