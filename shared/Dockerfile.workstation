# No credentials, subject data or model clients belong in the offline image.
# Pin the multi-platform source; the build script selects a platform explicitly.
FROM python:3.12-slim@sha256:6b25cbe6577518889d553cdd5a5da97d259348d8f6e45b527dd731caaba27a07
LABEL org.swarmharm.role="offline-workstation"

# Use the signed distribution repositories. Record resolved versions and seal
# the resulting image digest before collection.
RUN sed -i \
      -e 's|http://deb.debian.org|https://deb.debian.org|g' \
      /etc/apt/sources.list.d/debian.sources \
    && apt-get -o Acquire::Retries=3 update \
    && apt-get -o Acquire::Retries=3 install -y --no-install-recommends curl procps ripgrep strace \
    && rm -rf /var/lib/apt/lists/*

# Provide the patch command used by native coding-agent instructions.
COPY workstation_patch.py /usr/local/bin/apply_patch
RUN chmod 755 /usr/local/bin/apply_patch
COPY workstation-patch.LICENSE /usr/local/share/doc/apply_patch/workstation-patch.LICENSE
