#!/usr/bin/env bash
# Install native harnesses and prepare a local offline workstation. No model calls.
set -euo pipefail
repo=$(CDPATH= cd -- "$(dirname -- "$0")/.." && pwd)
state=${SWARMHARM_READINESS:-"$repo/../eval-readiness"}
mkdir -p "$state"
state=$(CDPATH= cd -- "$state" && pwd)
case "$state/" in "$repo/"*) echo 'Runtime state must be outside the repository' >&2; exit 1;; esac
for cmd in python3.12 node npm docker; do command -v "$cmd" >/dev/null || { echo "Install $cmd first" >&2; exit 1; }; done
node -e 'const [a,b]=process.versions.node.split(".").map(Number); if(a<22||(a===22&&b<19))process.exit(1)' || { echo 'Node >=22.19 required' >&2; exit 1; }
docker info >/dev/null
runtime=${SWARMHARM_HARBOR_ENV:-"$state/harbor-0.24.0"}
if [ ! -x "$runtime/bin/python" ]; then
  python3.12 -m venv "$runtime"
fi
if ! "$runtime/bin/python" -m pip --version >/dev/null 2>&1; then
  "$runtime/bin/python" -m ensurepip --upgrade
fi
"$runtime/bin/python" -m pip install -r "$repo/shared/python-requirements.txt"
harnesses=" codex ${SWARMHARM_HARNESSES:-} $* "
case "$harnesses" in *" all "*) harnesses=" codex claude pi ";; esac
for adapter in codex claude pi; do
  case "$harnesses" in *" $adapter "*) npm ci --prefix "$repo/shared/$adapter" --no-fund --no-audit;; esac
done
for adapter in $harnesses; do
  case "$adapter" in codex|claude|pi) ;; *) echo "Unknown harness: $adapter (use codex, claude, pi or all)" >&2; exit 1;; esac
done
case "$(uname -m)" in arm64|aarch64) platform=linux/arm64;; *) platform=linux/amd64;; esac
provenance="$state/workstation-$(date +%Y%m%dT%H%M%S)-$$.json"
"$runtime/bin/python" "$repo/scripts/build-workstation-image" --platform "$platform" --output "$provenance"
image=$("$runtime/bin/python" -c 'import json,sys;print(json.load(open(sys.argv[1]))["image"])' "$provenance")
{
  printf 'export SWARMHARM_HARBOR_ENV=%q\n' "$runtime"
  printf 'export SWARMHARM_NATIVE_CODEX=%q\n' "$repo/shared/codex/node_modules/.bin/codex"
  printf 'export SWARMHARM_DOCKER_IMAGE=%q\n' "$image"
  printf 'export SWARMHARM_SANDBOX=docker\n'
} > "$state/swarmharm-local.env"
hook=$(git -C "$repo" rev-parse --git-path hooks/pre-push 2>/dev/null || true)
if [ -n "$hook" ]; then
  case "$hook" in /*) ;; *) hook="$repo/$hook";; esac
  if [ ! -e "$hook" ] || grep -q 'SwarmForm repo hook' "$hook" \
      || grep -q 'Keep the existing global hook' "$hook"; then
    mkdir -p "$(dirname "$hook")"
    install -m 0755 "$repo/scripts/pre-push" "$hook"
  else
    printf 'Existing pre-push hook left unchanged; install %s/scripts/pre-push manually if desired.\n' "$repo"
  fi
fi
printf 'Ready. Source %s/swarmharm-local.env before running. No model requests were made.\n' "$state"
