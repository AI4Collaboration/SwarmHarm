#!/usr/bin/env python3
"""Print the current study input catalog, using the same builders as the runners."""
import argparse
import json
from pathlib import Path
import sys

ROOT = Path(__file__).resolve().parents[1]


def swarmform(population):
    sys.path.insert(0, str(ROOT / "rollouts"))
    from swarmform.formation_inputs import ACTIVE_TASKS, SPECIAL_CASE, build, build_intended

    rows = []
    for task in (*sorted(ACTIVE_TASKS), SPECIAL_CASE):
        openings = {}
        for channel in ("direct", "filesystem", "mapped_memory", "socket"):
            visible, _, manifest = (build_intended(task, population) if channel == "direct"
                                    else build(task, channel, population))
            questions = {files["/workspace/task.md"] for files in visible["startup"].values()}
            if len(questions) != 1:
                raise ValueError(f"Conflicting task briefs in {task}/{channel}")
            current = questions.pop()
            if openings and current != question:
                raise ValueError(f"Task brief differs across settings for {task}")
            question = current
            openings[channel] = manifest["worker_visible_sha256"]
        rows.append({"id": task, "set": "special" if task == SPECIAL_CASE else "main",
                     "task_type": manifest["task_class_id"], "task_md": question,
                     "opening_sha256": openings})
    return rows


def swarmharm(population):
    sys.path[:0] = [str(ROOT / "swarmharm"), str(ROOT / "shared")]
    from phase2 import mechanism_inputs, unified_delivery as environment
    from phase2.world_config import components

    ledger = json.loads((ROOT / "swarmharm/docs/research/mechanism-input-status.json").read_bytes())
    rows = []
    for slot in sorted(ledger["inputs"], key=lambda x: (x["domain"], x["mechanism"])):
        if slot["current_input_validation"] not in ("reviewed_positive", "path_validated"):
            continue
        domain, mechanism = slot["domain"], slot["mechanism"]
        workload = slot.get("selected_workload") or domain
        world = mechanism_inputs.configuration(mechanism, workload, population=population)
        delivery, _ = components(world)
        assignments = environment.plan_for(environment.cohort.actor_ids(population), domain=workload)
        questions = {}
        for actor, assignment in assignments.items():
            assignment.update(binding_preset=mechanism_inputs.preset_for(mechanism),
                              delivery_config=delivery, world_config=world,
                              continuous_workflow=True, work_entries_only=True)
            questions[actor] = environment.task(assignment)
        rows.append({"domain": domain, "configuration": mechanism, "workload": workload,
                     "environment_sha256": environment.digest(world), "assignments": questions})
    return rows


if __name__ == "__main__":
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument("study", choices=("swarmform", "swarmharm"))
    parser.add_argument("--population", type=int, default=4)
    args = parser.parse_args()
    builder = swarmform if args.study == "swarmform" else swarmharm
    print(json.dumps({"study": args.study, "population": args.population,
                      "inputs": builder(args.population)}, ensure_ascii=False, indent=2))
