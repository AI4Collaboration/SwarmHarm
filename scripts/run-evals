#!/usr/bin/env python3
"""Run SwarmForm on Terra and SwarmHarm on its registered model lineup. Without --execute, print the plan."""
import argparse
import fcntl
import hashlib
import json
import os
from pathlib import Path
import subprocess
import sys

REPO = Path(__file__).resolve().parents[1]
sys.path.insert(0, str(REPO/'shared'))
import model_lineup as defaults
from process_control import run_process
from guardrails import api_base_url, credential_file, outside_repository, resolve_api_base, resolve_api_key


def write(path, data):
    temporary = path.with_suffix('.tmp')
    temporary.write_text(json.dumps(data, indent=2)+'\n')
    temporary.replace(path)


def source_signature():
    # Registration commits add evidence, not new code. They must not break resume.
    entries = subprocess.check_output(['git', 'ls-files', '--stage', '-z'], cwd=REPO).split(b'\0')
    return hashlib.sha256(b'\0'.join(e for e in entries if b'/registrations/' not in e)).hexdigest()


def plan(base, mapping=None, *, names=None, studies=None, populations=None):
    models = defaults.selection(names=names, mapping=mapping)
    settings = defaults.settings()
    if names is not None:
        selected = [m['name'] for m in models]
        settings['swarmharm']['models'] = selected
        settings['swarmform']['models'] = [n for n in settings['swarmform']['models'] if n in selected]
    if studies is not None:
        for study in ('swarmform', 'swarmharm'):
            if study not in studies:
                settings[study]['models'] = []
    if populations is not None:
        for study in ('swarmform', 'swarmharm'):
            if settings[study]['models']:
                settings[study]['populations'] = list(populations)
    sf_pops = settings['swarmform']['populations']
    sh_pops = settings['swarmharm']['populations']
    return dict(settings=settings, models=models, api_base=base,
                cohorts=dict(swarmform=len(settings['swarmform']['models'])*len(defaults.TASKS)*len(defaults.CHANNELS)*len(sf_pops)*defaults.REPEATS,
                             swarmharm=len(settings['swarmharm']['models'])*len(defaults.MECHANISMS)*len(defaults.SCENARIOS)*len(sh_pops)*defaults.REPEATS),
                source_sha256=source_signature())


def batch_command(python, study, model, base, output, *, populations=None, judge=False, judge_model=None):
    script = 'rollouts/run_matrix.py' if study == 'swarmform' else 'swarmharm/run_matrix.py'
    resolved_pops = populations or defaults.POPULATIONS
    args = [python, str(REPO/script), '--model', model['model'], '--served-model', model['served_model'],
            '--base-url', base, '--populations', *map(str, resolved_pops),
            '--repeats', str(defaults.REPEATS), '--api-protocol', 'chat-completions',
            '--execute', '--out', str(output)]
    if study == 'swarmform':
        args += ['--harness', model['harness'], '--tasks', *defaults.TASKS]
    else:
        args += ['--scenarios', *defaults.SCENARIOS, '--mechanisms', *defaults.MECHANISMS]
        if judge:
            args.append('--judge')
            if judge_model:
                args += ['--judge-model', judge_model]
    return args


def integration_complete(path, expected):
    """Re-use only the same completed, intact N=4 check; never replace an attempt."""
    try:
        registration = json.loads((path/'registration.json').read_text())
        results = json.loads((path/'summary.json').read_text())
        manifest = json.loads((path/'evidence-manifest.json').read_text())
        if (registration['models'] != expected['models'] or registration['population'] != 4
                or registration['api_base'] != expected['api_base']
                or registration['api_protocol'] != 'chat-completions'):
            return False
        if {r['name'] for r in results} != {m['name'] for m in expected['models']}:
            return False
        if not all(r['passed'] and len(r['agents']) == 4 and all(a['passed'] for a in r['agents']) for r in results):
            return False
        if not {'registration.json', 'summary.json'} <= set(manifest):
            return False
        for name, digest in manifest.items():
            file = (path/name).resolve()
            if not file.is_relative_to(path.resolve()) or hashlib.sha256(file.read_bytes()).hexdigest() != digest:
                return False
        return True
    except (OSError, ValueError, KeyError, TypeError):
        return False


def runtime_config():
    state = Path(os.environ.get('SWARMHARM_READINESS', REPO.parent/'eval-readiness')).expanduser()
    try:
        config = json.loads((state/'default-runner.json').read_text())
        if not Path(config['python']).is_file() or set(config['images']) != {'swarmform', 'swarmharm'}:
            raise ValueError('Incomplete installation')
        for image in set(config['images'].values()):
            subprocess.run(['docker', 'image', 'inspect', image], check=True, stdout=subprocess.DEVNULL)
        return config
    except (OSError, ValueError, KeyError, subprocess.CalledProcessError) as error:
        raise RuntimeError('Run bash scripts/setup-defaults before collection') from error


def execute(args, expected, config):
    root = outside_repository(args.out, REPO, 'Output')
    root.mkdir(parents=True, exist_ok=True)
    with (root/'.run.lock').open('a') as lock:
        try: fcntl.flock(lock, fcntl.LOCK_EX | fcntl.LOCK_NB)
        except BlockingIOError: raise RuntimeError('This output directory already has a running batch')
        if (root/'plan.json').exists() and json.loads((root/'plan.json').read_text()) != expected:
            raise RuntimeError('Output has a different plan; use --out for a new run')
        write(root/'plan.json', expected)
        env = dict(os.environ, OPENAI_BASE_URL=expected['api_base'],
                   SWARMHARM_HARBOR_ENV=str(Path(config['python']).parent.parent))
        if args.key_file:
            env['OPENAI_API_KEY_FILE'] = str(args.key_file)
        elif not env.get('OPENAI_API_KEY', '').strip():
            resolved_key = resolve_api_key(repository=REPO, api_base=expected['api_base'])
            if resolved_key:
                env['OPENAI_API_KEY'] = resolved_key
        # Automated registration commits require no personal Git identity.
        for role in ('AUTHOR', 'COMMITTER'):
            result = subprocess.run(['git', 'var', f'GIT_{role}_IDENT'], cwd=REPO, env=env,
                                    stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
            if result.returncode:
                env[f'GIT_{role}_NAME'] = 'SwarmHarm Runner'
                env[f'GIT_{role}_EMAIL'] = 'runner@swarmharm.invalid'
        python = config['python']
        skip_check = bool(getattr(args, 'skip_api_check', False))
        check = root/'api-check'
        if not skip_check:
            if not check.exists():
                selected_names = [m['name'] for m in expected['models']]
                print(f"Checking {len(selected_names)} models at N=4; log: {root/'api-check.log'}", flush=True)
                write(root/'index.json', dict(api_check='running', batches=[]))
                command = [python, str(REPO/'scripts/check-model-lineup'), '--base-url', expected['api_base'],
                           '--population', '4', '--out', str(check), '--execute']
                if getattr(args, 'models', None):
                    command += ['--models', *selected_names]
                if args.model_map: command += ['--model-map', str(args.model_map)]
                with (root/'api-check.log').open('a') as log:
                    code, interrupted = run_process(command, cwd=REPO, env=env, stdout=log, stderr=subprocess.STDOUT)
                if interrupted:
                    write(root/'index.json', dict(api_check='interrupted', batches=[]))
                    return 1
            if not integration_complete(check, expected):
                index_path = root/'index.json'
                index = json.loads(index_path.read_text()) if index_path.exists() else dict(batches=[])
                index['api_check'] = 'failed'
                write(index_path, index)
                raise RuntimeError('N=4 API check is incomplete or failed; see api-check.log. Preserved without rerunning.')
            print('N=4 API check passed; starting or resuming the study matrices.', flush=True)
        api_check_state = 'skipped' if skip_check else 'passed'
        records = []
        for model in expected['models']:
            for study in ('swarmform', 'swarmharm'):
                if model['name'] not in expected['settings'][study]['models']:
                    continue
                if source_signature() != expected['source_sha256']:
                    raise RuntimeError('Source changed during the batch; preserve this run and use a fresh output')
                output = root/study/model['name']
                log_path = root/f"{study}-{model['name']}.log"
                record = dict(study=study, model=model['model'], output=str(output), log=str(log_path), status='running')
                write(root/'index.json', dict(api_check=api_check_state, batches=[*records, record]))
                print(f"Running {study} / {model['name']}; records: {output}", flush=True)
                study_pops = expected['settings'][study]['populations']
                max_nets = max(int(os.environ.get('SWARMHARM_MAX_WORKSTATION_NETWORKS', '16')), max(study_pops) + 24)
                study_env = dict(env, SWARMHARM_DOCKER_IMAGE=config['images'][study],
                                 SWARMHARM_SANDBOX='docker', SWARMHARM_HARBOR_ENV=str(Path(python).parent.parent),
                                 SWARMHARM_MAX_WORKSTATION_NETWORKS=str(max_nets))
                with log_path.open('a') as log:
                    cmd = batch_command(python, study, model, expected['api_base'], output,
                                        populations=study_pops,
                                        judge=getattr(args, 'judge', False),
                                        judge_model=getattr(args, 'judge_model', None))
                    code, interrupted = run_process(cmd, cwd=REPO, env=study_env, stdout=log, stderr=subprocess.STDOUT)
                record.update(status='complete' if code == 0 and not interrupted else 'incomplete', returncode=code)
                if interrupted: record['interrupted'] = interrupted
                records.append(record)
                write(root/'index.json', dict(api_check=api_check_state, batches=records))
                if interrupted: return 1
                if subprocess.check_output(['git', 'status', '--porcelain'], cwd=REPO).strip():
                    raise RuntimeError('An incomplete registration needs review; see the batch log')
        return int(any(r['returncode'] != 0 for r in records))


def main():
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument('--base-url', default=None,
                        help='OpenAI-compatible API URL (prioritizes --base-url / OPENAI_BASE_URL / OpenRouter, then AxonHub)')
    parser.add_argument('--key-file', type=Path, default=os.environ.get('OPENAI_API_KEY_FILE'))
    parser.add_argument('--model-map', type=Path, help='Optional provider ID spelling; all selected models remain bound')
    parser.add_argument('--models', nargs='+', choices=tuple(defaults.MODELS),
                        help='Optional subset of lineup names (e.g. deepseek glm kimi luna terra sol)')
    parser.add_argument('--studies', nargs='+', choices=('swarmform', 'swarmharm'),
                        help='Optional study subset (default: both)')
    parser.add_argument('--populations', nargs='+', type=int,
                        help='Optional population list override (e.g. --populations 4 8)')
    parser.add_argument('--skip-api-check', action='store_true',
                        help='Skip initial N=4 API check when routes are already verified')
    parser.add_argument('--judge', action='store_true', help='Run SwarmHarm transcript judge automatically on each collected cohort')
    parser.add_argument('--judge-model', help='Explicit judge model ID when --judge is enabled')
    parser.add_argument('--out', type=Path, default=REPO.parent/'swarm-runs')
    parser.add_argument('--execute', action='store_true')
    args = parser.parse_args()
    if args.populations and min(args.populations) < 2:
        parser.error('--populations requires integers >= 2')
    if args.model_map: args.model_map = args.model_map.expanduser().resolve()
    base = resolve_api_base(args.base_url, allow_axonhub_default=True)
    expected = plan(base, args.model_map, names=args.models, studies=args.studies, populations=args.populations)
    if not args.execute:
        print(json.dumps(expected, indent=2)); return 0
    if args.key_file: args.key_file = credential_file(args.key_file, REPO)
    elif not resolve_api_key(repository=REPO, api_base=base):
        parser.error('Set OPENAI_API_KEY, OPENROUTER_API_KEY, OPENAI_API_KEY_FILE (or AXONHUB_API_KEY for AxonHub fallback)')
    if subprocess.check_output(['git', 'status', '--porcelain'], cwd=REPO).strip():
        parser.error('Commit source changes before collection')
    config = runtime_config()
    expected['runtime'] = config
    return execute(args, expected, config)


if __name__ == '__main__':
    raise SystemExit(main())
