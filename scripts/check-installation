#!/usr/bin/env python3
"""Check local runtimes and an actual isolated workstation; no model/API calls."""
import argparse
from importlib.metadata import version
from pathlib import Path
import sys

REPO = Path(__file__).resolve().parents[1]
sys.path[:0] = [str(REPO / 'experiments/runtime'), str(REPO / 'experiments/swarmharm-v1')]

def main():
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument('--harness', choices=('codex', 'claude-code', 'pi-sdk', 'all'), default='all')
    args = parser.parse_args()
    if version('harbor') != '0.24.0':
        raise RuntimeError('Use Harbor 0.24.0 in SWARMHARM_HARBOR_ENV')
    import codex_gateway, claude_agent, pi_agent, workstation
    if workstation.SANDBOX == 'docker':
        workstation.verify_workstation_image()
    checks = {
        'codex': lambda: codex_gateway.runtime_registration('off'),
        'claude-code': lambda: claude_agent.gateway_registration('anthropic/claude-haiku-5.5', 'off'),
        'pi-sdk': lambda: pi_agent.harness_registration('off'),
    }
    for name, check in checks.items():
        if args.harness in ('all', name):
            check()
            print(name + ': runtime configuration available (goal off)')
    station = workstation.Workstation({'/workspace/check.txt': workstation.ENCODE('ready')})
    try:
        reply, _ = station.execute('rg --fixed-strings --no-line-number ready /workspace/check.txt', {})
        if reply['exit_code'] != 0 or reply['stdout'].strip() != 'ready':
            raise RuntimeError('Workstation round trip failed')
        for command in ('curl --version', 'ps -o pid,comm'):
            reply, _ = station.execute(command, {})
            if reply['exit_code'] != 0:
                raise RuntimeError('Workstation utility is unavailable: ' + command)
        reply, snapshot = station.execute("apply_patch <<'PATCH'\n*** Begin Patch\n*** Update File: /workspace/check.txt\n@@\n-ready\n+patched\n*** End Patch\nPATCH", {})
        if reply['exit_code'] != 0 or workstation.DECODE(
                snapshot['/workspace']['/workspace/check.txt']).strip() != 'patched':
            raise RuntimeError('Workstation apply_patch round trip failed; rebuild the image')
    finally:
        station.close()
    print('Harbor and isolated file/tool round trip: OK; no hosted inference')

if __name__ == '__main__':
    main()
