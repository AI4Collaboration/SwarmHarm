#!/usr/bin/env python3
"""Run offline checks without starting a rollout."""
import argparse
from pathlib import Path
import subprocess
import sys
import time


ROOT = Path(__file__).resolve().parents[1]


def main(argv=None):
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument('--quick', action='store_true',
                        help='Run the input, wording and format gate without historical replay')
    args = parser.parse_args(argv)
    if sys.version_info[:2] != (3, 12):
        raise SystemExit('Use Python 3.12 from the pinned runtime environment.')
    steps = [
        ('Documentation and registration inventory', [sys.executable, 'scripts/check_dataset_admission_contract.py']),
        ('Installation', [sys.executable, 'scripts/check-installation']),
        ('SwarmForm configuration export and runtime settings', [sys.executable, 'scripts/check_swarmform_catalog.py']),
        ('SwarmForm input accounting and workloads', [sys.executable, 'scripts/check_swarmform_inputs.py']),
        ('Format contract', [sys.executable, 'scripts/check_format_contract.py', 'experiments/swarmharm-v1']),
        ('Retained reporting settings', [sys.executable, 'scripts/check_balanced_study.py']),
        ('Agent-facing wording', [sys.executable, 'experiments/prompt-contract/checks.py']),
    ]
    if args.quick:
        steps.insert(4, ('SwarmForm 100-input mechanism matrix', [sys.executable, '-m', 'unittest', 'discover',
                     '-s', 'tests', '-p', 'swarmform_*input*_checks.py', '-v']))
    else:
        steps.append(('Complete offline regression suite', [sys.executable, '-m', 'unittest', 'discover',
                     '-s', 'tests', '-p', '*_checks.py', '-t', '.', '-v']))
    for name, command in steps:
        print('Checking: ' + name, flush=True)
        started = time.monotonic()
        directory = ROOT / 'experiments/swarmharm-v1' if command[1:3] == ['-m', 'unittest'] else ROOT
        result = subprocess.run(command, cwd=directory, text=True,
                                stdout=subprocess.PIPE, stderr=subprocess.STDOUT)
        if result.returncode:
            print(result.stdout, flush=True)
            print('FAILED: ' + name, file=sys.stderr)
            return result.returncode
        print(f'Passed: {name} ({time.monotonic() - started:.1f}s)', flush=True)
    return 0


if __name__ == '__main__':
    raise SystemExit(main())
