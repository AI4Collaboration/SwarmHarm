#!/usr/bin/env bash
# Install the complete default lineup and both studies. No model requests.
set -euo pipefail
repo=$(CDPATH= cd -- "$(dirname -- "$0")/.." && pwd)
bash "$repo/scripts/setup-local" all
state=${SWARMHARM_READINESS:-"$repo/../eval-readiness"}
state=$(CDPATH= cd -- "$state" && pwd)
source "$state/swarmharm-local.env"
harm_image=$SWARMHARM_DOCKER_IMAGE
form_image=$harm_image
bash "$repo/rollouts/build-jq"
"$SWARMHARM_HARBOR_ENV/bin/python" - "$state/default-runner.json" "$SWARMHARM_HARBOR_ENV" "$harm_image" "$form_image" <<'PY'
import json, pathlib, sys
path, runtime, harm, form = sys.argv[1:]
pathlib.Path(path).write_text(json.dumps({'python': str(pathlib.Path(runtime).resolve()/'bin/python'),
    'images': {'swarmharm': harm, 'swarmform': form}}, indent=2)+'\n')
PY
printf 'Ready. Set OPENAI_BASE_URL and OPENAI_API_KEY, then run: python3.12 scripts/run-evals --execute\n'
