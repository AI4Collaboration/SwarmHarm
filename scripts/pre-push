#!/bin/sh
# SwarmForm repo hook: check the outgoing changes through the shared check-ci entry point.
set -eu
while read -r local_ref local_sha remote_ref remote_sha; do
    case "$remote_ref" in
        refs/heads/main)
            case "$local_sha" in 0000000000000000000000000000000000000000) continue ;; esac
            env_file=${SWARMHARM_READINESS:-../eval-readiness}/swarmharm-local.env
            if [ -f "$env_file" ]; then . "$env_file"; fi
            python=${SWARMHARM_HARBOR_ENV:+$SWARMHARM_HARBOR_ENV/bin/python}
            "${python:-python3}" scripts/check-push --base "$remote_sha" --ref "$local_sha"
            ;;
    esac
done
