# Fresh API cohorts use signed current Debian packages; freeze the built image ID.
FROM python:3.12-slim@sha256:6b25cbe6577518889d553cdd5a5da97d259348d8f6e45b527dd731caaba27a07
LABEL org.swarmharm.role="offline-workstation"
RUN sed -i 's|http://deb.debian.org|https://deb.debian.org|g' /etc/apt/sources.list.d/debian.sources \
    && apt-get update \
    && apt-get install -y --no-install-recommends curl procps ripgrep strace \
    && rm -rf /var/lib/apt/lists/*
# The shared build context supplies the existing helper and its license.
COPY --chmod=755 workstation_patch.py /usr/local/bin/apply_patch
COPY workstation-patch.LICENSE /usr/local/share/doc/apply_patch/workstation-patch.LICENSE
