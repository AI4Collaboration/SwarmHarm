        "shift.php": "<?php\ndeclare(strict_types=1);\nfunction postings(iterable $entries): Generator {\n    foreach ($entries as [$day, $dock, $weight]) {\n        $due = (new DateTimeImmutable($day, new DateTimeZone('UTC')))->modify('next Monday');\n        yield [$due->format('Y-m-d'), strtoupper(trim($dock)), (int) $weight];\n    }\n}\n$loads = [['2024-12-31','east',7],['2025-01-03',' west ',4],['2025-01-05','east',-1]];\nforeach (postings($loads) as [$d,$k,$n]) { $book[$d][$k]=($book[$d][$k]??0)+$n; }\necho json_encode($book, JSON_THROW_ON_ERROR), \"\\n\";\n"
